1623	2024-06-29 08:15:00.870096+02	{"pk": 439, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"u4tqp\\\\\\">Voici les applications en logiciels libres que l'assoc' Les Grands Voisins utilisions habituellement en interne:</p>\\", \\"id\\": \\"c6fd715d-4941-4a72-8437-8496a3768f55\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 156, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"3\\", \\"text\\": \\"<p data-block-key=\\\\\\"xx9id\\\\\\">KDEnlive permet d'\\\\u00e9diter les vid\\\\u00e9os</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"https://kdenlive.org/fr/\\", \\"text\\": \\"kdenlive.fr\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"097e60e7-43ea-476b-a69e-74bdefc15874\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 157, \\"image_side\\": \\"left\\", \\"image_ratio\\": \\"3\\", \\"text\\": \\"<p data-block-key=\\\\\\"e0hjr\\\\\\">Handbrake nous permet de changer les formats de nos vid\\\\u00e9os.</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"https://handbrake.fr/\\", \\"text\\": \\"handbrake.fr\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"ecce285c-c080-46b8-aadf-909efe2eb36b\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 158, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"3\\", \\"text\\": \\"<p data-block-key=\\\\\\"e0hjr\\\\\\">Inkscape nous permet de cr\\\\u00e9er des flyers et d'\\\\u00e9diter les images vectorielles.</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"https://inkscape.org/fr/\\", \\"text\\": \\"inkscape.org\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"4295d36f-6408-491b-b165-b2f7ea59e86d\\"}]", "date": "2024-06-29T06:07:00Z", "live": false, "path": "000100040006000L", "slug": "applications-de-créa", "depth": 4, "owner": 1, "title": "Applications de créa", "locale": 1, "locked": false, "au