497	2024-06-18 15:51:41.373291+02	{"pk": 149, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"vqswo\\\\\\">Accompagnement de cr\\\\u00e9ateurs et d'artistes</p><p data-block-key=\\\\\\"42ou0\\\\\\">Sp\\\\u00e9cialis\\\\u00e9s dans les march\\\\u00e9s de l'art et la cr\\\\u00e9ation, nous vous apportons notre vision du monde et notre expertise pour vous aider \\\\u00e0 voir plus loin, plus grand.</p><p data-block-key=\\\\\\"3lnrf\\\\\\">A trouver la meilleure version de vous-m\\\\u00eame et les meilleurs march\\\\u00e9s pour vendre et vivre de vos cr\\\\u00e9ations.</p><p data-block-key=\\\\\\"aqqc0\\\\\\"><a href=\\\\\\"https://lebureauducreateur.fr/?ref=blog.lesgrandsvoisins.com\\\\\\">LeBureauDuCreateur.fr</a></p>\\", \\"id\\": \\"d1c61fdf-3ff0-4e74-828e-021d3a663803\\"}]", "date": "2024-06-18T13:49:00Z", "live": false, "path": "00010002000B0004000B", "slug": "le-bureau-du-créateur", "depth": 5, "owner": 2, "title": "Le Bureau du Créateur", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/le-village-des-grands-voisins/les-voisins/le-bureau-du-créateur/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Le Bureau du Créateur", "content_type": 71, "header_image": 109, "header_large": false, "header_darken": true, "live_revision": null, "show_in_menus": true, "blog_categories": [], "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "ba1f0597-c89e-42d0-ae66-7bb74d77128d", "contentpage_tags": [], "entry_categories": [], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Accompagnement de créateurs et d'artistes\\r\\nSpécialisés dans les marchés de l'art et la création, nous vous apportons notre vision du monde et notre expertise pour vous aider à