227	[{"id": "c6fd715d-4941-4a72-8437-8496a3768f55", "type": "paragraph", "value": "<p data-block-key=\\"u4tqp\\">Voici les applications en logiciels libres que l'assoc' Les Grands Voisins utilisions habituellement en interne:</p>"}, {"id": "097e60e7-43ea-476b-a69e-74bdefc15874", "type": "imageandtext", "value": {"link": {"page": null, "text": "kdenlive.fr", "external_url": "https://kdenlive.org/fr/"}, "page": null, "text": "<p data-block-key=\\"xx9id\\">KDEnlive permet d'éditer les vidéos</p>", "image": 156, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "ecce285c-c080-46b8-aadf-909efe2eb36b", "type": "imageandtext", "value": {"link": {"page": null, "text": "handbrake.fr", "external_url": "https://handbrake.fr/"}, "page": null, "text": "<p data-block-key=\\"e0hjr\\">Handbrake nous permet de changer les formats de nos vidéos.</p>", "image": 157, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "4295d36f-6408-491b-b165-b2f7ea59e86d", "type": "imageandtext", "value": {"link": {"page": null, "text": "inkscape.org", "external_url": "https://inkscape.org/fr/"}, "page": null, "text": "<p data-block-key=\\"e0hjr\\">Inkscape nous permet de créer des flyers et d'éditer les images vectorielles.</p>", "image": 158, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "33d599a6-d7b8-4793-ba7b-ec5b5ce37802", "type": "imageandtext", "value": {"link": {"page": null, "text": "gimp.org", "external_url": "https://www.gimp.org/"}, "page": null, "text": "<p data-block-key=\\"1l5sx\\">Gimp nous permet d'éditer nos photos et autres images raster.</p>", "image": 159, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}]	\N	\N	\N	f	64	f	f	\N
228	[{"id": "256f3482-0e12-47c2-b60c-b084d329b70a", "type": "paragraph", "value": "<p data-block-key=\\"ez6b5\\">Voici les outils numériques disponibles pour toutes et pour tous.</p>"}, {"id": "c039ea5a-88e4-4e44-be4c-1b1f91709af0", "type": "multicolumns", "value": {"title": "", "columns": [{"id": "0a6dd837-a48b-42b8-8290-1d13ecf267f1", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/office/", "image": 48, "title": "Bureautique et création", "document": null, "description": "Ce sont les outils qui nous permettent de produire des choses individuellement."}}, {"id": "56fbff8b-f0bc-4f99-9e4f-ac8ae8722134", "type": "card", "value": {"url": "https://www.village.ngo/fr/digital/collaboration/", "image": 49, "title": "Collaborer", "document": null, "description": "Ce sont les outils qui nous permettent de partager les choses et faire ensemble."}}], "bg_color": "", "bg_image": null, "heading_tag": "h2", "bg_color_class": ""}}, {"id": "d388ac8a-07c7-419a-af4b-5c4a083ce6bf", "type": "multicolumns", "value": {"title": "", "columns": [{"id": "31b91198-73f3-4583-b7a3-76424cc280d7", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/communication/", "image": 96, "title": "Communiquer", "document": null, "description": "Voici des outils pour échanger des messages."}}, {"id": "dd9fc2b9-240b-4997-8796-a0dacef0582a", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/inform/", "image": 85, "title": "S'informer", "document": null, "description": "Ce sont les outils pour s'informer et pour informer les autres dont les sites webs publics des Grands Voisins."}}], "bg_color": "", "bg_image": null, "heading_tag": "h2", "bg_color_class": ""}}, {"id": "c022176e-1ed6-4df0-9006-4cb87fee68cb", "type": "multicolumns", "value": {"title": "", "columns": [{"id": "37a95f17-372b-448c-ba1c-12af6ab8ac70", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/moi/", "image": 97, "title": "Mon compte", "document": null, "description": "Voici les outils de gestions de son compte à soi-même."}}], "bg_color": "", "bg_image": null, "heading_tag": "h2", "bg_color_class": ""}}, {"id": "6d29552f-6286-49e2-8f83-a9fb20a411de", "type": "multicolumns", "value": {"title": "", "columns": [{"id": "f99fb22b-23eb-4de9-8065-4e071ed57fcb", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/beta/", "image": 87, "title": "Bêta et alpha", "document": null, "description": "Ce sont des outils en essai et en émergence."}}, {"id": "3a59f10a-d2a6-4e1b-be2d-578a67d74847", "type": "card", "value": {"url": "https://www.village.ong/fr/digital/admin/", "image": 77, "title": "Maintenir et administrer", "document": null, "description": "Ce sont des accès pour les administrateurs de contenu et les administrateurs techniques."}}], "bg_color": "", "bg_image": null, "heading_tag": "h2", "bg_color_class": ""}}, {"id": "53eb7654-f566-4b57-93df-6848cbf70b47", "type": "paragraph", "value": "<h3 data-block-key=\\"org5t\\">Voici des points de départ pour les services numérique des Grands Voisins.</h3><p data-block-key=\\"65u2u\\"><a href=\\"https://homepage-dashboard.resdigita.com\\">Homepage-Dashboard</a> : le tableau de bord avec nos applications principales</p><p data-block-key=\\"5tl3t\\"><a href=\\"https://guichet.resdigita.com\\">Guichet (Login)</a> : Gérer votre compte (guichet est un logiciel développé par Les Grands Voisins)</p><p data-block-key=\\"fph53\\"><a href=\\"https://guichet.resdigita.com/user/new\\">Guichet (Inscription)</a> : Créer votre compte</p><p data-block-key=\\"7a6jj\\"><a href=\\"https://www.lesgrandsvoisins.fr/numerique/\\">LesGrandsVoisins.fr/numerique</a> : La description de nos activités numériques</p><p data-block-key=\\"7j34f\\"><a href=\\"https://quartz.resdigita.com\\">Quartz</a> : Consulter notre documentation sur les outils numériques (par exemple, configurer votre courriel)</p><p data-block-key=\\"4ec4a\\"><a href=\\"https://uptime-kuma.resdigita.com/status/gv\\">Uptime-Kuma</a> : Vérifier l'état de nos services</p><p data-block-key=\\"5c9le\\">Voici des applications avec un login automatique :</p><p data-block-key=\\"bsg2b\\"><a href=\\"https://hedgedoc.resdigita.com\\">Hedgedoc</a> : Edition en temps réel de documents partagés</p><p data-block-key=\\"4na3f\\"><a href=\\"https://vikunja.resdigita.com\\">Vikunja</a> : Centraliser des informations sur des tous doux lisses</p><h3 data-block-key=\\"2jajl\\">Voici <a href=\\"https://vaultwarden.resdigita.com\\">Vaultwarden</a> pour vos mots de passe :</h3><p data-block-key=\\"8ddmd\\">Le login et le mot de passe sont indépendants et sécurisés comme nous le pouvons.</p><p data-block-key=\\"eelmc\\">Ce dispositif est compatible avec tous <a href=\\"https://bitwarden.com/fr-fr/download/\\">les clients BitWarden</a> (télédéchagement pour ios, Android, Windows, Linux et Apple). Mettez « self-hosted » ou « auto-hébergé » avec l'adresse https://vaultwarden.resdigita.com.</p><p data-block-key=\\"duea9\\"><a href=\\"https://vaultwarden.resdigita.com\\">https://vaultwarden.resdigita.com</a></p><h3 data-block-key=\\"2od0g\\">Voici des services en lien avec le courriel</h3><p data-block-key=\\"1lkv5\\"><a href=\\"https://mail.lesgrandsvoisins.com\\">Roundcube Webmail</a> : Accéder à vos mels par le web</p><p data-block-key=\\"851rt\\">Le courriel est créé dans <a href=\\"https://guichet.resdigita.com/user\\">Guichet dans la partie « modifier mon profil »</a>. Chaque courriel que vous ajoutez sera un login distinct avec le même mot de passe que vous utilisez pour Guichet.</p><p data-block-key=\\"5cc41\\">La <a href=\\"https://quartz.resdigita.com/config/services/email\\">documentation dans Quartz</a> peut vous aider à la configuration de votre courriel (sur smartphone par exemple).</p><p data-block-key=\\"boude\\">La <a href=\\"https://guichet.resdigita.com/user/new\\">création de compte sur Guichet</a> crée automatiquement un courriel correspondant.</p><p data-block-key=\\"5n1sj\\"><a href=\\"https://list.lesgrandsvoisins.com\\">ListMonk</a> : Envois de Newsletters et gestions d'abonnements</p><h3 data-block-key=\\"2758r\\">Voici des dispositifs d'administration web.</h3><p data-block-key=\\"90kbh\\"><a href=\\"https://wagtail.resdigita.com/admin/\\">Wagtail.Resdigita.Com</a> : Editer nos sites webs principaux</p><p data-block-key=\\"dthba\\"><a href=\\"https://blog.lesgrandsvoisins.com/ghost/\\">blog.lesgrandsvoisins.com/ghost</a> : Editer notre blog</p><p data-block-key=\\"5v6g\\"><a href=\\"https://list.lesgrandsvoisins.com/\\">List Monk list</a> : Envoyer des newsletters</p><p data-block-key=\\"fvqpc\\"><a href=\\"https://uptime-kuma.resdigita.com/\\">Uptime Kuma admin</a> : Adminsitrer le tableau des statuts des services</p>"}]	\N	\N	\N	f	49	f	f	\N
