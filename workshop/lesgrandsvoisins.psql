149	Association Handicap France Soudan Darfour Internationale	{"pk": 144, "path": "00010002000B00050006", "depth": 5, "numchild": 0, "translation_key": "64be3111-05dd-40c5-bad1-61a95e6c41a7", "locale": 1, "latest_revision": 490, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:42:37.422Z", "last_published_at": "2024-06-18T13:46:18.892Z", "live_revision": 490, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Association Handicap France Soudan Darfour Internationale", "draft_title": "Association Handicap France Soudan Darfour Internationale", "slug": "association-handicap-france-soudan-darfour-internationale", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/association-handicap-france-soudan-darfour-internationale/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "https://www.ahfsdi.org/ - https://www.assohfsd.com/\\r\\n\\r\\nAide \\u00e0 la population du Soudan.\\r\\n\\r\\nApporter son aide n'a jamais \\u00e9t\\u00e9 aussi urgent.\\r\\n\\r\\nEn effet, le Soudan a un besoin critique d'aide pour la mise en place d'infrastructures et de programmes \\u00e9ducatifs \\u00e0 destination des jeunes femmes/m\\u00e8res.\\r\\n\\r\\nAbaker Ali Mohamed\\r\\n\\r\\nEn savoir plus", "latest_revision_created_at": "2024-06-18T13:46:18.868Z", "alias_of": null, "body": "[{\\"id\\": \\"051cb2b5-5be0-4825-a91f-8ffc58ae0735\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"x1cvl\\\\\\"><a href=\\\\\\"https://www.ahfsdi.org/ - https://www.assohfsd.com/\\\\n\\\\nAide \\\\u00e0 la population du Soudan.\\\\n\\\\nApporter son aide n&#x27;a jamais \\\\u00e9t\\\\u00e9 aussi urgent.\\\\n\\\\nEn effet, le Soudan a un besoin critique d&#x27;aide pour la mise en place d&#x27;infrastructures et de programmes \\\\u00e9ducatifs \\\\u00e0 destination des jeunes femmes/m\\\\u00e8res.\\\\n\\\\nAbaker Ali Mohamed\\\\n\\\\nEn savoir plus\\\\\\">https://www.ahfsdi.org/ - https://www.assohfsd.com/ Aide \\\\u00e0 la population du Soudan. Apporter son aide n'a jamais \\\\u00e9t\\\\u00e9 aussi urgent. En effet, le Soudan a un besoin critique d'aide pour la mise en place d'infrastructures et de programmes \\\\u00e9ducatifs \\\\u00e0 destination des jeunes femmes/m\\\\u00e8res. Abaker Ali Mohamed En savoir plus</a></p>\\"}]", "header_with_title": true, "header_image": 104, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "date": "2024-06-18T13:41:00Z", "wagtail_admin_comments": [], "contentpage_tags": [], "entry_categories": [], "entry_tags": [], "blog_categories": [], "authors": []}	2024-06-19 14:31:03.615984+02	1	64be3111-05dd-40c5-bad1-61a95e6c41a7	71	2024-06-19 14:31:03.615111+02	0004_directoryentrypage_directoryindexpage
150	Banya Tour	{"pk": 145, "path": "00010002000B00050007", "depth": 5, "numchild": 0, "translation_key": "10e7055e-0b80-420d-9f39-b18d00ce5501", "locale": 1, "latest_revision": 489, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:45:21.718Z", "last_published_at": "2024-06-18T13:45:21.718Z", "live_revision": 489, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Banya Tour", "draft_title": "Banya Tour", "slug": "banya-tour", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/banya-tour/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "Banya = bain de vapeur russe, dont la temp\\u00e9rature et l'hygrom\\u00e9trie oscillent entre celles du sauna et celles du hammam.\\r\\n\\r\\nLe Banya Tour nait de cette pratique traditionnelle du bain d\\u00e9plac\\u00e9e de la sph\\u00e8re intime vers la place publique. Le Tour prend la forme d'une s\\u00e9rie de performances qui questionnent le corps dans l'espace public. Chaque performance se r\\u00e9invente avec le lieu qui nous accueille, avec les baigneurs.\\r\\nContinuer la lecture", "latest_revision_created_at": "2024-06-18T13:45:21.694Z", "alias_of": null, "body": "[{\\"id\\": \\"2cf0e1ef-1bce-48db-8beb-19bf2a110f11\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"ukhis\\\\\\">Banya = <b>bain de vapeur</b> russe, dont la temp\\\\u00e9rature et l'hygrom\\\\u00e9trie oscillent entre celles du sauna et celles du hammam.</p><p data-block-key=\\\\\\"9s1aq\\\\\\">Le Banya Tour nait de cette pratique traditionnelle du bain d\\\\u00e9plac\\\\u00e9e de la sph\\\\u00e8re intime vers la place publique. Le Tour prend la forme d'une <b>s\\\\u00e9rie de performances</b> qui questionnent le corps dans l'espace public. Chaque performance se r\\\\u00e9invente avec le lieu qui nous accueille, avec les baigneurs.<br/><a href=\\\\\\"https://www.banyatour.fr/?ref=blog.lesgrandsvoisins.com\\\\\\">Continuer la lecture</a></p>\\"}]", "header_with_title": true, "header_image": 105, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "date": "2024-06-18T13:43:00Z", "wagtail_admin_comments": [], "contentpage_tags": [], "entry_categories": [], "entry_tags": [], "blog_categories": [], "authors": []}	2024-06-19 14:31:03.744732+02	1	10e7055e-0b80-420d-9f39-b18d00ce5501	71	2024-06-19 14:31:03.743746+02	0004_directoryentrypage_directoryindexpage
151	Robert Baldridge	{"pk": 146, "path": "00010002000B00050008", "depth": 5, "numchild": 0, "translation_key": "5efeed0c-1c6d-4179-95ae-a62757d9ecfa", "locale": 1, "latest_revision": 492, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:47:02.103Z", "last_published_at": "2024-06-18T13:47:02.103Z", "live_revision": 492, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Robert Baldridge", "draft_title": "Robert Baldridge", "slug": "robert-baldridge", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/robert-baldridge/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "Photographer and documentary filmmaker\\r\\n\\r\\nRobert Baldridge has worked as a freelance photojournalist for over 40 years. His work has been published in the NYTimes , Vanity Fair, VOGUE , and by other magazines in Europe and South America . His work is in the vain of the concerned photography tradition.\\r\\nhttps://www.lensculture.com/robert-baldridge\\r\\n\\r\\nRobert \\"Bob\\" Baldridge is a long-time Greenwich resident. For years he has used his camera to document his experiences, along with those of others. His work has appeared in Vogue, The New York Times Magazine and other publications abroad. He's especially drawn to recording the works-in-progress of other artists. He's documenting actor Matt Dillon's philanthropic work centered on a Rwandan doctor in Africa, and he's been documenting the Dalai Lama and his fellow Tibetans in exile in India.\\r\\n\\r\\nhttps://www.greenwichtime.com/news/article/Local-photographer-sheds-light-on-the-art-of-4768898.php#photo-5117574\\r\\nhttps://www.instagram.com/robertbaldridgeofficial/\\r\\nhttps://www.lensculture.com/robert-baldridge?modal=project-1467194\\r\\nhttps://gmpphoto.blogspot.com/2021/12/lisl-steiner-in-cerro-muriano-cordoba.html", "latest_revision_created_at": "2024-06-18T13:47:02.078Z", "alias_of": null, "body": "[{\\"id\\": \\"94081c06-5ca7-420c-ab85-2f18d44f3622\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"1uxf0\\\\\\">Photographer and documentary filmmaker</p><p data-block-key=\\\\\\"1lb2s\\\\\\">Robert Baldridge has worked as a freelance photojournalist for over 40 years. His work has been published in the NYTimes , Vanity Fair, VOGUE , and by other magazines in Europe and South America . His work is in the vain of the concerned photography tradition.<br/><a href=\\\\\\"https://www.lensculture.com/robert-baldridge?ref=blog.lesgrandsvoisins.com\\\\\\">https://www.lensculture.com/robert-baldridge</a></p><p data-block-key=\\\\\\"1ramh\\\\\\"><a href=\\\\\\"https://www.greenwichtime.com/search/?action=search&amp;channel=news&amp;inlineLink=1&amp;searchindex=solr&amp;query=%22Robert+%22Bob%22+Baldridge%22&amp;ref=blog.lesgrandsvoisins.com\\\\\\">Robert \\\\\\"Bob\\\\\\" Baldridge</a> is a long-time Greenwich resident. For years he has used his camera to document his experiences, along with those of others. His work has appeared in Vogue, The <a href=\\\\\\"https://www.greenwichtime.com/search/?action=search&amp;channel=news&amp;inlineLink=1&amp;searchindex=solr&amp;query=%22New+York+Times+Magazine%22&amp;ref=blog.lesgrandsvoisins.com\\\\\\">New York Times Magazine</a> and other publications abroad. He's especially drawn to recording the works-in-progress of other artists. He's documenting actor <a href=\\\\\\"https://www.greenwichtime.com/search/?action=search&amp;channel=news&amp;inlineLink=1&amp;searchindex=solr&amp;query=%22Matt+Dillon%22&amp;ref=blog.lesgrandsvoisins.com\\\\\\">Matt Dillon</a>'s philanthropic work centered on a Rwandan doctor in Africa, and he's been documenting the <a href=\\\\\\"https://www.greenwichtime.com/search/?action=search&amp;channel=news&amp;inlineLink=1&amp;searchindex=solr&amp;query=%22Dalai+Lama%22&amp;ref=blog.lesgrandsvoisins.com\\\\\\">Dalai Lama</a> and his fellow Tibetans in exile in India.</p><p data-block-key=\\\\\\"ebjsm\\\\\\"><a href=\\\\\\"https://www.greenwichtime.com/news/article/Local-photographer-sheds-light-on-the-art-of-4768898.php?ref=blog.lesgrandsvoisins.com#photo-5117574\\\\\\">https://www.greenwichtime.com/news/article/Local-photographer-sheds-light-on-the-art-of-4768898.php#photo-5117574</a><br/><a href=\\\\\\"https://www.instagram.com/robertbaldridgeofficial/?ref=blog.lesgrandsvoisins.com\\\\\\">https://www.instagram.com/robertbaldridgeofficial/</a><br/><a href=\\\\\\"https://www.lensculture.com/robert-baldridge?modal=project-1467194&amp;ref=blog.lesgrandsvoisins.com\\\\\\">https://www.lensculture.com/robert-baldridge?modal=project-1467194</a><br/><a href=\\\\\\"https://gmpphoto.blogspot.com/2021/12/lisl-steiner-in-cerro-muriano-cordoba.html?ref=blog.lesgrandsvoisins.com\\\\\\">https://gmpphoto.blogspot.com/2021/12/lisl-steiner-in-cerro-muriano-cordoba.html</a></p>\\"}]", "header_with_title": true, "header_image": 106, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "date": "2024-06-18T13:45:00Z", "wagtail_admin_comments": [], "contentpage_tags": [], "entry_categories": [], "entry_tags": [], "blog_categories": [], "authors": []}	2024-06-19 14:31:03.869569+02	1	5efeed0c-1c6d-4179-95ae-a62757d9ecfa	71	2024-06-19 14:31:03.868605+02	0004_directoryentrypage_directoryindexpage
152	BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)	{"pk": 147, "path": "00010002000B00050009", "depth": 5, "numchild": 0, "translation_key": "4dc52cb9-7c1c-4a68-adf0-490f07a1e9fb", "locale": 1, "latest_revision": 494, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:48:45.030Z", "last_published_at": "2024-06-18T13:48:45.030Z", "live_revision": 494, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)", "draft_title": "BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)", "slug": "bmcp-bio-medical-consulting-paris-also-aukland-and-dunedin", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/bmcp-bio-medical-consulting-paris-also-aukland-and-dunedin/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "Denis Decastro\\r\\n\\r\\nDenis de Castro est un chercheur en m\\u00e9decine, qui travaillait auparavant, je crois, au CNRS, dans le centre de Paris. Denis vit maintenant \\u00e0 Dunedun, en Australie. Avant de prendre sa retraite, Denis traitait des donn\\u00e9es volumineuses en langage R et faisait des blagues, apportant de la lumi\\u00e8re \\u00e0 son \\u00e9quipe de recherche. Aujourd'hui, Denis est un contributeur important de Les Grands Voisins A Good Village.\\r\\n\\r\\nDenis de Castro is a medical research scientist, previously I think with the CNRS in central Paris. Denis now lives in Dunedun Australia. Prior to retirement, Denis processed big data in R-languages and made jokes, bringing light to his research team. Today, Denis is a significant contributor to Les Grands Voisins A Good Village.\\r\\n\\r\\nAcademia.edu\\r\\nResearchgate\\r\\nflaxbush.lesgrandsvoisins.com\\r\\nEmail", "latest_revision_created_at": "2024-06-18T13:48:45.010Z", "alias_of": null, "body": "[{\\"id\\": \\"2b93b62d-b019-4a9b-a438-ba97546874d0\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"gqc5e\\\\\\">Denis Decastro</p><p data-block-key=\\\\\\"du74\\\\\\">Denis de Castro est un chercheur en m\\\\u00e9decine, qui travaillait auparavant, je crois, au CNRS, dans le centre de Paris. Denis vit maintenant \\\\u00e0 Dunedun, en Australie. Avant de prendre sa retraite, Denis traitait des donn\\\\u00e9es volumineuses en langage R et faisait des blagues, apportant de la lumi\\\\u00e8re \\\\u00e0 son \\\\u00e9quipe de recherche. Aujourd'hui, Denis est un contributeur important de Les Grands Voisins A Good Village.</p><p data-block-key=\\\\\\"87bn5\\\\\\">Denis de Castro is a medical research scientist, previously I think with the CNRS in central Paris. Denis now lives in Dunedun Australia. Prior to retirement, Denis processed big data in R-languages and made jokes, bringing light to his research team. Today, Denis is a significant contributor to Les Grands Voisins A Good Village.</p><ul><li data-block-key=\\\\\\"2e40h\\\\\\"><a href=\\\\\\"https://auckland.academia.edu/DenisdeCastro?ref=blog.lesgrandsvoisins.com\\\\\\">Academia.edu</a></li><li data-block-key=\\\\\\"32uv4\\\\\\"><a href=\\\\\\"https://www.researchgate.net/scientific-contributions/Denis-de-Castro-33850121?ref=blog.lesgrandsvoisins.com\\\\\\">Researchgate</a></li><li data-block-key=\\\\\\"5qm44\\\\\\"><a href=\\\\\\"https://flaxbush.lesgrandsvoisins.com/?ref=blog.lesgrandsvoisins.com\\\\\\">flaxbush.lesgrandsvoisins.com</a><br/></li><li data-block-key=\\\\\\"8knt\\\\\\">Email</li></ul>\\"}]", "header_with_title": true, "header_image": 107, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "date": "2024-06-18T13:47:00Z", "wagtail_admin_comments": [], "contentpage_tags": [], "entry_categories": [], "entry_tags": [], "blog_categories": [], "authors": []}	2024-06-19 14:31:04.022167+02	1	4dc52cb9-7c1c-4a68-adf0-490f07a1e9fb	71	2024-06-19 14:31:04.021205+02	0004_directoryentrypage_directoryindexpage
153	Breast Freedom	{"pk": 148, "path": "00010002000B0005000A", "depth": 5, "numchild": 0, "translation_key": "83a98f28-f386-41fd-841d-1246216cb019", "locale": 1, "latest_revision": 496, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:49:47.380Z", "last_published_at": "2024-06-18T13:49:47.380Z", "live_revision": 496, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Breast Freedom", "draft_title": "Breast Freedom", "slug": "breast-freedom", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/breast-freedom/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "DES LIEUX \\u201cBREASTFEEDING FRIENDLY\\u201d \\u00c0 PORT\\u00c9E DE MAIN\\r\\nCoffee shops, salons de th\\u00e9, \\u00e9tablissements de petites restaurations, lieux alternatifs,\\u2026 affichant une politique explicitement favorable \\u00e0 l\\u2019allaitement pourront \\u00eatre facilement g\\u00e9olocalisables et identifiables.\\r\\n\\r\\nBreastfreedom.com", "latest_revision_created_at": "2024-06-18T13:49:47.359Z", "alias_of": null, "body": "[{\\"id\\": \\"41e335ce-52fa-476e-a4ee-fee44c20c750\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"sox17\\\\\\">DES LIEUX \\\\u201cBREASTFEEDING FRIENDLY\\\\u201d \\\\u00c0 PORT\\\\u00c9E DE MAIN<br/>Coffee shops, salons de th\\\\u00e9, \\\\u00e9tablissements de petites restaurations, lieux alternatifs,\\\\u2026 affichant une politique explicitement favorable \\\\u00e0 l\\\\u2019allaitement pourront \\\\u00eatre facilement g\\\\u00e9olocalisables et identifiables.</p><p data-block-key=\\\\\\"dgcmo\\\\\\"><a href=\\\\\\"https://breastfreedom.com/?ref=blog.lesgrandsvoisins.com\\\\\\">Breastfreedom.com</a></p>\\"}]", "header_with_title": true, "header_image": 108, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "h