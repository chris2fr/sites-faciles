493	2024-06-18 15:48:42.621927+02	{"pk": 147, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"gqc5e\\\\\\">Denis Decastro</p><p data-block-key=\\\\\\"du74\\\\\\">Denis de Castro est un chercheur en m\\\\u00e9decine, qui travaillait auparavant, je crois, au CNRS, dans le centre de Paris. Denis vit maintenant \\\\u00e0 Dunedun, en Australie. Avant de prendre sa retraite, Denis traitait des donn\\\\u00e9es volumineuses en langage R et faisait des blagues, apportant de la lumi\\\\u00e8re \\\\u00e0 son \\\\u00e9quipe de recherche. Aujourd'hui, Denis est un contributeur important de Les Grands Voisins A Good Village.</p><p data-block-key=\\\\\\"87bn5\\\\\\">Denis de Castro is a medical research scientist, previously I think with the CNRS in central Paris. Denis now lives in Dunedun Australia. Prior to retirement, Denis processed big data in R-languages and made jokes, bringing light to his research team. Today, Denis is a significant contributor to Les Grands Voisins A Good Village.</p><ul><li data-block-key=\\\\\\"2e40h\\\\\\"><a href=\\\\\\"https://auckland.academia.edu/DenisdeCastro?ref=blog.lesgrandsvoisins.com\\\\\\">Academia.edu</a></li><li data-block-key=\\\\\\"32uv4\\\\\\"><a href=\\\\\\"https://www.researchgate.net/scientific-contributions/Denis-de-Castro-33850121?ref=blog.lesgrandsvoisins.com\\\\\\">Researchgate</a></li><li data-block-key=\\\\\\"5qm44\\\\\\"><a href=\\\\\\"https://flaxbush.lesgrandsvoisins.com/?ref=blog.lesgrandsvoisins.com\\\\\\">flaxbush.lesgrandsvoisins.com</a><br/></li><li data-block-key=\\\\\\"8knt\\\\\\">Email</li></ul>\\", \\"id\\": \\"2b93b62d-b019-4a9b-a438-ba97546874d0\\"}]", "date": "2024-06-18T13:47:00Z", "live": false, "path": "00010002000B00040009", "slug": "bmcp-bio-medical-consulting-paris-also-aukland-and-dunedin", "depth": 5, "owner": 2, "title": "BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/le-village-des-grands-voisins/les-voisins/bmcp-bio-medical-consulting-paris-also-aukland-and-dunedin/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)", "content_type": 71, "header_image": 107, "header_large": false, "header_darken": true, "live_revision": null, "show_in_menus": true, "blog_categories": [], "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "4dc52cb9-7c1c-4a68-adf0-490f07a1e9fb", "contentpage_tags": [], "entry_categories": [], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Denis Decastro\\r\\n\\r\\nDenis de Castro est un chercheur en médecine, qui travaillait auparavant, je crois, au CNRS, dans le centre de Paris. Denis vit maintenant à Dunedun, en Australie. Avant de prendre sa retraite, Denis traitait des données volumineuses en langage R et faisait des blagues, apportant de la lumière à son équipe de recherche. Aujourd'hui, Denis est un contributeur important de Les Grands Voisins A Good Village.\\r\\n\\r\\nDenis de Castro is a medical research scientist, previously I think with the CNRS in central Paris. Denis now lives in Dunedun Australia. Prior to retirement, Denis processed big data in R-languages and made jokes, bringing light to his research team. Today, Denis is a significant contributor to Les Grands Voisins A Good Village.\\r\\n\\r\\nAcademia.edu\\r\\nResearchgate\\r\\nflaxbush.lesgrandsvoisins.com\\r\\nEmail", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null}	\N	147	2	71	1	BMCP - Bio-Medical Consulting Paris (also Aukland and Dunedin)
