488	[{"id": "c6fd715d-4941-4a72-8437-8496a3768f55", "type": "paragraph", "value": "<p data-block-key=\\"u4tqp\\">Voici les applications en logiciels libres que l'assoc' Les Grands Voisins utilisions habituellement en interne:</p>"}, {"id": "097e60e7-43ea-476b-a69e-74bdefc15874", "type": "imageandtext", "value": {"link": {"page": null, "text": "kdenlive.fr", "external_url": "https://kdenlive.org/fr/"}, "page": null, "text": "<p data-block-key=\\"xx9id\\">KDEnlive permet d'éditer les vidéos</p>", "image": 156, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "ecce285c-c080-46b8-aadf-909efe2eb36b", "type": "imageandtext", "value": {"link": {"page": null, "text": "handbrake.fr", "external_url": "https://handbrake.fr/"}, "page": null, "text": "<p data-block-key=\\"e0hjr\\">Handbrake nous permet de changer les formats de nos vidéos.</p>", "image": 157, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "4295d36f-6408-491b-b165-b2f7ea59e86d", "type": "imageandtext", "value": {"link": {"page": null, "text": "inkscape.org", "external_url": "https://inkscape.org/fr/"}, "page": null, "text": "<p data-block-key=\\"e0hjr\\">Inkscape nous permet de créer des flyers et d'éditer les images vectorielles.</p>", "image": 158, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}, {"id": "33d599a6-d7b8-4793-ba7b-ec5b5ce37802", "type": "imageandtext", "value": {"link": {"page": null, "text": "gimp.org", "external_url": "https://www.gimp.org/"}, "page": null, "text": "<p data-block-key=\\"1l5sx\\">Gimp nous permet d'éditer nos photos et autres images raster.</p>", "image": 159, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}]	\N	\N	\N	f	64	f	f	\N
