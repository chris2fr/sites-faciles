363	2024-06-09 10:35:47.355461+02	{"pk": 135, "body": "[]", "live": false, "path": "00010002000B", "slug": "le-village-des-grands-voisins", "depth": 3, "owner": 1, "title": "Le village des Grands Voisins", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/le-village-des-grands-voisins/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Le village des Grands Voisins", "content_type": 87, "header_image": null, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": false, "section_1_body": "[{\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 95, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"5\\", \\"text\\": \\"<h2 data-block-key=\\\\\\"ean3z\\\\\\">Les Grands Voisins car <b>l'autre</b> est une chance !</h2><p data-block-key=\\\\\\"clgl\\\\\\">Nous sommes association coop\\\\u00e9rative pour l'int\\\\u00e9r\\\\u00eat publique sur la base de notre d\\\\u00e9claration de mission.<br/><a href=\\\\\\"https://www.lesgrandsvoisins.fr/\\\\\\">LesGrandsVoisins.fr</a><a href=\\\\\\"https://www.resdigita.com/\\\\\\">ResDigita.com</a></p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"https://www.youtube.com/watch?v=qZqErGfNF_o\\", \\"text\\": \\"Les Grands Voisins, la cit\\\\u00e9 r\\\\u00eav\\\\u00e9e\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"cea8943a-5585-4b98-8508-37763829c003\\"}]", "section_2_body": "[]", "section_3_body": "[]", "header_cta_link": null, "header_cta_text": null, "latest_revision": 362, "translation_key": "b503fd04-9007-4d34-b340-c45938c9bcd4", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": "2024-06-09T08:34:40.151Z", "