248	[{"id": "4892371e-1381-4d83-8619-09c932cb7a72", "type": "paragraph", "value": "<h3 data-block-key=\\"o64jp\\">Fête de la fermeture du CHU Emmaüs Solidarité</h3><p data-block-key=\\"e7spe\\"><a href=\\"https://maps.app.goo.gl/AdigD2A4nY9ABmiQA\\">50 bd Jourdan 75014 PARIS</a></p><p data-block-key=\\"ejrvi\\">mercredi le 3 juillet</p><p data-block-key=\\"cjmhj\\">Fêtes d'enfants, danses, jeux / olympiades, spectacles concerts, chants</p><p data-block-key=\\"a6ltv\\">14h à 16h : Repas des Mamans</p><p data-block-key=\\"bpt1h\\">16h à 17h : Contes</p><p data-block-key=\\"7f73k\\">17h et après : Concerts avec de multiples artistes: Doc Gynéco, Alibi Montana, Chrysogone Diangouaya, Abad le prince des poètes, 1 indien dans la ville, Jean-Jacques B, Queen AKO</p><p data-block-key=\\"a0876\\"><a href=\\"https://www.village.ngo/medias/images/fete-cloture-emmaus-20204.original.png\\">Télécharge l'affiche</a></p>"}]	\N	de la fête de fin du CHU Jourdan Paris 14	https://www.village.ngo/medias/images/fete-cloture-emmaus-20204.original.png	f	161	f	f	Téléchrger l'affiche
203	[{"id": "e3c3821a-0d09-4a6c-b590-6b41ef3a1532", "type": "paragraph", "value": "<p data-block-key=\\"9aoq6\\">Group ad-hoc d'administrés Paris 14 qui peut réfléchir sur la Rochefoucauld et d'autres choses.</p><p data-block-key=\\"ci5ii\\">Ceci est un dispositif privé maintenu par l'association Les Grands Voisins de manière désintéressée, mais garant de la dignité des échanges, au service des administrés de tous sorts, et aux acteurs du 14e arrondissement de Paris.</p>"}, {"id": "a3188270-dd5d-4a81-877c-bdeb06b3dde5", "type": "paragraph", "value": "<p data-block-key=\\"zlm5l\\">Nous proposons de créer une catégorie paris14-larochefoucauld sur notre dispositif <a href=\\"https://Discourse.Village.Ngo\\">Discourse.Village.Ngo</a>.</p>"}]	\N	\N	\N	t	137	f	f	\N
