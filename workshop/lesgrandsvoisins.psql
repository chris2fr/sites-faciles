475	[{"id": "e0f3dff8-0eef-483e-82cc-5d7ad4cf0f6b", "type": "paragraph", "value": "<h3 data-block-key=\\"pgy74\\">Wagtail-Village pour la gestion de contenu de sites webs</h3><p data-block-key=\\"a7e0h\\">site-exemple : <a href=\\"https://wagtail.village.ngo\\">wagtail.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/wagtail-village\\">github.com/chris2fr/wagtail-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/sites-faciles\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\"bjgac\\">Django-Village pour vos applications webs</h3><p data-block-key=\\"etqij\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\"bg4ad\\">Fabrique-Village pour vos systèmes de design numériques</h3><p data-block-key=\\"e3q5v\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p>"}]	\N	github.com/chris2fr/wagtail-village	https://github.com/chris2fr/wagtail-village	t	62	f	f	Voir l'entrepôt des sources
