521	[{"id": "e0f3dff8-0eef-483e-82cc-5d7ad4cf0f6b", "type": "paragraph", "value": "<h3 data-block-key=\\"pgy74\\">Wagtail-Village pour la gestion de contenu de sites webs</h3><p data-block-key=\\"a7e0h\\">site-exemple : <a href=\\"https://wagtail.village.ngo\\">wagtail.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/wagtail-village\\">github.com/chris2fr/wagtail-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/sites-faciles\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\"bjgac\\">Django-Village pour vos applications webs</h3><p data-block-key=\\"etqij\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\"bg4ad\\">Fabrique-Village pour vos systèmes de design numériques</h3><p data-block-key=\\"e3q5v\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p>"}]	\N	github.com/chris2fr/wagtail-village	https://github.com/chris2fr/wagtail-village	t	62	f	f	Voir l'entrepôt des sources
524	[{"id": "aae8bc30-3732-411a-8c2d-01c4c192bb9f", "type": "paragraph", "value": "<h2 data-block-key=\\"zs1ls\\"><b>F</b>ête de la banane 2024</h2><p data-block-key=\\"5dapt\\">La banane en fête à Paris. Septième édition, organisée en partenariat avec les associations Parisienne, samedi 16 septembre. C’est au cœur de Paris dans un espace public que seront réunis nos fidèles exposants .Chacun Pourra découvrir et acheter de multiples produits  à base de la banane,  parmi celles qui seront proposées : Fruits, légumes, fèves de cacao grillées, chocolats, , mangues, ananas, confiture,  fruits secs, boissons, farines, céréales, huiles diverses. La convivialité et le partage sont des valeurs fortes de cette journée, permettant d’offrir chaque année une expérience riche à nos visiteurs professionnelle et amateurs de la banane Conférence « production et valorisation » des produits agricoles-quel est le juste prix du champs à l’assiette ?<br/>– Présentation et animation des débats, par Artisans du Monde Paris</p>"}, {"id": "fbd74a2d-f488-432b-b7ba-a9dfccb36631", "type": "multicolumns", "value": {"title": "Photos de la fête", "columns": [{"id": "dcf2830f-c13d-4388-9a2d-0fdd5b8eea44", "type": "image", "value": {"alt": "", "url": "", "image": 169, "title": "", "caption": "Défilé avec Natacha et Denise", "heading_tag": "h3"}}, {"id": "c37d66cb-7aca-4b34-966e-c3edb0dadff0", "type": "image", "value": {"alt": "", "url": "", "image": 170, "title": "", "caption": "Fête de la Banane avec Audrey Pulvar", "heading_tag": "h3"}}, {"id": "a8873455-cd9f-4a62-8a0b-19a8e6cae947", "type": "image", "value": {"alt": "", "url": "", "image": 171, "title": "", "caption": "Blqndine, Organisatrice de la fête", "heading_tag": "h3"}}], "bg_color": "", "bg_image": null, "heading_tag": "h3", "bg_color_class": ""}}, {"id": "e23c130f-b780-40ae-bb3a-9d7e2f7f3ea5", "type": "image", "value": {"alt": "", "url": "", "image": 124, "title": "", "caption": "", "heading_tag": "h3"}}]	\N	\N	\N	t	168	t	t	\N
520	[{"id": "a80cf434-d0c4-43cf-bce7-24bd49690b3d", "type": "paragraph", "value": "<h2 data-block-key=\\"7jjj0\\">Outils régaliens pour des sites citoyens &amp; un serveur pour tous !</h2><p data-block-key=\\"1q4g4\\">Voici des outils régaliens pour des sites citoyens issu de l'outillage qui utilise l'état pour ses 20.000 domaines .gouv.fr. Vous pouvez créer vos propres sites webs, son vos propres services, pour remplacer certains services Google et Wordpress pour vous-mêmes: un serveur pour tou.te.s et chacun.e !</p>"}, {"id": "0ba756f1-edfc-48ff-91e7-3a2bd67624b4", "type": "paragraph", "value": "<h3 data-block-key=\\"7jjj0\\">Wagtail-Fastoche pour vos chaînes d'édition numériques</h3><p data-block-key=\\"74md3\\">site-exemple : <a href=\\"https://wagtail.village.ngo\\">wagtail.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/wagtail-village\\">github.com/chris2fr/wagtail-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/sites-faciles\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\"bgcv2\\">Django-Fastoche pour vos applications webs</h3><p data-block-key=\\"4pivt\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\"f8qe8\\">Fabrique-Fastoche pour vos systèmes de design numériques</h3><p data-block-key=\\"c8g1s\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p>"}]	\N	\N	\N	f	\N	f	f	\N
541	[{"id": "14daec6d-f2a6-4d70-a588-ae7b36349b32", "type": "imageandtext", "value": {"link": {"page": 541, "text": "Merci de vous y inscrire (nombre de places limité)", "external_url": ""}, "page": null, "text": "<p data-block-key=\\"9kbzl\\">Nous proposons un atelier en arts plastiques le lundi 2 déc. 2024 de 17h à 19h sur le thème des collages avec Julio Roméro.</p>", "image": 186, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "3"}}]	\N	Inscrivez-vous	https://www.gv.coop/fr/agenda/atelier-arts-2024-12-02/inscription/	t	99	t	t	Nombre de places limité
436	[{"id": "256f3482-0e12-47c2-b60c-b084d329b70a", "type": "paragraph", "value": "<p data-block-key=\\"ez6b5\\">Voici les outils numériques disponibles pour toutes et pour tous.</p>"}, {"id": "53eb7654-f566-4b57-93df-6848cbf70b47", "type": "paragraph", "value": "<h3 data-block-key=\\"org5t\\">Voici des points de départ pour les services numérique des Grands Voisins.</h3><p data-block-key=\\"65u2u\\"><a href=\\"https://homepage-dashboard.resdigita.com\\">Homepage-Dashboard</a> : le tableau de bord avec nos applications principales</p><p data-block-key=\\"5tl3t\\"><a href=\\"https://guichet.resdigita.com\\">Guichet (Login)</a> : Gérer votre compte (guichet est un logiciel développé par Les Grands Voisins)</p><p data-block-key=\\"fph53\\"><a href=\\"https://guichet.resdigita.com/user/new\\">Guichet (Inscription)</a> : Créer votre compte</p><p data-block-key=\\"7a6jj\\"><a href=\\"https://www.lesgrandsvoisins.fr/numerique/\\">LesGrandsVoisins.fr/numerique</a> : La description de nos activités numériques</p><p data-block-key=\\"7j34f\\"><a href=\\"https://quartz.resdigita.com\\">Quartz</a> : Consulter notre documentation sur les outils numériques (par exemple, configurer votre courriel)</p><p data-block-key=\\"4ec4a\\"><a href=\\"https://uptime-kuma.resdigita.com/status/gv\\">Uptime-Kuma</a> : Vérifier l'état de nos services</p><p data-block-key=\\"5c9le\\">Voici des applications avec un login automatique :</p><p data-block-key=\\"bsg2b\\"><a href=\\"https://hedgedoc.resdigita.com\\">Hedgedoc</a> : Edition en temps réel de documents partagés</p><p data-block-key=\\"4na3f\\"><a href=\\"https://vikunja.resdigita.com\\">Vikunja</a> : Centraliser des informations sur des tous doux lisses</p><h3 data-block-key=\\"2jajl\\">Voici <a href=\\"https://vaultwarden.resdigita.com\\">Vaultwarden</a> pour vos mots de passe :</h3><p data-block-key=\\"8ddmd\\">Le login et le mot de passe sont indépendants et sécurisés comme nous le pouvons.</p><p data-block-key=\\"eelmc\\">Ce dispositif est compatible avec tous <a href=\\"https://bitwarden.com/fr-fr/download/\\">les clients BitWarden</a> (télédéchagement pour ios, Android, Windows, Linux et Apple). Mettez « self-hosted » ou « auto-hébergé » avec l'adresse https://vaultwarden.resdigita.com.</p><p data-block-key=\\"duea9\\"><a href=\\"https://vaultwarden.resdigita.com\\">https://vaultwarden.resdigita.com</a></p><h3 data-block-key=\\"2od0g\\">Voici des services en lien avec le courriel</h3><p data-block-key=\\"1lkv5\\"><a href=\\"https://mail.lesgrandsvoisins.com\\">Roundcube Webmail</a> : Accéder à vos mels par le web</p><p data-block-key=\\"851rt\\">Le courriel est créé dans <a href=\\"https://guichet.resdigita.com/user\\">Guichet dans la partie « modifier mon profil »</a>. Chaque courriel que vous ajoutez sera un login distinct avec le même mot de passe que vous utilisez pour Guichet.</p><p data-block-key=\\"5cc41\\">La <a href=\\"https://quartz.resdigita.com/config/services/email\\">documentation dans Quartz</a> peut vous aider à la configuration de votre courriel (sur smartphone par exemple).</p><p data-block-key=\\"boude\\">La <a href=\\"https://guichet.resdigita.com/user/new\\">création de compte sur Guichet</a> crée automatiquement un courriel correspondant.</p><p data-block-key=\\"5n1sj\\"><a href=\\"https://list.lesgrandsvoisins.com\\">ListMonk</a> : Envois de Newsletters et gestions d'abonnements</p><h3 data-block-key=\\"2758r\\">Voici des dispositifs d'administration web.</h3><p data-block-key=\\"90kbh\\"><a href=\\"https://wagtail.resdigita.com/admin/\\">Wagtail.Resdigita.Com</a> : Editer nos sites webs principaux</p><p data-block-key=\\"dthba\\"><a href=\\"https://blog.lesgrandsvoisins.com/ghost/\\">blog.lesgrandsvoisins.com/ghost</a> : Editer notre blog</p><p data-block-key=\\"5v6g\\"><a href=\\"https://list.lesgrandsvoisins.com/\\">List Monk list</a> : Envoyer des newsletters</p><p data-block-key=\\"fvqpc\\"><a href=\\"https://uptime-kuma.resdigita.com/\\">Uptime Kuma admin</a> : Adminsitrer le tableau des statuts des services</p>"}]	\N	\N	\N	f	49	f	f	\N
