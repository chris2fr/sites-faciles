/digital/admin/\\", \\"document\\": null}, \\"id\\": \\"3a59f10a-d2a6-4e1b-be2d-578a67d74847\\"}]}, \\"id\\": \\"6d29552f-6286-49e2-8f83-a9fb20a411de\\"}]", "live": true, "path": "000100040007", "slug": "digital", "depth": 3, "owner": 1, "title": "Outils numériques", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 8, "url_path": "/le-village-des-grands-voisins/digital/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Outils numériques", "content_type": 25, "header_image": 49, "header_large": false, "header_darken": false, "live_revision": 984, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 984, "translation_key": "9d8b185e-8fcc-4f57-86ef-5ab1dd9320fd", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-06-29T07:21:34.140Z", "first_published_at": "2024-06-29T06:26:37.267Z", "header_color_class": null, "search_description": "Voici les outils numériques disponibles pour toutes et pour tous. […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-29T07:21:34.114Z"}	\N	228	1	25	1	Outils numériques
752	2024-06-20 17:04:36.379428+02	{"pk": 195, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"2pytq\\\\\\">Merci de voter pour le 22e Conseils des Voisins !</p><ol><li data-block-key=\\\\\\"bopu3\\\\\\">Num\\\\u00e9rique</li><li data-block-key=\\\\\\"d9nmq\\\\\\">Civisme</li><li data-block-key=\\\\\\"14fta\\\\\\">Communication</li><li data-block-key=\\\\\\"dfhhm\\\\\\">Arts</li></ol><p data-block-key=\\\\\\"55sdc\\\\\\">Dans notre association, nous servons les tout statut socio-\\\\u00e9conomique individuel ou collectif -- les artistes, les artisans, les associations, les entreprises, les salari\\\\u00e9s, les demandeurs d'emploi, les institutions, les services sociaux, ... -- mais ce sont les individus r\\\\u00e9partis dans trois coll\\\\u00e8ges qui d\\\\u00e9cident.</p><p data-block-key=\\\\\\"7tb7a\\\\\\">Lors de nos 22e Conseils des Voisins, nous avons propos\\\\u00e9 des d\\\\u00e9cisions \\\\u00e0 prendre. Dans ce formulaire, vous avez la possibilit\\\\u00e9 de voter pour les propositions.</p>\\", \\"id\\": \\"48955129-b0a0-4ee3-ba3a-b9b51c72a2c4\\"}]", "live": true, "path": "00010004000200040002", "slug": "votes-22", "depth": 5, "intro": "", "owner": 1, "title": "Votes pour les 22e Conseil des Voisins", "locale": 1, "locked": false, "expired": false, "subject": "Vote du 22e Conseils des Voisins", "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/association/conseils-des-voisins/votes-22/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "to_address": "chris@village.ngo", "draft_title": "Votes pour les 22e Conseil des Voisins", "form_fields": [{"pk": 10, "page": 195, "label": "Prénom", "choices": "", "required": true, "help_text": "", "clean_name": "prenom", "field_type": "singleline", "sort_order": 0, "default_value": ""}, {"pk": 11, "page": 195, "label": "Nom de famille", "choices": "", "required": true, "help_text": "", "clean_name": "nom", "field_type": "singleline", "sort_order": 1, "default_value": ""}, {"pk": 12, "page": 195, "label": "Email", "choices": "", "required": true, "help_text": "", "clean_name": "email", "field_type": "email", "sort_order": 2, "default_value": ""}, {"pk": null, "page": 195, "label": "22-DIGITAL-1 : Continuation du numérique créatif", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Le BPP 2022 sert à l'atelier de la Ressourcérie. Validez-vous la continuation du numérique créatif des Grands Voisins ?", "clean_name": "", "field_type": "radio", "sort_order": 3, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 195, "label": "22-DIGITAL-2 : Centres de profit numériques", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous la proposition de listes de diffusion et d'expertises en ResDigita (projet de rendre accessible des logiciels libres de .gouv.fr) ?", "clean_name": "", "field_type": "radio", "sort_order": 4, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 195, "label": "22-CIVI-1 : Mémoire annuel de Valentin FRANCY", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous l'observation du 2 mars comme jour de mémoire de Valentin FRANCY suite à l'invitation du Souvenir Français et l'accord de ses parents ? (Pas d'évènement, juste commemoration)", "clean_name": "", "field_type": "radio", "sort_order": 5, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 195, "label": "22-CIVI-2 : Prix de la biographie d'Annette MONOD", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous la recompense par l'association de travaux exemplaires en services sociaux par le don du livre « L'Ange du Vel d'Hiv » lors d'une cérimonie annuelle ?", "clean_name": "", "field_type": "radio", "sort_order": 6, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 195, "label": "22-COMM-1 : Village.Ngo", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous l'utilisation de Village.Ngo comme nom de domaine principal pour l'ensemble des activités publiques des Grands Voisins ?", "clean_name": "", "field_type": "radio", "sort_order": 7, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 195, "label": "22-COMM-2 : Concept de communicaton", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous le concept de communication proposée sur le site village.ngo: (1) Un voisinage complémentaire aux voisinages existants (2) Service aux acteur socio-économiques décision par individus (3) Activités C.A.N. : Civisme / Arts plastiques / Numériq?", "clean_name": "", "field_type": "radio", "sort_order": 8, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}], "content_type": 91, "from_address": "chris@village.ngo", "header_image": null, "header_large": false, "header_darken": false, "live_revision": 749, "show_in_menus": true, "thank_you_text": "<p data-block-key=\\"fd7qo\\">Merci, nous aurions pris pris compte de vos votes !</p>", "header_cta_link": "https://www.village.ngo/fr/association/conseils-des-voisins/votes-21/", "header_cta_text": "Faites vos votes", "latest_revision": 751, "translation_key": "18c0d6c2-998c-4551-a070-266426b47cf8", "contentpage_tags": [], "header_cta_label": "pour le 21e Conseil des Voisins", "header_with_title": false, "last_published_at": "2024-06-20T14:25:03.261Z", "first_published_at": "2024-06-20T14:25:03.261Z", "header_color_class": null, "search_description": "Merci de voter pour les 21e et 22e Conseils des Voisins ! Dans notre association, nous servons les tout statut […]", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": "2024-06-20T15:01:08.789Z"}	\N	195	1	91	1	Votes pour les 22e Conseil des Voisins
71	2024-05-06 05:38:15.774371+02	{"pk": 31, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"71524\\\\\\">Pouss\\\\u00e9s par la Mission des Grands Voisins et le <a href=\\\\\\"https://contractfortheweb.org/fr/?ref=blog.lesgrandsvoisins.com\\\\\\">Contrat pour le Web</a>, nous avan\\\\u00e7ons avec assurance dans <b>le num\\\\u00e9rique interd\\\\u00e9pendant et autonome</b> des Grands Voisins.</p><ul><li data-block-key=\\\\\\"1mlno\\\\\\"><a href=\\\\\\"https://blog.lesgrandsvoisins.com/salle-de-sociabilite-numerique/\\\\\\">Le num\\\\u00e9rique cr\\\\u00e9atif des Grands Voisins \\\\u00e0 Paris le lundi de 16h \\\\u00e0 21h30</a></li><li data-block-key=\\\\\\"9pddv\\\\\\"><a href=\\\\\\"https://homepage-dashboard.resdigita.com/\\\\\\">homepage-dashboard.ResDigita.Com</a></li></ul><h2 data-block-key=\\\\\\"be8ku\\\\\\">Articles de blog sur le num\\\\u00e9rique</h2><p data-block-key=\\\\\\"f0sfl\\\\\\"><a href=\\\\\\"https://blog.lesgrandsvoisins.com/tag/resdigita/\\\\\\">Voici des articles de blog sur le num\\\\u00e9rique</a></p><h2 data-block-key=\\\\\\"fbrjt\\\\\\">Interd\\\\u00e9pendance num\\\\u00e9rique</h2><p data-block-key=\\\\\\"d47rp\\\\\\">Nous aimerions aussi dans notre IT mettre en place un principe d\\\\u2019\\\\u00e9quilibre entre l\\\\u2019autonomie et l\\\\u2019int\\\\u00e9gration. Nous sommes assez fiers de faire notre propre serveur de courriels. Nous aimons les logiciels libres. La mani\\\\u00e8re dont nous faisons est d\\\\u00e9j\\\\u00e0 ce que nous faisons.</p><p data-block-key=\\\\\\"a80nv\\\\\\">Avec votre compte vous avez une identit\\\\u00e9 centralis\\\\u00e9e et contr\\\\u00f4l\\\\u00e9e \\\\u00e0 partir de laquelle vous pouvez acc\\\\u00e9der \\\\u00e0 tout ce qui est <a href=\\\\\\"https://lesgrandsvoisins.com/?ref=blog.lesgrandsvoisins.com\\\\\\">lesgrandsvoisins.com:</a> dispositifs de communication, courriel dont listes de diffusion, le tout dans les serveurs autonomes pour la plupart. Nous facteurs envoient les courriels directement aux destinataires sans passer par aucun interm\\\\u00e9diaire autre. <a href=\\\\\\"https://www.idgouv.com/?ref=blog.lesgrandsvoisins.com\\\\\\">Votre compte et mot de passe</a> sont stock\\\\u00e9s dans un annuaire LDAP avec un acc\\\\u00e8s \\\\u00e0 authentification unique. L'association se met en posture d'\\\\u00eatre directement redevable envers chaque usager, et c'est tellement important dans ce monde num\\\\u00e9rique !</p><h2 data-block-key=\\\\\\"63eiq\\\\\\">Le Num\\\\u00e9rique Cr\\\\u00e9atif des Grands Voisins</h2><p data-block-key=\\\\\\"daglo\\\\\\">Suite \\\\u00e0 une rencontre de voeux organis\\\\u00e9e par\\\\u00a0<a href=\\\\\\"https://mairie14.paris.fr/pages/maison-des-associations-11177\\\\\\">la mairie et la MVAC du 14e arrondissement</a>, nous avons lanc\\\\u00e9 avec\\\\u00a0<a href=\\\\\\"https://www.laressourceriecreative.com/\\\\\\">la Ressourcerie Cr\\\\u00e9ative</a> <a href=\\\\\\"https://budgetparticipatif.paris.fr/bp/jsp/site/Portal.jsp?page=idee&amp;campagne=H&amp;idee=1445\\\\\\">un projet de budget participatif de Paris \\\\u00ab Le num\\\\u00e9rique cr\\\\u00e9atif \\\\u00bb\\\\u00a0</a>. Nous sollicitons le soutien de la\\\\u00a0<a href=\\\\\\"https://mairie14.paris.fr/\\\\\\">Mairie du 14e</a>\\\\u00a0et d\\\\u2019autres associations et partenaires potentiels.</p><p data-block-key=\\\\\\"dam56\\\\\\">Le projet de num\\\\u00e9rique cr\\\\u00e9atif est une proposition de jardinage num\\\\u00e9rique en deux volets: un volet serveur et un volet \\\\u00e9quipement de salle pouvant \\\\u00eatre ponctuellement transform\\\\u00e9 dans un lieu social informatique. L\\\\u2019objectif est d\\\\u2019encourager l\\\\u2019\\\\u00e9panouissement digital local sur la base des missions et\\\\u00a0<a href=\\\\\\"https://lesgrandsvoisins.com/\\\\\\">lesgrandsvoisins.com</a>\\\\u00a0et\\\\u00a0<a href=\\\\\\"https://contractfortheweb.org/fr\\\\\\">contractfortheweb.org</a>.</p><p data-block-key=\\\\\\"fgeot\\\\\\">Le c\\\\u00f4t\\\\u00e9 serveur est une armoire ferm\\\\u00e9e \\\\u00e0 clef avec des ressources qui soient disponibles via l\\\\u2019internet aux usagers \\\\u00e0 partir de logiciels libres.</p><p data-block-key=\\\\\\"60ons\\\\\\">La construction de la salle consiste en un nombre d\\\\u2019ordinateurs portables et d\\\\u2019\\\\u00e9quipements informatiques dans une salle qui peuvent \\\\u00eatre sortis et utilis\\\\u00e9 ponctuellement pour des besoins variables depuis le franchissement de la fracture num\\\\u00e9rique jusqu\\\\u2019au d\\\\u00e9veloppement vid\\\\u00e9o, design, programmation, 3D, administration, etc.</p><p data-block-key=\\\\\\"2ikvn\\\\\\">Le projet avait \\\\u00e9t\\\\u00e9 d\\\\u00e9pos\\\\u00e9 avec un partenariat avec La Ressourcerie Cr\\\\u00e9ative, soit point d\\\\u2019acc\\\\u00e8s num\\\\u00e9rique au 14i\\\\u00e8me. Aujourd\\\\u2019hui, je souhaite aussi solliciter l\\\\u2019int\\\\u00e9r\\\\u00eat d\\\\u2019autres associations telles que &amp;aprilorg, &amp;lespetitsdebrouillardsorg et &amp;antanakcom.</p><p data-block-key=\\\\\\"5rs20\\\\\\"><a href=\\\\\\"https://wiki.lesgrandsvoisins.com/fr/acts/budgetpartparis\\\\\\">D\\\\u00e9couvrir</a></p><ul><li data-block-key=\\\\\\"ell5j\\\\\\">Salle de sociabilit\\\\u00e9 num\\\\u00e9rique<ul><li data-block-key=\\\\\\"d5n00\\\\\\">Atelier multi-niveaux, multi-comp\\\\u00e9tences</li><li data-block-key=\\\\\\"mrk8\\\\\\">Le lundi de 16h \\\\u00e0 21h30 \\\\u00e0 l'Atelier de la Ressourcerie Cr\\\\u00e9ative<br/>au 93 ave du G\\\\u00e9n\\\\u00e9ral Leclerc 75014 PARIS</li></ul></li><li data-block-key=\\\\\\"5r8p7\\\\\\">Serveurs de sociabilit\\\\u00e9 num\\\\u00e9rique<ul><li data-block-key=\\\\\\"at3k3\\\\\\">Serveurs h\\\\u00e9berg\\\\u00e9s et redond\\\\u00e9s pour les activit\\\\u00e9s en lien avec la Salle</li></ul></li><li data-block-key=\\\\\\"9muko\\\\\\">Aide mat\\\\u00e9riel<ul><li data-block-key=\\\\\\"ea75f\\\\\\">Ce projet am\\\\u00e8ne du mat\\\\u00e9riel \\\\u00e0 partager entre associations<br/>(montage audio-visuel, etc.)</li><li data-block-key=\\\\\\"3kjd8\\\\\\">Trouver une solution pour les maux de passe, etc.</li><li data-block-key=\\\\\\"b615g\\\\\\">Accompagner m\\\\u00eame des projets pointus</li></ul></li><li data-block-key=\\\\\\"ahj44\\\\\\">M\\\\u00e9c\\\\u00e9nat<ul><li data-block-key=\\\\\\"251rs\\\\\\">M\\\\u00e9c\\\\u00e9nat de comp\\\\u00e9tences<br/>Nous avons besoin de gens pour organiser les activit\\\\u00e9s</li><li data-block-key=\\\\\\"807k8\\\\\\">Dons<br/>Nous mettons \\\\u00e0 bon usage vos contributions financier en levier du Laur\\\\u00e9at</li><li data-block-key=\\\\\\"eqcs6\\\\\\">M\\\\u00e9c\\\\u00e9nat en nature<br/>Dons d'informatique, audio-visuel, etc. Services, ... Tout sera valoris\\\\u00e9.</li></ul></li><li data-block-key=\\\\\\"9prgn\\\\\\">Accompagnement num\\\\u00e9rique<ul><li data-block-key=\\\\\\"5ln8a\\\\\\">Aider les commer\\\\u00e7ants et ind\\\\u00e9pendants, des marginalis\\\\u00e9s et des pros</li><li data-block-key=\\\\\\"7pfjt\\\\\\">Adh\\\\u00e9sions au Contrat pour le web dans tout ce dont nous faisons</li></ul></li></ul><h2 data-block-key=\\\\\\"52vg8\\\\\\">ResDigita</h2><p data-block-key=\\\\\\"6mjam\\\\\\">Nous avions pr\\\\u00e9f\\\\u00e9r\\\\u00e9 d\\\\u00e9nommer notre activit\\\\u00e9 num\\\\u00e9rique \\\\u00ab ResDigita \\\\u00bb lors d'un Conseil des Voisins en f\\\\u00e9vrier 2023. Voici nos diff\\\\u00e9rentes activit\\\\u00e9s en lien avec le num\\\\u00e9rique.</p><ul><li data-block-key=\\\\\\"7rqbs\\\\\\">Serveur Email Public<br/>Nous avons un serveur public de courriel (dite SMTP) qui livre et re\\\\u00e7oit \\\\u00e0 notre place nos courriels, que ce soit de nos bo\\\\u00eetes individuelles (votre domaine si vous voulez) ou de nos listes de diffusion (attention aux usages svp).</li><li data-block-key=\\\\\\"b6reg\\\\\\">Serveur de publication et de gestion de contenus webs</li><li data-block-key=\\\\\\"56nm9\\\\\\">Serveur de Webmail, de calendrier et de listes de diffusion</li><li data-block-key=\\\\\\"1hf3d\\\\\\">Serveurs ERP</li><li data-block-key=\\\\\\"djpc5\\\\\\">Serveurs de gestion de mots de passe</li></ul>\\", \\"id\\": \\"9c96dd65-5feb-4d6b-874d-cdc6bd72a5df\\"}]", "live": true, "path": "000100020005", "slug": "numerique", "depth": 3, "owner": 1, "title": "Numérique", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/numerique/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "Le Numérique des Grands Voisins", "go_live_at": null, "draft_title": "Numérique", "content_type": 25, "header_image": 49, "header_large": true, "header_darken": false, "live_revision": null, "show_in_menus": true, "header_cta_link": "https://www.resdigita.com", "header_cta_text": "Venez vous inscrire à Res Digita, le bras informatique des Grands Voisins", "latest_revision": null, "translation_key": "d5523f08-89a9-4b36-9553-90b11a07e13c", "contentpage_tags": [], "header_cta_label": "ResDigita.com", "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": "pink-macaron", "search_description": "Poussés par la Mission des Grands Voisins et le Contrat pour le Web, nous avançons avec assurance dans le numérique interdépendant et autonome des Grands Voisins.", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null}	\N	31	1	25	1	Numérique
45	2024-05-05 20:08:21.753363+02	{"pk": 20, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"ms4b9\\\\\\">Robert Baldrige has been trotting the earth from a Quaker Center in an abandoned volcano in South America to the home to the Dali Lama for a half-century. At first, Robert's main medium was post cards. As I understand it, should you find yourself on the list, you would receive many postcards. Today, in the land of Instagram and WhatsApp, Robert is still the adolescent storyteller, and we all may be his parents. What did you learn at school today? What friends did you make? Hang in there, fellow Robert-parents, we are in for the ride of our lives!</p><p data-block-key=\\\\\\"2bnep\\\\\\">So the discussion today is about more than putting the proverbial fingerpainting on the fridge. The problem is that these are good fingerprintings, well photography, not only in their own rights, but in the story that they implicitly tell. This is the point where any article about Robert usually starts the name-dropping, in perfect imitation of Robert himself, so I will name-drop too: Robert Baldridge. It's time that on drop that name: Robert Baldridge. It is sufficient.</p><p data-block-key=\\\\\\"8968t\\\\\\">But what's the point ?</p><p data-block-key=\\\\\\"ch94e\\\\\\">The goal of my process with Robert this morning is to figure out what to do with the fingerpaintings of great persons around great stories, be they published on the fridge or in, let's say Vanity Times (if such a thing exists). It was tough getting into the subject because young Robert does the fingerpainting and sees the fingerpainting when in the kitchen or in Vanity Times (speaking metaphorically).</p><p data-block-key=\\\\\\"f2v71\\\\\\">What should you do when you meet this storyteller? Robert takes pictures. So, what? You may ask yourself what Robert would do with these photos, or you may ask what you could do with these photos.</p><p data-block-key=\\\\\\"a779v\\\\\\">Should you have a Robert Baldrige photo, there are two non-negotiables.</p><ol><li data-block-key=\\\\\\"aelsd\\\\\\">The most basic thing to do is to attribute the work to \\\\u00a0(c) Robert Baldrige with preferably a link to the @RobertBaldrigeOfficial Instagram account.</li><li data-block-key=\\\\\\"4si4j\\\\\\">The second basic thing is to allow Robert to see the use of his work, to inform him of it. Robert also avails himself to the creative process around the publication of his work, but is amenable to publishers.</li></ol><p data-block-key=\\\\\\"64ntb\\\\\\">That doesn't mean you are in the clear. The two above conditions apply invariably to any use. Normal compensation considerations are applicable, and can be in cash, by check (in dollars) or by wire transfer.</p>\\", \\"id\\": \\"d5fa4f4d-617c-4f13-826a-f5bd3dc17ebc\\"}, {\\"type\\": \\"image\\", \\"value\\": {\\"title\\": \\"Gilles Cl\\\\u00e9ment par Robert Baldridge\\", \\"heading_tag\\": \\"h3\\", \\"image\\": 34, \\"alt\\": \\"Montage and Photos by Robert Baldrige (c) of Gilles Cl\\\\u00e9ment from a Thanks for Nothing event at the Louvre on May 3, 2023\\", \\"caption\\": \\"Montage and Photos by Robert Baldrige (c) of Gilles Cl\\\\u00e9ment from a Thanks for Nothing event at the Louvre on May 3, 2023\\", \\"url\\": \\"https://www.instagram.com/robertbaldridgeofficial/?ref=blog.lesgrandsvoisins.com\\"}, \\"id\\": \\"d57b7609-c156-4895-be2e-1c7fb91ca0bc\\"}]", "date": "2023-05-11T10:00:00Z", "live": false, "path": "000100020003000E", "slug": "thoughts-about-creative-commons-cc-by-nc-sa-en", "depth": 4, "owner": 1, "title": "Thoughts about Creative Commons CC-BY-NC-SA (EN)", "locale": 1, "locked": false, "authors": [1], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/blog/thoughts-about-creative-commons-cc-by-nc-sa-en/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "Thoughts about Creative Commons CC-BY-NC-SA (EN)", "entry_tags": [{"pk": 35, "tag": 15, "content_object": 20}], "go_live_at": null, "draft_title": "Thoughts about Creative Commons CC-BY-NC-SA (EN)", "content_type": 71, "header_image": 34, "header_large": true, "header_darken": true, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "50049e8c-02e2-4981-a186-d65241a79bd3", "entry_categories": [{"pk": 16, "page": 20, "category": 1}], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": "purple-glycine", "search_description": "Article about terms and conditions around storytelling incorporating photography as creative process including projection (not to say \\"publication\\") in the storytelling process.\\r\\n\\r\\nHow is a photographic artist to adapt to today's immaterial world. Art used to be material. Photos, even two-dimensional, used to be objects. There used to be edges. Now, everything is edgy. My goal here is to curate for the wellbeing of the world, but I fear that photograph of the orchestra on the glacier for a healthy and harmonious planet, mother Earth, is as endangered as the glacier itself, or at least the photographer and the musicians de par our own mortalities.", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null, "wagtail_village_blog_categories": [1]}	\N	20	1	71	1	Thoughts about Creative Commons CC-BY-NC-SA (EN)
52	2024-05-05 20:33:30.148766+02	{"pk": 18, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"ya9iw\\\\\\">Votes (en cours)</h2><h3 data-block-key=\\\\\\"4u0s6\\\\\\">Vote 1 : Autorisation d'ouverture des comptes en banque</h3><p data-block-key=\\\\\\"6jqs8\\\\\\">Il est autoris\\\\u00e9 d'ouvrir un compte en banque \\\\u00e0 Sogexia et un compte en banque \\\\u00e0 SumUp.</p><p data-block-key=\\\\\\"70uq4\\\\\\">Coll\\\\u00e8ge A : 1/1<br/>Coll\\\\u00e8ge B: 2/2<br/>Coll\\\\u00e8ge C: 3/3</p><h3 data-block-key=\\\\\\"dtnsn\\\\\\">Vote 2 : Epouser les trois principes d'intr\\\\u00eat g\\\\u00e9n\\\\u00e9ral</h3><p data-block-key=\\\\\\"atrp4\\\\\\">Nous ne contournons aucunement et \\\\u00e9pousons avant toute autre chose \\\\u00e0 part le manifeste des Grands Voisins les trois principes d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral pour leurs d\\\\u00e9finitions propres et notre compr\\\\u00e9hension que ceci:</p><ol><li data-block-key=\\\\\\"5e7lt\\\\\\">Altruisme complet: nos implications dans les Grands Voisins ne nous apporte aucun avantage mat\\\\u00e9riel, m\\\\u00eame indirect.</li><li data-block-key=\\\\\\"4i9qv\\\\\\">Gouvernance autonome: nos int\\\\u00e9r\\\\u00eats dans notre gouvernance ne prend en consid\\\\u00e9ration que l'int\\\\u00e9r\\\\u00eat des Grands Voisins et non pas des int\\\\u00e9r\\\\u00eats ailleurs que nous pourrions avoir ; et la gouvernance des Grands Voisins est uniquement par nous-m\\\\u00eames.</li><li data-block-key=\\\\\\"7t03s\\\\\\">Externalit\\\\u00e9s: nous ne pouvons pas pr\\\\u00e9dire par avance les beneficiaries de nos actions prinicpales car celles-ci sont pour un b\\\\u00e9n\\\\u00e9fice large et motiv\\\\u00e9es pour l'am\\\\u00e9lioration g\\\\u00e9n\\\\u00e9rale au lieu de l'am\\\\u00e9lioration sp\\\\u00e9cifique.</li></ol><p data-block-key=\\\\\\"d3nk7\\\\\\">Coll\\\\u00e8ge A : 1/1<br/>Coll\\\\u00e8ge B: 2/2<br/>Coll\\\\u00e8ge C: 3/3</p><h2 data-block-key=\\\\\\"568jn\\\\\\">Information</h2><h3 data-block-key=\\\\\\"echcc\\\\\\">Langement d'un appel \\\\u00e0 dons (structure)</h3><p data-block-key=\\\\\\"a30so\\\\\\">Il a \\\\u00e9t\\\\u00e9 d\\\\u00e9cid\\\\u00e9 de lancer un appel \\\\u00e0 dons sur la base du manifeste et des projets en gestation et sur l'engagement de neutralit\\\\u00e9, et sur la notion de portail. Notre offre n'est pas exactement au point encore en tant qu'association recevant les dons et nous pouvons am\\\\u00e9liorer notre visibilit\\\\u00e9 de notre m\\\\u00e9tier et ambitions.</p><h3 data-block-key=\\\\\\"2ko0a\\\\\\">Pr\\\\u00e9sentation prochaine du projet d'Observatoire des Grands Voisins</h3><p data-block-key=\\\\\\"aq6kg\\\\\\">Nous avons privil\\\\u00e9gi\\\\u00e9 le terme \\\\\\"observatoire\\\\\\" pour les deux termes propos\\\\u00e9s au 16e Conseil des Voisins. Il y a d'ailleurs un Observatoire de la D\\\\u00e9mocratie Locale du 14e auquel nous nous int\\\\u00e9ressons.</p><h3 data-block-key=\\\\\\"4mcdh\\\\\\">Possible rapproche contre le Conseil de Paris au sujet du Budget participatif de Paris 2022</h3><p data-block-key=\\\\\\"3h2jv\\\\\\">Le conseil de Paris a redirig\\\\u00e9 25.000 euros vers un projet d'agrandissement de l'atleier de la Ressourcerie cr\\\\u00e9ative au lieu du Num\\\\u00e9rique cr\\\\u00e9atif des Grands Voisins. Dans les d\\\\u00e9bats au Conseil de Paris, notre association et Chris Mann ont \\\\u00e9t\\\\u00e9 \\\\u00e9cart\\\\u00e9s, alors les moteurs du laur\\\\u00e9at. Un avocat, Ma\\\\u00eetre LEROY, pourra proposer \\\\u00e0 Chris MANN une requ\\\\u00eate en annulation de la d\\\\u00e9lib\\\\u00e9ration du Conseil de Paris du 17 mars 2023 rapport\\\\u00e9 par M. Florentin LETISSIER. Les personnes pr\\\\u00e9sentes sont (un peu trop) enthousiastes.</p><h2 data-block-key=\\\\\\"4it20\\\\\\">Discussion</h2><h3 data-block-key=\\\\\\"24u0s\\\\\\">Engager des Voisins</h3><h3 data-block-key=\\\\\\"8hk6h\\\\\\">Impact de la d\\\\u00e9claration g\\\\u00e9n\\\\u00e9rale</h3><h3 data-block-key=\\\\\\"eh794\\\\\\">Notion de responsable des actions: Les Grands Voisins ou les Grands Voisins</h3><h3 data-block-key=\\\\\\"fro3u\\\\\\">Bin\\\\u00f4me Chris et Ma\\\\u00ebl arr\\\\u00eat\\\\u00e9 (impact activit\\\\u00e9 artistique)</h3><h3 data-block-key=\\\\\\"eo7pa\\\\\\">ResDigita</h3><h3 data-block-key=\\\\\\"a7oqp\\\\\\">Vision</h3><h2 data-block-key=\\\\\\"n086\\\\\\">Lettre \\\\u00e9ditoriale de rappel</h2><p data-block-key=\\\\\\"7hrgb\\\\\\">Bonjour,</p><p data-block-key=\\\\\\"a7qa7\\\\\\">Le 18e Conseil des voisins aura lieu ce soir de <b>20h \\\\u00e0 21h15</b> \\\\u00e0 <a href=\\\\\\"https://meet.lgv.coop/?ref=blog.lesgrandsvoisins.com\\\\\\">meet.lgv.coop</a>, et chez moi \\\\u00e0 Fontenay-aux-Roses. L'accueil, la s\\\\u00e9curit\\\\u00e9 et le confort de cette r\\\\u00e9union d\\\\u00e9pend de moi et de vous: il n'y a pas d'enregistrement de l'audio ni du vid\\\\u00e9o, mais du chat. Le fait de vous nommer, puis d'activer vos cam\\\\u00e9ras et micros augmentent la notion de s\\\\u00e9curit\\\\u00e9 pour les autres. Tout devrait \\\\u00eatre d\\\\u00e9crit sur <a href=\\\\\\"https://meet.lgv.coop/?ref=blog.lesgrandsvoisins.com\\\\\\">meet.lgv.coop</a>.</p><p data-block-key=\\\\\\"b9n6g\\\\\\">Lors de cette pr\\\\u00e9paration pour le 18e conseil, il y a effectivement des nouvelles. Le plus important est la parole de Mme. la Maire du 14e arrondissement, Carine PETIT, qui me sugg\\\\u00e8re de laisser tomber la notion de responsabilit\\\\u00e9 de la marque Les Grands Voisins. Dans ce sens que nous ne pouvons pas prendre responsabilit\\\\u00e9 pour les autres, cela a du sens. Je comprends qu'il convient de se concentrer sur le pr\\\\u00e9sent et l'avenir.</p><p data-block-key=\\\\\\"7ppjm\\\\\\">Les contraintes d'organisme d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral sont:</p><ol><li data-block-key=\\\\\\"5opol\\\\\\">Aucun avantage mat\\\\u00e9riel pour les individus ou organisations, m\\\\u00eame indirect, du fait de notre participation</li><li data-block-key=\\\\\\"2vkm6\\\\\\">Aucune influence externe dans notre gouvernance</li><li data-block-key=\\\\\\"cg1f9\\\\\\">B\\\\u00e9n\\\\u00e9fices uniquement par externalit\\\\u00e9s pour donc des populations non-pas d\\\\u00e9limit\\\\u00e9es par avance</li></ol><p data-block-key=\\\\\\"3dbtr\\\\\\">Ces contraintes ne sont pas neutres. Elles sont essentielles \\\\u00e0 la l\\\\u00e9gitimit\\\\u00e9 des Grands Voisins. Je pense qu'elles sont n\\\\u00e9cessaires et peut-\\\\u00eatre suffisantes pour notre fonctionnement. Elles mettent en question un de nos engagements en tant que coop\\\\u00e9ratif: l'engagement \\\\u00e9conomique des coop\\\\u00e9rants. Je pr\\\\u00e9senterai pourquoi ma pens\\\\u00e9e pr\\\\u00e9liminaire sur la compatibilit\\\\u00e9 de ces deux engagements.</p><p data-block-key=\\\\\\"6dv8t\\\\\\">Le budget participatif <b>Le num\\\\u00e9rique cr\\\\u00e9atif des Grands Voisins</b> (25.000 euros) aurait \\\\u00e9t\\\\u00e9 attribu\\\\u00e9 en grande partie \\\\u00e0 un autre budget de 55.000 euros avec un autre objectif: remplacer l'atelier de la Ressourcerie Cr\\\\u00e9ative de 70m\\\\u00b2 par un atelier de 110 m2. De surcro\\\\u00eet, il parait que les d\\\\u00e9bats au Conseil de Paris aurait fait abstraction de notre association et de la vision du num\\\\u00e9rique cr\\\\u00e9atif des Grands Voisins depuis 2016. Il y a une suggestion de consid\\\\u00e9rer un recours en annulation de d\\\\u00e9lib\\\\u00e9ration du Conseil de Paris \\\\u00e0 consid\\\\u00e9rer. La cible est la rentr\\\\u00e9e (mais l'infrastructure r\\\\u00e9seau pourrait y \\\\u00eatre insuffisant finalement).</p><p data-block-key=\\\\\\"52s8i\\\\\\">La comp\\\\u00e9tence principale pour faire marcher le num\\\\u00e9rique cr\\\\u00e9atif est la mienne, et c'est une comp\\\\u00e9tence que je peux utiliser pour gagner ma vie: l'informatique. Je pense qu'il convient peut-\\\\u00eatre de revoir une d\\\\u00e9cision du 16e Conseil des voisins d'utiliser le terme resdigita.com pour nos activit\\\\u00e9s num\\\\u00e9riques. L'id\\\\u00e9e est de centrer Les Grands Voisins, association d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9rale coop\\\\u00e9rative. Pour ma vie professionnelle, je dois personnellement m'assurer d'une s\\\\u00e9paration nette des activit\\\\u00e9s.</p><p data-block-key=\\\\\\"7tar2\\\\\\">Ma\\\\u00ebl est actuellement dans une place personnelle qui m'emp\\\\u00eache personnellement de m'investir \\\\u00e0 son c\\\\u00f4t\\\\u00e9. Si cela change, ce serait avec plaisir de reprendre le bin\\\\u00f4me d'avant. Cela ne regarde que moi personnellement et non pas l'association. Ma\\\\u00ebl s'est entretenu bri\\\\u00e8vement avec la Ministre d\\\\u00e9l\\\\u00e9gu\\\\u00e9e aux personnes en situation de handicap, expose actuellement \\\\u00e0 Africa Week \\\\u00e0 l'UNESCO, a fait un don de \\\\u00ab\\\\u202fLa Reine\\\\u202f\\\\u00bb \\\\u00e0 l'UNESCO et entretien un rapport pluriannel avec la Directrice de l'UNESCO.</p><p data-block-key=\\\\\\"8pafp\\\\\\">La Mairie du 14e d\\\\u00e9veloppe un observatoire de la d\\\\u00e9mocratie locale. J'en ferai un article de blog prochainement. J'y vois la fibre qui a donn\\\\u00e9 lieu au site Saint Vincent de Paul !</p><p data-block-key=\\\\\\"eg328\\\\\\">Nous avons particip\\\\u00e9 au salon Inclusiv'Day o\\\\u00f9 plusieurs autres acteurs ont choisi de vouloir \\\\u00eatre dans notre annuaire. C'est un honneur.</p><p data-block-key=\\\\\\"5tano\\\\\\">A 20h pour certaines et certains d'entre vous sur <a href=\\\\\\"https://meet.lgv.coop/?ref=blog.lesgrandsvoisins.com\\\\\\">meet.lgv.coop</a>.</p><p data-block-key=\\\\\\"fsvj4\\\\\\">Chris MANN<br/>chris@lesgrandsvoisins.com<br/>07 81 811 811</p><h2 data-block-key=\\\\\\"cd10o\\\\\\">Invitation</h2><p data-block-key=\\\\\\"7g2ls\\\\\\">Notre <a href=\\\\\\"https://blog.lesgrandsvoisins.com/18e-conseil/\\\\\\">18e Conseil des voisins</a> aura donc lieu <a href=\\\\\\"https://www.lesgrandsvoisins.com/event/18e-conseil-des-voisins-33/register?ref=blog.lesgrandsvoisins.com\\\\\\">mardi le 6 juin de 20h \\\\u00e0 20h15</a>. Ce conseil suit le m\\\\u00eame cadre des autres conseils: comfort, accueil, s\\\\u00e9curit\\\\u00e9. Nous avons ouvert notre compte en banque et il convient de commencer \\\\u00e0 concr\\\\u00e9tiser ce que nous voulons dire par nos engagements en tant qu'association de loi 1901 d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral coop\\\\u00e9rative multisectorielle (temps de mettre en pratique). Nous aurions aussi \\\\u00e9t\\\\u00e9 peut-\\\\u00eatre snob\\\\u00e9s au Conseil de Paris. Il semble y avoir une mouvance g\\\\u00e9n\\\\u00e9rale pour la privatisation de l'ESS. Nous aimerions profiter d'un local. Nous pourrions concr\\\\u00e9tiser notre mod\\\\u00e8le et lancer une id\\\\u00e9e d'universit\\\\u00e9 populaire des Grands Voisins.</p><p data-block-key=\\\\\\"q8h1\\\\\\">Le CR du 17e Conseil des Voisins est ici:</p>\\", \\"id\\": \\"afe3a0ac-fc2b-4387-8b53-55cd57497b25\\"}]", "date": "2023-06-06T10:00:00Z", "live": true, "path": "000100020003000C", "slug": "18e-conseil-des-voisins", "depth": 4, "owner": 1, "title": "18e Conseil des Voisins", "locale": 1, "locked": false, "authors": [1], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/blog/18e-conseil-des-voisins/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "18e Conseil des Voisins", "entry_tags": [{"pk": null, "tag": 10, "content_object": 18}, {"pk": null, "tag": 15, "content_object": 18}], "go_live_at": null, "draft_title": "18e Conseil des Voisins", "content_type": 71, "header_image": 38, "header_large": true, "header_darken": true, "live_revision": 36, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 36, "translation_key": "c48bccba-bb4d-45d8-b8c2-d3f6e3f28965", "entry_categories": [{"pk": 14, "page": 18, "category": 3}], "header_cta_label": null, "header_with_title": true, "last_published_at": "2024-05-05T17:44:25.428Z", "first_published_at": "2024-05-05T17:44:25.428Z", "header_color_class": "blue-ecume", "search_description": "Votes prises au 18e Conseil des voisins : (1) Nouveaux comptes en banque. (2) Articulation de notre intérêt général. Infos partagées : Appel à dons, Observatoire, Reproche éventuel Conseil de Paris.", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-05-05T17:44:25.394Z", "wagtail_village_blog_categories": [3]}	\N	18	1	71	1	18e Conseil des Voisins
59	2024-05-06 05:06:30.560159+02	{"pk": 25, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"d8jim\\\\\\">Organisation entre TIH au Village TIH</h2><h3 data-block-key=\\\\\\"7bg6u\\\\\\">Picnic Potluck</h3><p data-block-key=\\\\\\"395r9\\\\\\">Indiquer si vous amenez du sucr\\\\u00e9, du sal\\\\u00e9 ou \\\\u00e0 boire.</p><p data-block-key=\\\\\\"89mud\\\\\\">WAKA Cosneil: sucr\\\\u00e9 : baklavas et tarte aux cerises de mon jardin</p><p data-block-key=\\\\\\"2b2at\\\\\\">Chris MANN: Sal\\\\u00e9 (pas sur quoi\\\\u2026 peut-\\\\u00eatre une quiche)</p><h3 data-block-key=\\\\\\"98epb\\\\\\">Gardiennage partag\\\\u00e9</h3><p data-block-key=\\\\\\"a5mjm\\\\\\">Nous essayons de nous organiser pour qu\\\\u2019un caisson soit tjs surveill\\\\u00e9 pour nos affaires.</p><h3 data-block-key=\\\\\\"57hgo\\\\\\">Flyer mutualis\\\\u00e9</h3><p data-block-key=\\\\\\"d74me\\\\\\">Nous pourrions faire une fiche avec nos diff\\\\u00e9rentes prestations.</p><h3 data-block-key=\\\\\\"amhd\\\\\\">Prospection coordonn\\\\u00e9e</h3><p data-block-key=\\\\\\"8app4\\\\\\">Nous pourrions proposer \\\\u00e0 nos prospects \\\\u00e0 \\\\u00eatre dans les fichiers prospects de plusieurs TIH s\\\\u2019ils le souhaitent.</p><p data-block-key=\\\\\\"dv94u\\\\\\">autre id\\\\u00e9e : se partager les coordonn\\\\u00e9es des prospects r\\\\u00e9colt\\\\u00e9s ce jour l\\\\u00e0 ?</p><p data-block-key=\\\\\\"vedc\\\\\\">Bonne id\\\\u00e9e pour le partage des prospects, en fonction de la volont\\\\u00e9 des prospects\\\\u2026 je vais y refl\\\\u00e9chir pour proposer qqch de respectueux et des prospects et des TIH que nous sommes</p><h3 data-block-key=\\\\\\"65v65\\\\\\">Convivialit\\\\u00e9 d\\\\u2019espace</h3><p data-block-key=\\\\\\"6j31u\\\\\\">Le salon fournit des panneaux 60cm fois 60cm avec nos logos respectifs. Ce serait un peu de d\\\\u00e9cor. Nos emplacements individuels sont 1m50 chacun tout le long, mais si on combine, on peut faire un lieu un peu d\\\\u00e9tente, un peu convivial\\\\u2026 \\\\u00e0 voir avec la volont\\\\u00e9 des uns et des autres.</p><p data-block-key=\\\\\\"4b17k\\\\\\">Un coin caf\\\\u00e9 si quelqu\\\\u2019un a une cafeti\\\\u00e8re ou une bouilloire (pour ceux qui veulent du th\\\\u00e9) ?</p><h2 data-block-key=\\\\\\"9okc9\\\\\\">Nouv\\\\u00e8le Ere Production</h2><p data-block-key=\\\\\\"1ch7j\\\\\\">Excellente id\\\\u00e9e je voulais vous proposer la m\\\\u00eame chose car le village TIH dois \\\\u00eatre bien repr\\\\u00e9senter aupr\\\\u00e8s du secteur et mieux reconnu des entreprises.Un grand stand peut aider a augmenter l impact par contre il faut faire attention \\\\u00e0 ce que les services soit diff\\\\u00e9renci\\\\u00e9e a l aide des kak\\\\u00e9monos et des signal\\\\u00e9tiques car si les prospects ne comprennent pas ce que l ont fait \\\\u00e7a peux avoir un impact n\\\\u00e9gatif sur notre communication.Il faudrait je pense faire un regroupement de pas plus de deux ou trois stand.Peux \\\\u00eatre profiter pour faire des stands plus grand en retirant les espaces pr\\\\u00e9vu pour s\\\\u00e9parer les tables.Sur 3 stands cela fait gagner 3 m quand m\\\\u00eame ce qui est pas n\\\\u00e9gligeable.Car une table d un m\\\\u00e8tre 50 c est assez petit sur un salon</p>\\", \\"id\\": \\"bc92d81a-96f0-42aa-95f1-4e19e4ca16ca\\"}]", "date": "2023-04-28T10:00:00Z", "live": true, "path": "000100020003000J", "slug": "village-tih-a-inclusivday", "depth": 4, "owner": 1, "title": "Village TIH à Inclusiv’Day", "locale": 1, "locked": false, "authors": [1], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/blog/village-tih-a-inclusivday/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "Organisation du Village TIH à Inclusiv’Day", "entry_tags": [], "go_live_at": null, "draft_title": "Village TIH à Inclusiv’Day", "content_type": 71, "header_image": 43, "header_large": true, "header_darken": true, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "f87153df-c79e-457a-a970-e1e8ffbb871c", "entry_categories": [{"pk": 22, "page": 25, "category": 3}], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": "green-tilleul-verveine", "search_description": "Nous sommes en preparation de comment nous coordonner pour le salon TIH. Post en élaboration.", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null, "wagtail_village_blog_categories": [3]}	\N	25	1	71	1	Village TIH à Inclusiv’Day
124	2024-05-20 18:39:00.911108+02	{"pk": 46, "body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"gnv4d\\\\\\">Gestion des mots de passe</h2><p data-block-key=\\\\\\"8t0k1\\\\\\"><a href=\\\\\\"https://vaultwarden.resdigita.com/\\\\\\">https://vaultwarden.resdigita.com/</a></p><p data-block-key=\\\\\\"3emie\\\\\\"></p>\\", \\"id\\": \\"a0b8fad7-01ee-4aac-94c8-71798d29635c\\"}]}, \\"id\\": \\"da90273d-0467-4286-bf0f-e26029fe18e1\\"}]", "live": true, "path": "0001000200050002", "slug": "apps", "depth": 4, "owner": 1, "title": "Les Apps des Grands Voisins", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/numerique/apps/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Les Apps des Grands Voisins", "content_type": 25, "header_image": null, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "86f8ddae-f8a1-48a5-9e5a-7628804acefb", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Gestion des mots de passe https://vaultwarden.resdigita.com/ […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null}	\N	46	1	25	1	Les Apps des Grands Voisins
111	2024-05-08 18:22:25.492984+02	{"pk": 40, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"0xk8q\\\\\\">Ce manifeste, imparfait, refl\\\\u00e8te les esp\\\\u00e9rances, les souffrances et les incompr\\\\u00e9hensions de ceux qui l'ont insuffl\\\\u00e9. Les Grands Voisins sont n\\\\u00e9s \\\\u00e0 l'h\\\\u00f4pital Saint-Vincent-de-Paul dans le 14e arrondissement \\\\u00e0 Paris, entre Port royal et les Catacombes. Nous sommes issus des failles dans le b\\\\u00e9ton et dans les politiques publiques. Nous sommes au service de l'accueil de tous et croyons aux ponts entre utopie et r\\\\u00e9alit\\\\u00e9.</p><p data-block-key=\\\\\\"fmap5\\\\\\">Comme toutes bonnes voisines et tous bons voisins, nous ne sommes pas toujours d'accord entre nous, mais nous d\\\\u00e9fendons :</p><ul><li data-block-key=\\\\\\"78ndh\\\\\\">la parit\\\\u00e9 dans la gouvernance</li><li data-block-key=\\\\\\"jv61\\\\\\">des solutions collectives en bonne intelligence</li><li data-block-key=\\\\\\"ahscr\\\\\\">l'expression libre</li><li data-block-key=\\\\\\"cehns\\\\\\">l'exercice artistique</li><li data-block-key=\\\\\\"8fpaf\\\\\\">l'apprentissage tout au long de la vie</li><li data-block-key=\\\\\\"4ctm8\\\\\\">la valorisation de toutes formes de travail.</li></ul><p data-block-key=\\\\\\"72jpr\\\\\\">Aux Grands Voisins, nous vivons, travaillons, dormons, mangeons, nous soignons, achetons, pleurons, rions, et tout cela dans toutes les langues. L'inclusion et l'exclusion, toutes les deux, peuvent nous \\\\u00e9loigner de l'Autre qui est une chance.</p><p data-block-key=\\\\\\"e6llj\\\\\\">Nous r\\\\u00e9clamons des lieux de mixit\\\\u00e9 sociale qui permettent la valorisation et le partage des savoirs et des savoir-faire de toutes et de tous. Nous r\\\\u00e9clamons des lieux de mixit\\\\u00e9 sociale qui favorisent l'\\\\u00e9coute et les possibilit\\\\u00e9s de rencontre, conditions visant \\\\u00e0 l'abolition de la peur de l'autre. Nous r\\\\u00e9clamons des lieux de mixit\\\\u00e9 sociale qui luttent contre \\\\u00ab l'entre-soi \\\\u00bb, l'isolement et la r\\\\u00e9duction des individus \\\\u00e0 des cases.</p><p data-block-key=\\\\\\"6obpf\\\\\\">Nous avons besoin de lieux et de temps pour faire pr\\\\u00e9c\\\\u00e9dent, pouvoir inventer d'autres formes de soci\\\\u00e9t\\\\u00e9 en harmonie avec les \\\\u00e9cosyst\\\\u00e8mes. Nous avons toutes et tous \\\\u00e0 donner et nous pouvons toutes et tous recevoir.</p><p data-block-key=\\\\\\"4253n\\\\\\"><i>[Manifeste des Grands Voisins avec les contributions d'une centaine de personnes sur un mois dont cette version est \\\\u00e9dit\\\\u00e9e par Chris Mann en 2017 avec une r\\\\u00e9vision l\\\\u00e9g\\\\u00e8re en 2023.]</i></p>\\", \\"id\\": \\"79b8666c-64a7-44d2-9a77-7a02649f668a\\"}]", "date": "2023-04-02T10:21:00Z", "live": true, "path": "000100020003000R", "slug": "manifeste-des-grands-voisins", "depth": 4, "owner": 1, "title": "Manifeste des Grands Voisins", "locale": 1, "locked": false, "authors": [1], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/blog/manifeste-des-grands-voisins/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "Manifeste des Grands Voisins", "entry_tags": [], "go_live_at": null, "draft_title": "Manifeste des Grands Voisins", "content_type": 71, "header_image": 48, "header_large": true, "header_darken": true, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "f3fccd41-4c4e-4861-b048-dd29715c3774", "entry_categories": [{"pk": 28, "page": 40, "category": 3}], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Version du 2 avril 2022 du manifeste des Grands Voisins composé en 2017 avec plus de cent personnes sur un période d'un mois.", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": null, "wagtail_village_blog_categories": [3]}	\N	40	1	71	1	Manifeste des Grands Voisins
360	2024-06-05 04:29:15.608811+02	{"pk": 3, "body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"village-primary\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"image\\", \\"value\\": {\\"title\\": \\"22e Conseil des Voisins du 10 au 16 juin 2024\\", \\"heading_tag\\": \\"h3\\", \\"image\\": 63, \\"alt\\": \\"Inscription sur les Grands Voisins\\", \\"caption\\": \\"Je m'y incris !\\", \\"url\\": \\"https://www.village.ngo/fr/civisme/invitation-au-22%C3%A8me-conseil-des-grands-voisins/\\"}, \\"id\\": \\"fa6cb962-ce70-49d7-8be1-782246d16d32\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<p data-block-key=\\\\\\"4mc6m\\\\\\">\\\\ud83c\\\\udf1f <b>Venez co-constuire un voisinage</b> \\\\ud83c\\\\udf1f</p><p data-block-key=\\\\\\"f3l62\\\\\\"><i>anim\\\\u00e9, chic, vivant,partageant, \\\\u00e9quip\\\\u00e9,ressour\\\\u00e7ant, respectueux,mondial, multiculturel,prosp\\\\u00e8re, et de proximit\\\\u00e9.</i></p><p data-block-key=\\\\\\"6pq0r\\\\\\">Nous tiendrions le 22e Conseil des Voisins sur trois rencontres :</p><ul><li data-block-key=\\\\\\"sqrq\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins\\\\\\">Lundi le 10 juin de 19h45 \\\\u00e0 21h25</a></li><li data-block-key=\\\\\\"5sba\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-1\\\\\\">Jeudi le 13 juin de 15h15 \\\\u00e0 16h45</a></li><li data-block-key=\\\\\\"fabkv\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-2\\\\\\">Samedi le le 15 juin de 10h15 \\\\u00e0 11h45</a></li></ul><p data-block-key=\\\\\\"3m03\\\\\\"></p><p data-block-key=\\\\\\"a6q9u\\\\\\">Ordre du jour :</p><ol><li data-block-key=\\\\\\"43o40\\\\\\">Num\\\\u00e9rique</li><li data-block-key=\\\\\\"oioh\\\\\\">\\\\u00c9ventuellement Civisme</li><li data-block-key=\\\\\\"7l6q8\\\\\\">Communication</li></ol>\\", \\"id\\": \\"9595d5cd-cdc2-4c52-a93c-5614abc35e97\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"avd09\\\\\\"><b>Permanence le lundi de midi \\\\u00e0 17h</b></h3><p data-block-key=\\\\\\"e0hvf\\\\\\"></p><embed embedtype=\\\\\\"image\\\\\\" format=\\\\\\"left\\\\\\" id=\\\\\\"52\\\\\\" alt=\\\\\\"Abaker-Atelier\\\\\\"/><p data-block-key=\\\\\\"5c5gg\\\\\\"></p><p data-block-key=\\\\\\"dqj9a\\\\\\">Venez \\\\u00e0 notre permanence <b>le lundi de 12h \\\\u00e0 17h</b><br/>en personne \\\\u00e0 <b>93 ave. Du G\\\\u00e9n. Leclerc</b> 75014 Paris (M\\\\u00e9tro Al\\\\u00e9sia, Atelier de la Ressourcerie, <i>7e boutique sur la gauche</i>) ou <a href=\\\\\\"https://meet.lesgrandsvoisins.com\\\\\\">meet.lesgrandsvoisins.com pour participer en hybride</a>.</p>\\", \\"id\\": \\"460c495c-476c-43f1-bb69-aff7bf1509ea\\"}]}, \\"id\\": \\"c58f3abe-971d-41a7-ad49-f547da49dd04\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"fkikp\\\\\\">ResDigita est le cellule num\\\\u00e9rique des Grands Voisins qui peut vous permettre un ensemble d'outils en logiciels libres info-g\\\\u00e9r\\\\u00e9s par notre association coop\\\\u00e9rative (ou par vous-m\\\\u00eames).</p>\\", \\"cta_label\\": \\"Explorer l'alternative ResDigita !\\", \\"cta_url\\": \\"https://www.resdigita.com\\"}, \\"id\\": \\"a7c575ad-1bac-41e2-bc66-7642c0474a42\\"}, {\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"fkikp\\\\\\">Les Grands Voisins est une association dirig\\\\u00e9e par tout individu qui veut bien pour l'entraide et le partage de biens communs entre artistes, artisans, professionnels, associations, institutions et entreprises. Nous nous concentrons sur les arts plastiques, le num\\\\u00e9rique et le civisme.</p>\\", \\"cta_label\\": \\"Rencontrer Les Grands Voisins !\\", \\"cta_url\\": \\"https://www.lesgrandsvoisins.fr\\"}, \\"id\\": \\"e0146b05-bf9f-4f20-b188-3c3b0c27ca39\\"}, {\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"fkikp\\\\\\">Fabrique Village et Wagtail Village rendent g\\\\u00e9n\\\\u00e9riques un ensemble de logiciels libres \\\\u00e9dit\\\\u00e9s et exploit\\\\u00e9s par l'Etat fran\\\\u00e7ais pour ses sites .gouv.fr (dont certains outils pour plus de 20.000 noms de domaine).</p>\\", \\"cta_label\\": \\"D\\\\u00e9veloppez votre site Village !\\", \\"cta_url\\": \\"https://www.cfran.orf\\"}, \\"id\\": \\"464f14ec-569f-4378-88e9-ff180b0232a9\\"}]}, \\"id\\": \\"53834137-fc01-4885-a6a0-d58a562984d1\\"}, {\\"type\\": \\"video\\", \\"value\\": {\\"title\\": \\"Les Grands Voisins, la cit\\\\u00e9 r\\\\u00eav\\\\u00e9e\\", \\"caption\\": \\"c 3, 2020 R\\\\u00e9alisation : Bastien Simon  Pitch : Ma\\\\u00ebl, artiste sans papier, Adrien, luthier musicien et d'autres r\\\\u00e9sidents venus de tous horizons, s'organisent pour donner naissance \\\\u00e0 une utopie moderne en plein coeur de Paris, un village solidaire de pr\\\\u00e8s de 2000 personnes : Les Grands Voisins. \\\\u00c0 travers leurs trajectoires et celles des membres fondateurs du lieu, le film interroge notre d\\\\u00e9sir et notre capacit\\\\u00e9 \\\\u00e0 inventer d\\\\u2019autres mani\\\\u00e8res de vivre ensemble. Que retiendrons-nous de cette exp\\\\u00e9rience collective ? Pourra-t-elle perdurer, essaimer, r\\\\u00e9sonner ailleurs ?\\", \\"url\\": \\"https://www.youtube.com/embed/qZqErGfNF_o?feature=oembed\\"}, \\"id\\": \\"3640c479-7911-4def-9462-1d43662a5e21\\"}, {\\"type\\": \\"accordions\\", \\"value\\": [{\\"type\\": \\"title\\", \\"value\\": \\"Les Grands Voisins\\", \\"id\\": \\"6c6ec6eb-93af-4f4a-97e4-2f91d2498c57\\"}, {\\"type\\": \\"accordion\\", \\"value\\": {\\"title\\": \\"Sites Webs des Grands Voisins\\", \