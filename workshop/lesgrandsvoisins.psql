181	[{"id": "8b9f5818-815f-4114-82d8-035a05957149", "type": "paragraph", "value": "<p data-block-key=\\"iugnj\\">Développeur front depuis 5 ans spécialisé sur Angular et Ionic. Services fournis:</p><ul><li data-block-key=\\"fjqo1\\">Développement d’applications mobiles</li><li data-block-key=\\"emsca\\">Développement web</li></ul><p data-block-key=\\"dukru\\"><a href=\\"https://www.linkedin.com/in/morad-elhamdouni/?ref=blog.lesgrandsvoisins.com\\">https://www.linkedin.com/in/morad-elhamdouni/</a></p>"}]	\N	\N	\N	t	113	f	t	\N
