 source : <a href=\\\\\\"https://github.com/chris2fr/django-village\\\\\\">github.com/chris2fr/django-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/django-dsfr\\\\\\">github.com/nurmerique-gouv/django-dsfr</a></p>\\", \\"id\\": \\"0ba756f1-edfc-48ff-91e7-3a2bd67624b4\\"}]", "live": true, "path": "000100050008000B", "slug": "build", "depth": 4, "owner": 1, "title": "Web Dev", "locale": 2, "locked": false, "expired": false, "alias_of": null, "numchild": 1, "url_path": "/villagengo/apps/build/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Web Dev", "content_type": 89, "header_image": null, "header_large": false, "header_darken": false, "live_revision": 1925, "show_in_menus": true, "posts_per_page": 10, "header_cta_link": null, "header_cta_text": null, "latest_revision": 1925, "translation_key": "6a877505-415c-4b0f-80db-a23a55ab0932", "contentpage_tags": [{"pk": 19, "tag": 36, "content_object": 520}], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-07-14T12:38:36.020Z", "first_published_at": "2024-07-14T12:31:58.253Z", "header_color_class": null, "search_description": "Voici des outils régaliens pour des sites citoyens issu de l'outillage qui utilise l'état pour ses 20.000 domaines .gouv.fr. Vous pouvez créer vos propres sites webs, son vos propres services, pour remplacer certains services Google et Wordpress  pour vous-mêmes: un serveur pour tou.te.s et chacun.e !", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-07-14T12:38:35.991Z"}	\N	520	1	89	1	Web Dev
855	2024-06-27 09:59:24.02743+02	{"pk": 202, "body": "[]", "live": true, "path": "00010006", "slug": "paris14", "depth": 2, "owner": 1, "title": "Paris14.Village.Ngo - Pariticpation civique Paris 14", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "sections": "[]", "url_path": "/paris14/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Paris14.Village.Ngo - Pariticpation civique Paris 14", "content_type": 87, "header_image": 137, "header_large": false, "header_darken": true, "live_revision": 854, "show_in_menus": false, "section_1_body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"lg2is\\\\\\">Future site de Paris14.Village.Ngo</h2>\\", \\"id\\": \\"401f04a5-42e5-4ebd-b9f1-2673db4aaf1e\\"}]", "section_2_body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"rih3p\\\\\\">Le choix de Discourse</h3><p data-block-key=\\\\\\"e3fp8\\\\\\"><a href=\\\\\\"https://www.discourse.org/\\\\\\">Discourse</a> est un dispositif plut\\\\u00f4t neutre qui permet un forum.</p>\\", \\"id\\": \\"50e7df6f-68f6-47fb-a6d4-4bdcaed3809b\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"rih3p\\\\\\">Pourquoi g\\\\u00e9rer par Les Grands Voisins sur village.ngo</h3><p data-block-key=\\\\\\"ce8vl\\\\\\">Ce n'est pas parfait et requiert un peu de confiance pour Les Grands Voisins qui suit par ailleurs <a href=\\\\\\"https://www.contractfortheweb.org/fr\\\\\\">le Contrat pour le web</a>.</p><p data-block-key=\\\\\\"di1jm\\\\\\"></p><p data-block-key=\\\\\\"4jilj\\\\\\"><a href=\\\\\\"https://www.village.ngo/fr/annuaire/larochefoucauld/\\\\\\">https://www.village.ngo/fr/annuaire/larochefoucauld/</a></p>\\", \\"id\\": \\"cb1fcd49-f121-4a77-bf18-8958b2841a40\\"}]}, \\"id\\": \\"94a2f42a-25b3-44d9-a139-99c730b549df\\"}]", "section_3_body": "[]", "header_cta_link": "https://www.village.ngo/fr/annuaire/larochefoucauld/", "header_cta_text": "Voir l'entrée de l'annuaire", "latest_revision": 854, "translation_key": "efe109ab-afef-47dd-910d-8cd520eb484c", "contentpage_tags": [], "header_cta_label": "Village.Ngo", "header_with_title": false, "last_published_at": "2024-06-27T07:57:11.181Z", "first_published_at": "2024-06-26T13:54:31.155Z", "header_color_class": null, "search_description": "", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-27T07:57:11.159Z", "section_2_description_rich": "<p data-block-key=\\"vrjts\\">Le dispositif Discourse convient très bien pour des échanges de participation civique. L'association Les Grands Voisins se propose de maintenir un dispositif Discourse au service des administrés dans le 14e arrondissement de Paris notamment pour des échanges autour du nouveau site La Rochefoucauld.</p>"}	\N	202	1	87	1	Paris14.Village.Ngo - Pariticpation civique Paris 14
