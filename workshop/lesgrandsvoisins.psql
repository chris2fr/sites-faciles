136	[{"id": "d6c35ae0-a766-40aa-87f3-2d92b57fb2fb", "type": "imageandtext", "value": {"link": {"page": 134, "text": "Voir les salles de sociabilité numérique", "external_url": ""}, "page": null, "text": "<h2 data-block-key=\\"npe8k\\">Permanence le lundi 12h à 17h</h2><p data-block-key=\\"d5dqj\\">Venez à notre permanence <b>le lundi de 12h à 17h</b><br/>en personne à <b>93 ave. Du Gén. Leclerc</b> 75014 Paris (Métro Alésia, Atelier de la Ressourcerie, <i>7e boutique sur la gauche</i>) ou <a href=\\"https://meet.lesgrandsvoisins.com/\\">meet.lesgrandsvoisins.com pour participer en hybride</a>.</p><h2 data-block-key=\\"e6f8d\\"><a href=\\"https://www.lesgrandsvoisins.fr/numerique/numerique-creatif/sociabilite-numerique/\\"><b>Sociabilité numérique le lundi de 17h à 21h30</b></a></h2><p data-block-key=\\"8ibv4\\"><b>Le lundi de 17h à 21h30</b> se tient un atelier d’entraide numérique à l’Atelier au <b>93 ave. du Gén. Leclerc 75014 PARIS</b> à l’intérieur du <i>centre commercial 7e boutique sur la gauche</i></p>", "image": 26, "link_url": "", "image_side": "right", "link_label": "", "image_ratio": "5"}}]	\N	\N	\N	f	\N	f	f	\N
