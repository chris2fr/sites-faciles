796	2024-06-21 14:29:55.250928+02	{"pk": 149, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"vqswo\\\\\\">Accompagnement de cr\\\\u00e9ateurs et d'artistes</p><p data-block-key=\\\\\\"42ou0\\\\\\">Sp\\\\u00e9cialis\\\\u00e9s dans les march\\\\u00e9s de l'art et la cr\\\\u00e9ation, nous vous apportons notre vision du monde et notre expertise pour vous aider \\\\u00e0 voir plus loin, plus grand.</p><p data-block-key=\\\\\\"3lnrf\\\\\\">A trouver la meilleure version de vous-m\\\\u00eame et les meilleurs march\\\\u00e9s pour vendre et vivre de vos cr\\\\u00e9ations.</p><p data-block-key=\\\\\\"aqqc0\\\\\\"><a href=\\\\\\"https://lebureauducreateur.fr/?ref=blog.lesgrandsvoisins.com\\\\\\">LeBureauDuCreateur.fr</a></p>\\", \\"id\\": \\"d1c61fdf-3ff0-4e74-828e-021d3a663803\\"}]", "date": "2024-06-18T13:49:00Z", "live": true, "path": "000100040005000B", "slug": "le-bureau-du-créateur", "depth": 4, "owner": 2, "title": "Le Bureau du Créateur", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/le-bureau-du-créateur/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Le Bureau du Créateur", "content_type": 71, "header_image": 109, "header_large": false, "header_darken": true, "live_revision": 705, "show_in_menus": true, "blog_categories": [1], "header_cta_link": "https://www.lebureauducreateur.fr/?ref=blog.lesgrandsvoisins.com", "header_cta_text": "Voir le site de Le Bureau du Créateur", "latest_revision": 705, "translation_key": "ba1f0597-c89e-42d0-ae66-7bb74d77128d", "contentpage_tags": [], "entry_categories": [{"pk": 94, "page": 149, "category": 1}], "header_cta_label": "lebureauducreateur.fr", "header_with_title": false, "last_published_at": "2024-06-20T13:55:13.729Z", "first_published_at": "2024-06-18T13:51:43.947Z", "header_color_class": null, "search_description": "Accompagnement de créateurs et d'artistes\\r\\nSpécialisés dans les marchés de l'art et la création, nous vous apportons notre vision du monde et notre expertise pour vous aider à voir plus loin, plus grand.\\r\\n\\r\\nA trouver la meilleure version de vous-même et les meilleurs marchés pour vendre et vivre de vos créations.\\r\\n\\r\\nLeBureauDuCreateur.fr", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-20T13:55:13.704Z"}	\N	149	2	71	1	Le Bureau du Créateur
