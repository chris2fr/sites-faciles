150	2024-05-24 13:48:13.473064+02	{"pk": 50, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"upcmn\\\\\\">Nous tiendrions le 22e Conseil des Voisins sur trois rencontres :</p><ul><li data-block-key=\\\\\\"2hmka\\\\\\">Lundi le 10 juin de 18h \\\\u00e0 19h30</li><li data-block-key=\\\\\\"5vu6t\\\\\\">Jeudi le 13 juin de 19h \\\\u00e0 20h30</li><li data-block-key=\\\\\\"4661g\\\\\\">Samedi le le 15 juin de 10h30 \\\\u00e0 midi</li></ul>\\", \\"id\\": \\"ac7533ae-c366-4707-bc22-a4939919e736\\"}, {\\"type\\": \\"callout\\", \\"value\\": {\\"title\\": \\"Ordre du jour\\", \\"text\\": \\"Num\\\\u00e9rique\\\\r\\\\nCivisme\\\\r\\\\nCommunication\\", \\"heading_tag\\": \\"h3\\"}, \\"id\\": \\"3e989a28-129f-44ab-9d9a-1087fc93dcd6\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": 58, \\"bg_color_class\\": \\"green-tilleul-verveine\\", \\"bg_color\\": \\"\\", \\"title\\": \\"Nous tiendrions le 22e Conseil des Voisins sur trois rencontres :\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"w66ax\\\\\\">Lundi le 10 juin de 18h \\\\u00e0 19h30</p>\\", \\"cta_label\\": \\"Choisir lundi\\", \\"cta_url\\": \\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins\\"}, \\"id\\": \\"1a34efa4-2f1d-46ac-8502-87af2f2fab69\\"}, {\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"w66ax\\\\\\">Jeudi</p>\\", \\"cta_label\\": \\"Choisir jeudi\\", \\"cta_url\\": \\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-1\\"}, \\"id\\": \\"1dada3fc-265e-4f23-92d8-fb3c2a0eacdb\\"}, {\\"type\\": \\"text_cta\\", \\"value\\": {\\"text\\": \\"<p data-block-key=\\\\\\"w66ax\\\\\\">Samedi</p>\\", \\"cta_label\\": \\"Choisir samedi\\", \\"cta_url\\": \\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-2\\"}, \\"id\\": \\"880db029-c159-435