286	2024-06-01 16:52:58.976241+02	{"pk": 115, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"vaedq\\\\\\">En ligne, le 2 mai 2020.</p><h2 data-block-key=\\\\\\"ep4iq\\\\\\">Invit\\\\u00e9s</h2><p data-block-key=\\\\\\"fph8h\\\\\\">Chris Mann<br/>Sabine de la Ressourcerie Cr\\\\u00e9ative Gabriele Santini<br/>Juan Marcos<br/>Peter Dewit<br/>Thomas Egret<br/>Michael Muszlak L'informaticien et personnes venues avant</p><h2 data-block-key=\\\\\\"488f2\\\\\\">Pr\\\\u00e9paration</h2><h3 data-block-key=\\\\\\"50tdh\\\\\\">Confirmer pour le lieu de la r\\\\u00e9union</h3><p data-block-key=\\\\\\"8t2s1\\\\\\">Je, Chris, vais v\\\\u00e9rifier avec Michael.</p><h3 data-block-key=\\\\\\"1dre7\\\\\\">Ordre du jour</h3><ul><li data-block-key=\\\\\\"e26qm\\\\\\">Crowd Funding</li><li data-block-key=\\\\\\"d26hc\\\\\\">Lieu(x) physique(s)</li><li data-block-key=\\\\\\"8qn0v\\\\\\">Voisins potentiels</li><li data-block-key=\\\\\\"5j0b8\\\\\\">Third Space</li><li data-block-key=\\\\\\"8qf3q\\\\\\">Anciens des Grands Voisins lieu physique</li><li data-block-key=\\\\\\"ejouk\\\\\\">Site Web</li><li data-block-key=\\\\\\"7de2a\\\\\\">Outils pour partages</li><li data-block-key=\\\\\\"u3ap\\\\\\">Manifeste</li></ul>\\", \\"id\\": \\"a7ae4aae-44b9-4589-8ad0-b46bdef57104\\"}]", "date": "2020-05-02T11:07:00Z", "live": false, "path": "000100030003000U", "slug": "4e-conseil-des-voisins", "depth": 4, "owner": 1, "title": "4e Conseil des Voisins", "locale": 2, "locked": false, "authors": [1], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home-1/blog/4e-conseil-des-voisins/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "4e Conseil des Voisins", "content_type": 71, "header_image": 89, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": true, "blog_categories": [], "header_cta_link": null, "header_cta_text": null, "latest_revisi