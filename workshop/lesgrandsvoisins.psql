r/digital/admin/\\", \\"document\\": null}, \\"id\\": \\"3a59f10a-d2a6-4e1b-be2d-578a67d74847\\"}]}, \\"id\\": \\"6d29552f-6286-49e2-8f83-a9fb20a411de\\"}]", "live": true, "path": "000100040007", "slug": "digital", "depth": 3, "owner": 1, "title": "Outils numériques", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 8, "url_path": "/le-village-des-grands-voisins/digital/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Outils numériques", "content_type": 25, "header_image": 49, "header_large": false, "header_darken": false, "live_revision": 984, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 984, "translation_key": "9d8b185e-8fcc-4f57-86ef-5ab1dd9320fd", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-06-29T07:21:34.140Z", "first_published_at": "2024-06-29T06:26:37.267Z", "header_color_class": null, "search_description": "Voici les outils numériques disponibles pour toutes et pour tous. […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-29T07:21:34.114Z"}	\N	436	1	25	1	Outils numériques
4	2024-05-05 10:03:03.330957+02	{"pk": 3, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"setew\\\\\\">Venez \\\\u00e0 notre permanence <b>le lundi de 12h \\\\u00e0 19h</b><br/>en personne \\\\u00e0 <b>93 ave. Du G\\\\u00e9n. Leclerc</b> 75014 Paris (M\\\\u00e9tro Al\\\\u00e9sia, Atelier de la Ressourcerie, <i>7e boutique sur la gauche</i>) ou <a href=\\\\\\"https://meet.lesg/\\\\\\">meet.lesgrandsvoisins.com pour participer en hybride</a>.</p><p data-block-key=\\\\\\"5nc7q\\\\\\"><a href=\\\\\\"https://list.lesgrandsvoisins.com/subscription/form\\\\\\"><b><i>Pensez \\\\u00e0 vous inscrire sur notre liste d'infos !</i></b></a></p><p data-block-key=\\\\\\"86uva\\\\\\">Nous sommes une association d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral agissant de mani\\\\u00e8re contr\\\\u00f4l\\\\u00e9e en subsidiarit\\\\u00e9 ouverte pour toute organisation et tout individu qui en fait la d\\\\u00e9cision pour soi-m\\\\u00eame principalement en ces trois domaines <a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\">de Discussions</a>, <a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\">d'Arts plastiques</a> et <a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\">de Num\\\\u00e9rique</a> selon <a href=\\\\\\"https://www.lesgrandsvoisins.fr/mission/\\\\\\">notre d\\\\u00e9claration de mission</a>.</p><p data-block-key=\\\\\\"3gcv9\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\"><b>Discussions</b></a> :</p><ul><li data-block-key=\\\\\\"6cpj3\\\\\\">Nous proposons des conditions encourageant la compr\\\\u00e9hension entre individus et organisations de perspectives diff\\\\u00e9rentes.</li><li data-block-key=\\\\\\"d806j\\\\\\">Nous ouvrons notre gouvernance pour des votes en Conseils des Voisins.</li></ul><p data-block-key=\\\\\\"8mgei\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\"><b>Arts plastiques</b></a> :</p><ul><li data-block-key=\\\\\\"5q1v0\\\\\\">Nous encourageons l\\\\u2019utilisation hybrides d\\\\u2019espace (commerces, h\\\\u00f4pitaux, caf\\\\u00e9s, etc.) aussi en gall\\\\u00e9ries locales.</li><li data-block-key=\\\\\\"bvvk0\\\\\\">Nous accompagnons des institutions pour trouver une juste place pour les arts plastiques dans leurs locaux.</li></ul><p data-block-key=\\\\\\"86ln\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\"><b>Num\\\\u00e9rique</b></a> :</p><ul><li data-block-key=\\\\\\"eq5to\\\\\\">Nous maintenons une constellation de serveurs et de services internet -- tableau de bord, cr\\\\u00e9ation et gestion de compte, courriel, rencontres hybrides pr\\\\u00e9sence-distance, listes de diffusion num\\\\u00e9riques, blogs, serveurs webs, gestionnaire de mot de passe, enregistrement dans le nuage, forums de discussion, gestion de la connaissance, \\\\u00e9dition markdown, wikis, \\\\u00e9dition bueautique, etc. -- pour, par, et de nous-m\\\\u00eames et d'autres.</li><li data-block-key=\\\\\\"35d8f\\\\\\">Nous mettons \\\\u00e0 disposition des talents et des mat\\\\u00e9riaux dans des salles de sociabilit\\\\u00e9 num\\\\u00e9rique et dans des syst\\\\u00e8mes de pr\\\\u00eats et \\\\u00e9changes de mat\\\\u00e9riels \\\\u00e0 l'attention d'individus et d'organisations de tous niveaux.</li></ul><p data-block-key=\\\\\\"bhlhe\\\\\\">Voici quelques entit\\\\u00e9s Grandes Voisines qui soutiennent notre d\\\\u00e9marche: A Good Solution, Banya Tour, Robert Baldridge, BMCP, Breast Freedom, Le Bureau du Cr\\\\u00e9ateur, Le Chiffon, Les Jardins du Num\\\\u00e9rique, Olivier Duhec, Inno Cube, Caroline Lhomme, Francesco du 59 Rivoli, Amadou Gaye, Informatruck, Inolib, KaceKode, Ada Matus, L\\\\u2019Odys\\\\u00e9e, La Ressourcerie Cr\\\\u00e9ative, Henry Roy, Peter Vaeth, Waka Conseil, Weezem, et peut-\\\\u00eatre des v\\\\u00f4tres \\\\u2026</p><p data-block-key=\\\\\\"afnnq\\\\\\">Pour plus d\\\\u2019informations, contactez-nous\\\\u00a0: chris@lesgrandsvoisins.com +33 7 81 811 811</p>\\", \\"id\\": \\"9a9d8a66-6c3a-45f6-87d1-68be735f0e32\\"}, {\\"type\\": \\"video\\", \\"value\\": {\\"title\\": \\"Les Grands Voisins, la cit\\\\u00e9 r\\\\u00eav\\\\u00e9e\\", \\"caption\\": \\"c 3, 2020 R\\\\u00e9alisation : Bastien Simon  Pitch : Ma\\\\u00ebl, artiste sans papier, Adrien, luthier musicien et d'autres r\\\\u00e9sidents venus de tous horizons, s'organisent pour donner naissance \\\\u00e0 une utopie moderne en plein coeur de Paris, un village solidaire de pr\\\\u00e8s de 2000 personnes : Les Grands Voisins. \\\\u00c0 travers leurs trajectoires et celles des membres fondateurs du lieu, le film interroge notre d\\\\u00e9sir et notre capacit\\\\u00e9 \\\\u00e0 inventer d\\\\u2019autres mani\\\\u00e8res de vivre ensemble. Que retiendrons-nous de cette exp\\\\u00e9rience collective ? Pourra-t-elle perdurer, essaimer, r\\\\u00e9sonner ailleurs ?\\", \\"url\\": \\"https://youtu.be/embed/qZqErGfNF_o\\"}, \\"id\\": \\"f53195d5-0de5-479d-aef1-6151fbd266e0\\"}]", "live": true, "path": "00010002", "slug": "home", "depth": 2, "owner": null, "title": "Bienvenue aux Grands Voisins", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 2, "url_path": "/home/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Bienvenue aux Grands Voisins", "content_type": 25, "header_image": null, "header_large": false, "header_darken": false, "live_revision": 3, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 3, "translation_key": "64c061ae-6a72-45e9-bb93-2e884f237976", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-05-05T08:01:29.781Z", "first_published_at": "2024-05-05T07:42:47.708Z", "header_color_class": null, "search_description": "Bienvenue ! Vous venez de créer un site utilisant le gestionnaire de contenus de l’État. Vous pouvez maintenant vous connecter […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-05-05T08:01:29.759Z"}	\N	3	1	25	1	Bienvenue aux Grands Voisins
98	2024-05-06 14:32:24.243905+02	{"pk": 3, "body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"avd09\\\\\\"><b>Permanence le lundi de midi \\\\u00e0 17h</b></h3><p data-block-key=\\\\\\"e0hvf\\\\\\"></p><embed embedtype=\\\\\\"image\\\\\\" format=\\\\\\"left\\\\\\" id=\\\\\\"52\\\\\\" alt=\\\\\\"Abaker-Atelier\\\\\\"/><p data-block-key=\\\\\\"5c5gg\\\\\\"></p><p data-block-key=\\\\\\"dqj9a\\\\\\">Venez \\\\u00e0 notre permanence <b>le lundi de 12h \\\\u00e0 17h</b><br/>en personne \\\\u00e0 <b>93 ave. Du G\\\\u00e9n. Leclerc</b> 75014 Paris (M\\\\u00e9tro Al\\\\u00e9sia, Atelier de la Ressourcerie, <i>7e boutique sur la gauche</i>) ou <a href=\\\\\\"https://meet.lesg/\\\\\\">meet.lesgrandsvoisins.com pour participer en hybride</a>.</p>\\", \\"id\\": \\"460c495c-476c-43f1-bb69-aff7bf1509ea\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"avd09\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/numerique-creatif/sociabilite-numerique/\\\\\\"><b>Sociabilit\\\\u00e9 num\\\\u00e9rique le lundi de 17h \\\\u00e0 21h30</b></a></h3>\\", \\"id\\": \\"6fc069f3-372a-447a-8d33-fd26389bdac8\\"}, {\\"type\\": \\"image\\", \\"value\\": {\\"title\\": \\"Sociabilit\\\\u00e9 num\\\\u00e9rique le lundi de 17h \\\\u00e0 21h30\\", \\"heading_tag\\": \\"h3\\", \\"image\\": 22, \\"alt\\": \\"Sociabilit\\\\u00e9 num\\\\u00e9rique le lundi de 17h \\\\u00e0 21h30\\", \\"caption\\": \\"Sociabilit\\\\u00e9 num\\\\u00e9rique le lundi de 17h \\\\u00e0 21h30\\", \\"url\\": \\"https://www.lesgrandsvoisins.fr/numerique/numerique-creatif/sociabilite-numerique/\\"}, \\"id\\": \\"e6d300c3-467e-44aa-a699-2dadbc697ab3\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<p data-block-key=\\\\\\"v4ydw\\\\\\"><b>Le lundi de 17h \\\\u00e0 21h30</b> se tient un atelier d\\\\u2019entraide num\\\\u00e9rique \\\\u00e0 l\\\\u2019Atelier au <b>93 ave. du G\\\\u00e9n. Leclerc 75014 PARIS</b> \\\\u00e0 l\\\\u2019int\\\\u00e9rieur du <i>centre commercial 7e boutique sur la gauche</i></p>\\", \\"id\\": \\"c195631e-315b-4901-9053-5240615ef6f3\\"}]}, \\"id\\": \\"c58f3abe-971d-41a7-ad49-f547da49dd04\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"q7an3\\\\\\"><a href=\\\\\\"https://list.lesgrandsvoisins.com/subscription/form\\\\\\"><b><i>Pensez \\\\u00e0 vous inscrire sur notre liste d'infos !</i></b></a></p><p data-block-key=\\\\\\"evpog\\\\\\">Nous sommes une association d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral agissant de mani\\\\u00e8re contr\\\\u00f4l\\\\u00e9e en subsidiarit\\\\u00e9 ouverte pour toute organisation et tout individu qui en fait la d\\\\u00e9cision pour soi-m\\\\u00eame principalement en ces trois domaines <a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\">de Discussions</a>, <a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\">d'Arts plastiques</a> et <a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\">de Num\\\\u00e9rique</a> selon <a href=\\\\\\"https://www.lesgrandsvoisins.fr/mission/\\\\\\">notre d\\\\u00e9claration de mission</a>.</p><p data-block-key=\\\\\\"bj8u6\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\"><b>Discussions</b></a> :</p><ul><li data-block-key=\\\\\\"61obe\\\\\\">Nous proposons des conditions encourageant la compr\\\\u00e9hension entre individus et organisations de perspectives diff\\\\u00e9rentes.</li><li data-block-key=\\\\\\"9oi9e\\\\\\">Nous ouvrons notre gouvernance pour des votes en Conseils des Voisins.</li></ul><p data-block-key=\\\\\\"65va7\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\"><b>Arts plastiques</b></a> :</p><ul><li data-block-key=\\\\\\"a2qag\\\\\\">Nous encourageons l\\\\u2019utilisation hybrides d\\\\u2019espace (commerces, h\\\\u00f4pitaux, caf\\\\u00e9s, etc.) aussi en gall\\\\u00e9ries locales.</li><li data-block-key=\\\\\\"2ek3r\\\\\\">Nous accompagnons des institutions pour trouver une juste place pour les arts plastiques dans leurs locaux.</li></ul><p data-block-key=\\\\\\"91unk\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\"><b>Num\\\\u00e9rique</b></a> :</p><ul><li data-block-key=\\\\\\"afesu\\\\\\">Nous maintenons une constellation de serveurs et de services internet -- tableau de bord, cr\\\\u00e9ation et gestion de compte, courriel, rencontres hybrides pr\\\\u00e9sence-distance, listes de diffusion num\\\\u00e9riques, blogs, serveurs webs, gestionnaire de mot de passe, enregistrement dans le nuage, forums de discussion, gestion de la connaissance, \\\\u00e9dition markdown, wikis, \\\\u00e9dition bueautique, etc. -- pour, par, et de nous-m\\\\u00eames et d'autres.</li><li data-block-key=\\\\\\"ej6ca\\\\\\">Nous mettons \\\\u00e0 disposition des talents et des mat\\\\u00e9riaux dans des salles de sociabilit\\\\u00e9 num\\\\u00e9rique et dans des syst\\\\u00e8mes de pr\\\\u00eats et \\\\u00e9changes de mat\\\\u00e9riels \\\\u00e0 l'attention d'individus et d'organisations de tous niveaux.</li></ul><p data-block-key=\\\\\\"apjqo\\\\\\">Voici quelques entit\\\\u00e9s Grandes Voisines qui soutiennent notre d\\\\u00e9marche: A Good Solution, Banya Tour, Robert Baldridge, BMCP, Breast Freedom, Le Bureau du Cr\\\\u00e9ateur, Le Chiffon, Les Jardins du Num\\\\u00e9rique, Olivier Duhec, Inno Cube, Caroline Lhomme, Francesco du 59 Rivoli, Amadou Gaye, Informatruck, Inolib, KaceKode, Ada Matus, L\\\\u2019Odys\\\\u00e9e, La Ressourcerie Cr\\\\u00e9ative, Henry Roy, Peter Vaeth, Waka Conseil, Weezem, et peut-\\\\u00eatre des v\\\\u00f4tres \\\\u2026</p><p data-block-key=\\\\\\"at7dp\\\\\\">Pour plus d\\\\u2019informations, contactez-nous\\\\u00a0: chris@lesgrandsvoisins.com +33 7 81 811 811</p>\\", \\"id\\": \\"d3e4fb2e-7b28-4da0-99d3-09c2868a013f\\"}, {\\"type\\": \\"video\\", \\"value\\": {\\"title\\": \\"Les Grands Voisins, la cit\\\\u00e9 r\\\\u00eav\\\\u00e9e\\", \\"caption\\": \\"c 3, 2020 R\\\\u00e9alisation : Bastien Simon  Pitch : Ma\\\\u00ebl, artiste sans papier, Adrien, luthier musicien et d'autres r\\\\u00e9sidents venus de tous horizons, s'organisent pour donner naissance \\\\u00e0 une utopie moderne en plein coeur de Paris, un village solidaire de pr\\\\u00e8s de 2000 personnes : Les Grands Voisins. \\\\u00c0 travers leurs trajectoires et celles des membres fondateurs du lieu, le film interroge notre d\\\\u00e9sir et notre capacit\\\\u00e9 \\\\u00e0 inventer d\\\\u2019autres mani\\\\u00e8res de vivre ensemble. Que retiendrons-nous de cette exp\\\\u00e9rience collective ? Pourra-t-elle perdurer, essaimer, r\\\\u00e9sonner ailleurs ?\\", \\"url\\": \\"https://www.youtube.com/embed/qZqErGfNF_o?feature=oembed\\"}, \\"id\\": \\"f53195d5-0de5-479d-aef1-6151fbd266e0\\"}]", "live": true, "path": "00010002", "slug": "home", "depth": 2, "owner": null, "title": "Bienvenue aux Grands Voisins", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 7, "url_path": "/home/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "L'association Les Grands Voisins", "go_live_at": null, "draft_title": "Bienvenue aux Grands Voisins", "content_type": 25, "header_image": 7, "header_large": true, "header_darken": true, "live_revision": 97, "show_in_menus": true, "header_cta_link": "https://facile.lesgrandsvoisins.com/mission", "header_cta_text": "L'Autre est une chance !", "latest_revision": 97, "translation_key": "64c061ae-6a72-45e9-bb93-2e884f237976", "contentpage_tags": [], "header_cta_label": "Lire la mission des Grands Voisins", "header_with_title": true, "last_published_at": "2024-05-06T12:30:30.193Z", "first_published_at": "2024-05-05T07:42:47.708Z", "header_color_class": "blue-france", "search_description": "Nous, aux GV, nous œuvrons pour la compréhension entre peuples qui pourraient ne pas avoir tendance à communiquer habituellement. C'est le sens même de notre nom :\\r\\n\\r\\n« Les » comme les autres\\r\\n\\r\\n« Grands » comme les autres sont grands\\r\\n\\r\\n« Voisins » comme quoi les autres sont proches de nous, et nous sommes aussi des grands autres d'autres", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-05-06T12:30:30.164Z"}	\N	3	1	25	1	Bienvenue aux Grands Voisins
