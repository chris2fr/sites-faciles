504	2024-06-18 15:54:38.968504+02	{"pk": 152, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"4g1jt\\\\\\">Artisan d\\\\u2019art, dipl\\\\u00f4m\\\\u00e9 de l\\\\u2019\\\\u00c9cole Boulle en 1999, Olivier Duhec a pass\\\\u00e9 dix ann\\\\u00e9es \\\\u00e0 se perfectionner dans le travail du m\\\\u00e9tal chez des cr\\\\u00e9ateurs parmi les plus prestigieux, dont Jean Perzel qui a beaucoup influenc\\\\u00e9 son travail.</p><p data-block-key=\\\\\\"fbkgd\\\\\\"><a href=\\\\\\"https://www.linkedin.com/in/caroline-lhomme?ref=blog.lesgrandsvoisins.com\\\\\\">DuHec.Art.</a></p>\\", \\"id\\": \\"075cb964-b027-4743-a1fd-bb92f483510d\\"}]", "date": "2024-06-18T13:53:00Z", "live": false, "path": "00010002000B0004000E", "slug": "olivier-duhec", "depth": 5, "owner": 2, "title": "Olivier DUHEC", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/le-village-des-grands-voisins/les-voisins/olivier-duhec/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Olivier DUHEC", "content_type": 71, "header_image": 112, "header_large": false, "header_darken": true, "live_revision": null, "show_in_menus": true, "blog_categories": [], "header_cta_link": null, "header_cta_text": null, "latest_revision": 503, "translation_key": "a1c5428b-15bb-4191-8675-beef434858a8", "contentpage_tags": [], "entry_categories": [], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Artisan d’art, diplômé de l’École Boulle en 1999, Olivier Duhec a passé dix années à se perfectionner dans le travail du métal chez des créateurs parmi les plus prestigieux, dont Jean Perzel qui a beaucoup influencé son travail.\\r\\n\\r\\nDuHec.Art.", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": "2024-06-18T