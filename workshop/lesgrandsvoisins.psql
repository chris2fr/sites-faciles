1907	2024-07-14 14:31:57.089554+02	{"pk": 520, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"7jjj0\\\\\\">Outils r\\\\u00e9galiens pour des sites citoyens &amp; un serveur pour tous !</h2><p data-block-key=\\\\\\"1q4g4\\\\\\">Voici des outils r\\\\u00e9galiens pour des sites citoyens issu de l'outillage qui utilise l'\\\\u00e9tat pour ses 20.000 domaines .gouv.fr. Vous pouvez cr\\\\u00e9er vos propres sites webs, son vos propres services, pour remplacer certains services Google et Wordpress  pour vous-m\\\\u00eames: un serveur pour tou.te.s et chacun.e !</p>\\", \\"id\\": \\"a80cf434-d0c4-43cf-bce7-24bd49690b3d\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"7jjj0\\\\\\">Wagtail-Fastoche pour vos cha\\\\u00eenes d'\\\\u00e9dition num\\\\u00e9riques</h3><p data-block-key=\\\\\\"74md3\\\\\\">site-exemple : <a href=\\\\\\"https://wagtail.village.ngo\\\\\\">wagtail.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/wagtail-village\\\\\\">github.com/chris2fr/wagtail-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/sites-faciles\\\\\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\\\\\"bgcv2\\\\\\">Django-Fastoche pour vos applications webs</h3><p data-block-key=\\\\\\"4pivt\\\\\\">site-exemple : <a href=\\\\\\"https://django.village.ngo\\\\\\">django.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/django-village\\\\\\">github.com/chris2fr/django-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/django-dsfr\\\\\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\\\\\"f8qe8\\\\\\">Fabrique-Fastoche pour vos syst\\\\u00e8mes de design num\\\\u00e9riques</h3><p data-block-key=\\\\\\"c8g1s\\\\\\">site-exemple : <a href=\\\\\\"https://django.village.ngo\\\\\\">django.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/django-village\\\\\\">github.com/chris2fr/django-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/django-dsfr\\\\\\">github.com/nurmerique-gouv/django-dsfr</a></p>\\", \\"id\\": \\"0ba756f1-edfc-48ff-91e7-3a2bd67624b4\\"}]", "live": false, "path": "000100050008000B", "slug": "build", "depth": 4, "owner": 1, "title": "Bâtir son web citoyen", "locale": 2, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/villagengo/apps/build/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Bâtir son web citoyen", "content_type": 89, "header_image": null, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": true, "posts_per_page": 10, "header_cta_link": null, "header_cta_text": null, "latest_revision": 1906, "translation_key": "6a877505-415c-4b0f-80db-a23a55ab0932", "contentpage_tags": [{"pk": 17, "tag": 36, "content_object": 520}], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Voici des outils régaliens pour des sites citoyens issu de l'outillage qui utilise l'état pour ses 20.000 domaines .gouv.fr. Vous pouvez créer vos propres sites webs, son vos propres services, pour remplacer certains services Google et Wordpress  pour vous-mêmes: un serveur pour tou.te.s et chacun.e !", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": "2024-07-14T12:31:57.049Z"}	\N	520	1	89	1	Bâtir son web citoyen
911	2024-06-27 16:40:08.50497+02	{"pk": 202, "body": "[]", "live": true, "path": "00010006", "slug": "paris14", "depth": 2, "owner": 1, "title": "Paris14.Village.Ngo - Pariticpation civique Paris 14", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "sections": "[]", "url_path": "/paris14/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Paris14.Village.Ngo - Pariticpation civique Paris 14", "content_type": 87, "header_image": 137, "header_large": false, "header_darken": true, "live_revision": 910, "show_in_menus": false, "section_1_body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"lg2is\\\\\\">Futur site de Paris14.Village.Ngo</h2>\\", \\"id\\": \\"401f04a5-42e5-4ebd-b9f1-2673db4aaf1e\\"}]", "section_2_body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"rih3p\\\\\\">Le choix de Discourse</h3><p data-block-key=\\\\\\"e3fp8\\\\\\"><a href=\\\\\\"https://www.discourse.org/\\\\\\">Discourse</a> est un dispositif plut\\\\u00f4t neutre qui permet un forum.</p><p data-block-key=\\\\\\"9skub\\\\\\"><a href=\\\\\\"https://discourse.village.ngo/\\\\\\">https://discourse.village.ngo/</a></p>\\", \\"id\\": \\"50e7df6f-68f6-47fb-a6d4-4bdcaed3809b\\"}, {\\"type\\": \\"text\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"rih3p\\\\\\">Pourquoi g\\\\u00e9rer par Les Grands Voisins sur village.ngo</h3><p data-block-key=\\\\\\"ce8vl\\\\\\">Ce n'est pas parfait et requiert un peu de confiance pour Les Grands Voisins qui suit par ailleurs <a href=\\\\\\"https://www.contractfortheweb.org/fr\\\\\\">le Contrat pour le web</a>.</p><p data-block-key=\\\\\\"di1jm\\\\\\"><a href=\\\\\\"https://www.village.ngo/fr/annuaire/paris14/\\\\\\">village.ngo / annuaire / paris14</a><a href=\\\\\\"https://www.village.ngo/fr/annuaire/larochefoucauld/\\\\\\">larochefoucauld/</a></p>\\", \\"id\\": \\"cb1fcd49-f121-4a77-bf18-8958b2841a40\\"}]}, \\"id\\": \\"94a2f42a-25b3-44d9-a139-99c730b549df\\"}]", "section_3_body": "[]", "header_cta_link": "https://www.village.ngo/fr/annuaire/larochefoucauld/", "header_cta_text": "Voir l'entrée de l'annuaire", "latest_revision": 910, "translation_key": "efe109ab-afef-47dd-910d-8cd520eb484c", "contentpage_tags": [], "header_cta_label": "Village.Ngo", "header_with_title": false, "last_published_at": "2024-06-27T14:36:58.842Z", "first_published_at": "2024-06-26T13:54:31.155Z", "header_color_class": null, "search_description": "", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-27T14:36:58.801Z", "section_2_description_rich": "<p data-block-key=\\"vrjts\\">Le dispositif Discourse convient très bien pour des échanges de participation civique. L'association Les Grands Voisins se propose de maintenir un dispositif Discourse au service des administrés dans le 14e arrondissement de Paris notamment pour des échanges autour du nouveau site La Rochefoucauld.</p>"}	\N	202	1	87	1	Paris14.Village.Ngo - Pariticpation civique Paris 14
1017	2024-07-01 20:17:52.914055+02	{"pk": 135, "body": "[{\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 26, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"5\\", \\"text\\": \\"<h2 data-block-key=\\\\\\"npe8k\\\\\\">Permanence le lundi 12h \\\\u00e0 17h</h2><p data-block-key=\\\\\\"d5dqj\\\\\\">Venez \\\\u00e0 notre permanence <b>le lundi de 12h \\\\u00e0 17h</b><br/>en personne \\\\u00e0 <b>93 ave. Du G\\\\u00e9n. Leclerc</b> 75014 Paris (M\\\\u00e9tro Al\\\\u00e9sia, Atelier de la Ressourcerie, <i>7e boutique sur la gauche</i>) ou <a href=\\\\\\"https://meet.lesgrandsvoisins.com/\\\\\\">meet.lesgrandsvoisins.com pour participer en hybride</a>.</p><h2 data-block-key=\\\\\\"e6f8d\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/numerique-creatif/sociabilite-numerique/\\\\\\"><b>Sociabilit\\\\u00e9 num\\\\u00e9rique le lundi de 17h \\\\u00e0 21h30</b></a></h2><p data-block-key=\\\\\\"8ibv4\\\\\\"><b>Le lundi de 17h \\\\u00e0 21h30</b> se tient un atelier d\\\\u2019entraide num\\\\u00e9rique \\\\u00e0 l\\\\u2019Atelier au <b>93 ave. du G\\\\u00e9n. Leclerc 75014 PARIS</b> \\\\u00e0 l\\\\u2019int\\\\u00e9rieur du <i>centre commercial 7e boutique sur la gauche</i></p>\\", \\"link\\": {\\"page\\": 134, \\"external_url\\": \\"\\", \\"text\\": \\"Voir les salles de sociabilit\\\\u00e9 num\\\\u00e9rique\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"d6c35ae0-a766-40aa-87f3-2d92b57fb2fb\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 93, \\"image_side\\": \\"left\\", \\"image_ratio\\": \\"6\\", \\"text\\": \\"<h2 data-block-key=\\\\\\"cw46c\\\\\\">22e Conseil des Voisins du 10 au 16 juin 2024</h2><p data-block-key=\\\\\\"8s1t0\\\\\\">\\\\ud83c\\\\udf1f <b>Venez co-constuire un voisinage</b> \\\\ud83c\\\\udf1f</p><p data-block-key=\\\\\\"f2jog\\\\\\"><i>anim\\\\u00e9, chic, vivant,partageant, \\\\u00e9quip\\\\u00e9,ressour\\\\u00e7ant, respectueux,mondial, multiculturel,prosp\\\\u00e8re, et de proximit\\\\u00e9.</i></p><p data-block-key=\\\\\\"fp0p9\\\\\\">Nous tiendrions le 22e Conseil des Voisins sur trois rencontres :</p><ul><li data-block-key=\\\\\\"7ohgo\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins\\\\\\">Lundi le 10 juin de 19h45 \\\\u00e0 21h25</a></li><li data-block-key=\\\\\\"csdek\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-1\\\\\\">Jeudi le 13 juin de 15h15 \\\\u00e0 16h45</a></li><li data-block-key=\\\\\\"aso3g\\\\\\"><a href=\\\\\\"https://www.helloasso.com/associations/les-grands-voisins/evenements/les-grands-voisins-2\\\\\\">Samedi le le 15 juin de 10h15 \\\\u00e0 11h45</a></li></ul><p data-block-key=\\\\\\"f20hj\\\\\\">Ordre du jour :</p><ol><li data-block-key=\\\\\\"boa4d\\\\\\">Num\\\\u00e9rique</li><li data-block-key=\\\\\\"1khco\\\\\\">\\\\u00c9ventuellement Civisme</li><li data-block-key=\\\\\\"d1unh\\\\\\">Communication</li></ol>\\", \\"link\\": {\\"page\\": 50, \\"external_url\\": \\"\\", \\"text\\": \\"Venez co-constuire un voisinage lors du 22e Conseil des voisins.\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"609eb7c0-f102-4cf1-b302-04cef750054f\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"2rlrq\\\\\\"><a href=\\\\\\"https://list.lesgrandsvoisins.com/subscription/form\\\\\\"><b><i>Pensez \\\\u00e0 vous inscrire sur notre liste d'infos !</i></b></a></h3><p data-block-key=\\\\\\"c046k\\\\\\">Nous sommes une association d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral agissant de mani\\\\u00e8re contr\\\\u00f4l\\\\u00e9e en subsidiarit\\\\u00e9 ouverte pour toute organisation et tout individu qui en fait la d\\\\u00e9cision pour soi-m\\\\u00eame principalement en ces trois domaines <a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\">de Discussions</a>, <a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\">d'Arts plastiques</a> et <a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\">de Num\\\\u00e9rique</a> selon <a href=\\\\\\"https://www.lesgrandsvoisins.fr/mission/\\\\\\">notre d\\\\u00e9claration de mission</a>.</p><p data-block-key=\\\\\\"8nof2\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/communautes/\\\\\\"><b>Civisme</b></a> :</p><ul><li data-block-key=\\\\\\"4dfni\\\\\\">Nous proposons des conditions encourageant la compr\\\\u00e9hension entre individus et organisations de perspectives diff\\\\u00e9rentes.</li><li data-block-key=\\\\\\"3ormf\\\\\\">Nous ouvrons notre gouvernance pour des votes en Conseils des Voisins.</li></ul><p data-block-key=\\\\\\"51nl6\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/arts/\\\\\\"><b>Arts plastiques</b></a> :</p><ul><li data-block-key=\\\\\\"1c45a\\\\\\">Nous encourageons l\\\\u2019utilisation hybrides d\\\\u2019espace (commerces, h\\\\u00f4pitaux, caf\\\\u00e9s, etc.) aussi en gall\\\\u00e9ries locales.</li><li data-block-key=\\\\\\"97vmp\\\\\\">Nous accompagnons des institutions pour trouver une juste place pour les arts plastiques dans leurs locaux.</li></ul><p data-block-key=\\\\\\"f50ea\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\"><b>Num\\\\u00e9rique</b></a> :</p><ul><li data-block-key=\\\\\\"5gvr6\\\\\\">Nous maintenons une constellation de serveurs et de services internet -- tableau de bord, cr\\\\u00e9ation et gestion de compte, courriel, rencontres hybrides pr\\\\u00e9sence-distance, listes de diffusion num\\\\u00e9riques, blogs, serveurs webs, gestionnaire de mot de passe, enregistrement dans le nuage, forums de discussion, gestion de la connaissance, \\\\u00e9dition markdown, wikis, \\\\u00e9dition bueautique, etc. -- pour, par, et de nous-m\\\\u00eames et d'autres.</li><li data-block-key=\\\\\\"emg6m\\\\\\">Nous mettons \\\\u00e0 disposition des talents et des mat\\\\u00e9riaux dans des salles de sociabilit\\\\u00e9 num\\\\u00e9rique et dans des syst\\\\u00e8mes de pr\\\\u00eats et \\\\u00e9changes de mat\\\\u00e9riels \\\\u00e0 l'attention d'individus et d'organisations de tous niveaux.</li></ul><p data-block-key=\\\\\\"9n2mc\\\\\\">Voici quelques entit\\\\u00e9s Grandes Voisines qui soutiennent notre d\\\\u00e9marche: A Good Solution, Banya Tour, Robert Baldridge, BMCP, Breast Freedom, Le Bureau du Cr\\\\u00e9ateur, Le Chiffon, Les Jardins du Num\\\\u00e9rique, Olivier Duhec, Inno Cube, Caroline Lhomme, Francesco du 59 Rivoli, Amadou Gaye, Informatruck, Inolib, KaceKode, Ada Matus, L\\\\u2019Odys\\\\u00e9e, La Ressourcerie Cr\\\\u00e9ative, Henry Roy, Peter Vaeth, Waka Conseil, Weezem, et peut-\\\\u00eatre des v\\\\u00f4tres \\\\u2026</p><p data-block-key=\\\\\\"fgqkl\\\\\\">Pour plus d\\\\u2019informations, contactez-nous\\\\u00a0:</p><p data-block-key=\\\\\\"ff18b\\\\\\">bienvenue@lesgrandsvoisins.com</p><p data-block-key=\\\\\\"26hsg\\\\\\">+33 7 81 811 811</p><p data-block-key=\\\\\\"5q99f\\\\\\"><a href=\\\\\\"https://www.village.ngo/en/activites/civisme/\\\\\\">Civisme</a> - <a href=\\\\\\"https://www.village.ngo/en/activites/arts-plastiques/\\\\\\">Arts plastiques</a> - <a href=\\\\\\"https://www.village.ngo/en/activites/numerique/\\\\\\">Num\\\\u00e9rique</a></p>\\", \\"id\\": \\"2b04bc61-d040-4232-adff-b8a82cc25497\\"}]", "live": true, "path": "00010004", "slug": "le-village-des-grands-voisins", "depth": 2, "owner": 1, "title": "Les Grands Voisins", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 6, "sections": "[]", "url_path": "/le-village-des-grands-voisins/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Les Grands Voisins", "content_type": 87, "header_image": null, "header_large": false, "header_darken": false, "live_revision": 1015, "show_in_menus": false, "section_1_body": "[{\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"text\\", \\"value\\": \\"<h2 data-block-key=\\\\\\"w1uv4\\\\\\">Les Grands Voisins / VillageNgo<br/><b><i>L'Autre</i></b><i> est une chance.</i></h2><p data-block-key=\\\\\\"6fefc\\\\\\">Nous co-construisons un voisinage compl\\\\u00e9mentaire aux voisinages existants.</p><p data-block-key=\\\\\\"6bci7\\\\\\">Dans notre village, vous trouverez des Grands Voisins de toutes les cat\\\\u00e9gories collectives -- associations, entreprises, institutions publics, services sociaux, promoteurs grands publics, etc. -- et individuelles : artistes, artisans, professionnels, demandeurs d'emploi, avec ou sans papiers, salari\\\\u00e9s, ind\\\\u00e9pendants, etc ; puis vous trouverez des individus dans toutes nos richesses : un individu une voix.</p><p data-block-key=\\\\\\"aq1jh\\\\\\">Notre association coop\\\\u00e9rative se propose aussi de montrer l'exemple par des activit\\\\u00e9s propres en civisme, en arts plastiques et en num\\\\u00e9rique. Cela dit, notre mission premi\\\\u00e8re est dans la subsidiarit\\\\u00e9; nous la recherchons toujours et partout.</p>\\", \\"id\\": \\"b326d84c-6f90-4cb2-992a-718d65198627\\"}, {\\"type\\": \\"video\\", \\"value\\": {\\"title\\": \\"La cit\\\\u00e9 r\\\\u00eav\\\\u00e9e\\", \\"caption\\": \\"Les Grands Voisins, la cit\\\\u00e9 r\\\\u00eav\\\\u00e9e filme documentaire long-m\\\\u00e9trage pass\\\\u00e9 dans les salles en 2020\\", \\"url\\": \\"https://www.youtube.com/embed/qZqErGfNF_o\\"}, \\"id\\": \\"ce39e208-107d-4c71-af8c-0e04d024d259\\"}]}, \\"id\\": \\"a786ba6e-81eb-4111-a58d-24313d175753\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"zzgjc\\\\\\">Agenda</h3>\\", \\"id\\": \\"777fce06-1fa9-4fd8-a74b-d01a6f8c3712\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 161, \\"image_side\\": \\"left\\", \\"image_ratio\\": \\"5\\", \\"text\\": \\"<h3 data-block-key=\\\\\\"2llg8\\\\\\">F\\\\u00eate de la fermeture du CHU Emma\\\\u00fcs Solidarit\\\\u00e9</h3><p data-block-key=\\\\\\"4r14g\\\\\\"><a href=\\\\\\"https://maps.app.goo.gl/AdigD2A4nY9ABmiQA\\\\\\">50 bd Jourdan 75014 PARIS</a></p><p data-block-key=\\\\\\"716i3\\\\\\">mercredi le 3 juillet</p><p data-block-key=\\\\\\"2mmqp\\\\\\">14h \\\\u00e0 16h : Repas des Mamans</p><p data-block-key=\\\\\\"845q\\\\\\">16h \\\\u00e0 17h : Contes</p><p data-block-key=\\\\\\"e8adl\\\\\\">17h et apr\\\\u00e8s : Concerts avec de multiples artistes</p><p data-block-key=\\\\\\"etbi6\\\\\\"><a href=\\\\\\"https://www.village.ngo/medias/images/fete-cloture-emmaus-20204.original.png\\\\\\">Affiche</a></p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"\\", \\"text\\": \\"\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"ad7f3b8e-10f7-4643-ad1a-d7a41cdf2126\\"}, {\\"type\\": \\"image\\", \\"value\\": {\\"title\\": \\"\\", \\"heading_tag\\": \\"h3\\", \\"image\\": 162, \\"alt\\": \\"\\", \\"caption\\": \\"\\", \\"url\\": \\"https://www.laressourceriecreative.com/la-guinguette\\"}, \\"id\\": \\"2b88adaf-12c2-4bac-8583-112dfb552e68\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"x7h1i\\\\\\">La Guiguette de la Ressourcerie Cr\\\\u00e9ative</h3><p data-block-key=\\\\\\"3hev9\\\\\\">15\\\\u00a0juin au 29 Juillet les jeudis, vendredis et samedis</p><p data-block-key=\\\\\\"e1v49\\\\\\">17h \\\\u00e0 23h</p><p data-block-key=\\\\\\"agvdg\\\\\\">Square Serment de Koufra, 75014 PARIS</p><p data-block-key=\\\\\\"epm39\\\\\\">Rendez-vous \\\\u00e0 partir du 15\\\\u00a0juin au 29 Juillet \\\\u00e0 Porte d'Orl\\\\u00e9ans au sein du square du Serment de Koufra, 75014.\\\\u00a0 L'id\\\\u00e9e ? Cr\\\\u00e9er un lieu \\\\u00e9ph\\\\u00e9m\\\\u00e8re pour accueillir le temps d'un \\\\u00e9t\\\\u00e9 les habitants et passant du quartier dans un coin en pleine nature !</p><p data-block-key=\\\\\\"arua2\\\\\\"><a href=\\\\\\"https://www.laressourceriecreative.com/la-guinguette\\\\\\">Voir plus de d\\\\u00e9tails sur le site de la Ressourcerie</a>.</p>\\", \\"id\\": \\"6bb693f0-994a-4d39-95ee-5617b6c2d9bd\\"}, {\\"type\\": \\"video\\", \\"value\\": {\\"title\\": \\"\\", \\"caption\\": \\"Mise en place de la guinguette\\", \\"url\\": \\"https://www.youtube.com/watch?v=-5-W0IPq_jg\\"}, \\"id\\": \\"8e7e430d-4334-412a-b8c6-438ea6d303b0\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"Activit\\\\u00e9s\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Civisme\\", \\"description\\": \\"Nous nous proposons en tant \\\\u00ab qu'association coop\\\\u00e9rative d'int\\\\u00e9r\\\\u00eat public \\\\u00bb. Cela fait que nous d\\\\u00e9cidons comme si nous \\\\u00e9tions une coop\\\\u00e9rative, sauf que tous nos services sont de, par et pour tous nos usagers. Nous nous appliquons alors des principes de transparence et d\\\\u2019ind\\\\u00e9pendance forts.\\", \\"image\\": 45, \\"url\\": \\"https://www.village.ngo/fr/activit%C3%A9s/civisme/\\", \\"document\\": null}, \\"id\\": \\"48217c4e-c6d5-4069-9d65-2095e6e8716d\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Arts plastiques\\", \\"description\\": \\"Nous encourageons les artistes et les commer\\\\u00e7ants locaux \\\\u00e0 faire des popup expos, soutenons les artistes plasticiens et pr\\\\u00e9voyons d'organiser une vente aux ench\\\\u00e8res\\", \\"image\\": 50, \\"url\\": \\"https://www.village.ngo/fr/activit%C3%A9s/arts-plastiques/\\", \\"document\\": null}, \\"id\\": \\"c566bf79-f05e-4bf6-bdf1-df752d4d6cb7\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Num\\\\u00e9rique\\", \\"description\\": \\"Pouss\\\\u00e9s par la Mission des Grands Voisins et le Contrat pour le Web, nous avan\\\\u00e7ons avec assurance dans le num\\\\u00e9rique interd\\\\u00e9pendant et autonome des Grands Voisins par le d\\\\u00e9veloppement de salles de sociabilit\\\\u00e9 num\\\\u00e9riques, des partages de mat\\\\u00e9riaux entre structures, et des constellations de serveurs et de services.\\", \\"image\\": 49, \\"url\\": \\"https://www.village.ngo/fr/activit%C3%A9s/numerique/\\", \\"document\\": null}, \\"id\\": \\"c337e1a5-bc00-4651-9785-9761554cfe0a\\"}]}, \\"id\\": \\"e7581eeb-45bd-4c0d-949a-1f744d68225f\\"}]", "section_2_body": "[{\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 96, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"5\\", \\"text\\": \\"<p data-block-key=\\\\\\"dkeo3\\\\\\">UN VOISINAGE COMPL\\\\u00c9MENTAIRE</p><h2 data-block-key=\\\\\\"33a8d\\\\\\"><b>Des structures et collectifs</b></h2><p data-block-key=\\\\\\"30oc5\\\\\\">Les structures sont les canaux d\\\\u2019action \\\\u00e0 travers l\\\\u2019association coop\\\\u00e9rative d\\\\u2019int\\\\u00e9r\\\\u00eat public. Les structures peuvent \\\\u00eatre des associations, des entreprises, des professionnels, des artistes, des artisans, des collectifs, des services sociaux, ou des institutions publiques. Nous souhaitons fournir un soutien aux structures selon le principe de subsidiarit\\\\u00e9 et selon la volont\\\\u00e9 des individus. Une structure ou communaut\\\\u00e9 peut comprendre plusieurs individus.</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"\\", \\"text\\": \\"\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"6563f8da-4a7e-493b-8358-9e51f4352c1f\\"}, {\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 97, \\"image_side\\": \\"left\\", \\"image_ratio\\": \\"5\\", \\"text\\": \\"<p data-block-key=\\\\\\"dkeo3\\\\\\">QUI SONT GRANDS VOISINS QUI VEULENT BIEN</p><h2 data-block-key=\\\\\\"19cun\\\\\\"><b>Association gouvern\\\\u00e9e par vous</b></h2><p data-block-key=\\\\\\"41mcs\\\\\\">Les individus gouvernent Les Grands Voisins. Les individus comprennent et d\\\\u00e9cident individuellement. Toute personne physique qui le souhaite, par seule sa propre volont\\\\u00e9, est membre votant des Grands Voisins. Seulement les individus (pas les structures) votent dans les Conseils des Grands Voisins. Nous sommes transparents pour tout individu qui souhaite des informations que nous pouvons fournir. Chaque individu peut faire partie d'une ou plusieurs structures ou communaut\\\\u00e9s.</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"\\", \\"text\\": \\"\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"4dda2eb2-baa1-48df-be54-f7ecdee02f9a\\"}]", "section_3_body": "[{\\"type\\": \\"accordions\\", \\"value\\": [{\\"type\\": \\"title\\", \\"value\\": \\"Les Grands Voisins\\", \\"id\\": \\"1c93f2da-7ff6-4f28-9ca0-f47d778816d1\\"}, {\\"type\\": \\"accordion\\", \\"value\\": {\\"title\\": \\"Quels sont les sites webs de l'association Les Grands Voisins ?\\", \\"content\\": \\"<p data-block-key=\\\\\\"9a1ky\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr\\\\\\">LesGrandsVoisins.fr</a> : Le site public principal des Grands Voisins</p><p data-block-key=\\\\\\"ejt7u\\\\\\"><a href=\\\\\\"https://www.resdigita.com\\\\\\">ResDigita.com</a> : Le num\\\\u00e9rique des Grands Voisins se nomme ResDigita.</p><p data-block-key=\\\\\\"8tu6\\\\\\"><a href=\\\\\\"https://blog.lesgrandsvoisins.com\\\\\\">Blog.LesGrandsVoisins.com</a> : Notre blog (accessible depuis le site principal)</p>\\"}, \\"id\\": \\"48f40f9e-a2a1-4689-8e88-748e6be1672d\\"}, {\\"type\\": \\"accordion\\", \\"value\\": {\\"title\\": \\"Quels sont les m\\\\u00e9dias sociaux de l'association ?\\", \\"content\\": \\"<p data-block-key=\\\\\\"9a1ky\\\\\\"><a href=\\\\\\"https://www.instagram.com/les_grands_voisins/\\\\\\">Instagram@les_grands_voisins</a></p><p data-block-key=\\\\\\"eoa6g\\\\\\">Facebook</p><p data-block-key=\\\\\\"pdij\\\\\\">LinkedIn</p>\\"}, \\"id\\": \\"ebf17063-1f73-4f98-851a-d8324c7a4de3\\"}], \\"id\\": \\"d706e793-1ea0-4eb3-a841-21fe72ea3dad\\"}]", "header_cta_link": null, "header_cta_text": null, "latest_revision": 1015, "translation_key": "b503fd04-9007-4d34-b340-c45938c9bcd4", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-07-01T18:14:39.050Z", "first_published_at": "2024-06-09T08:35:47.374Z", "header_color_class": null, "search_description": "Sociabilité numérique le lundi de 17h à 21h30 Le lundi de 17h à 21h30 se tient un atelier d’entraide numérique […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-07-01T18:14:39.016Z", "section_2_description_rich": "<p data-block-key=\\"hrhup\\">Notre village est construit d'acteurs socio-économiques et d'individus. Nous nous trouvons toutes et tous à l'intersection de ces deux concepts. Bien que dans le village, nous voyons d'abord les entités -- personnes physiques et personnes morales -- nous décidons pour une bonne partie en personnes individuelles et consciencieuses, en grands voisins selon la définition subjective de chacune et de chacun de ce que c'est être grande voisine ou être grand voisin.</p>"}	\N	135	1	87	1	Les Grands Voisins
978	2024-06-29 09:11:08.137489+02	{"pk": 229, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"ur1sv\\\\\\">Voici les outils de gestions de son compte \\\\u00e0 soi-m\\\\u00eame.</p>\\", \\"id\\": \\"8215330b-201b-4e2d-bb21-8950bc6c7f97\\"}]", "live": true, "path": "0001000400070009", "slug": "moi", "depth": 4, "owner": 1, "title": "Mon compte", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 3, "url_path": "/le-village-des-grands-voisins/digital/compte/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Mon compte", "content_type": 89, "header_image": null, "header_large": false, "header_darken": false, "live_revision": 973, "show_in_menus": true, "posts_per_page": 10, "header_cta_link": null, "header_cta_text": null, "latest_revision": 973, "translation_key": "ecd129b1-af5b-4deb-af2c-84b676dc6968", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-06-29T07:03:36.308Z", "first_published_at": "2024-06-29T06:29:05.639Z", "header_color_class": null, "search_description": "Voici les outils de gestions de son compte à soi-même. […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-29T07:03:36.287Z"}	\N	229	1	89	1	Mon compte
683	2024-06-20 15:36:09.687846+02	{"pk": 142, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"l0jh7\\\\\\">Com\\\\u00e9dien et photographe</p><p data-block-key=\\\\\\"59pfp\\\\\\">06 37 58 45 41 / gayeamadou92@gmail.com</p><p data-block-key=\\\\\\"bbmvk\\\\\\">Souscription pour un livre photo La Joie du march\\\\u00e9 de Fontenay-aux-Roses en cours. Voir spectacles comme contes et po\\\\u00e9sies n\\\\u00e8gres.</p><p data-block-key=\\\\\\"3tips\\\\\\"><a href=\\\\\\"https://www.fnac.com/ia92245/Amadou-Gaye?ref=blog.lesgrandsvoisins.com#ID1774615\\\\\\">Livres Fontenay-aux-Roses P\\\\u00e9tales d'Amour, \\\\u00e9tc.</a><a href=\\\\\\"https://www.amadougaye.fr/?ref=blog.lesgrandsvoisins.com\\\\\\">D\\\\u00e9couvrir</a></p>\\", \\"id\\": \\"9fe6910e-0886-4886-b77b-267b1b1d0baf\\"}]", "date": "2024-06-18T09:57:00Z", "live": true, "path": "0001000400050004", "slug": "amadou-gaye", "depth": 4, "owner": 2, "title": "Amadou Gaye", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/amadou-gaye/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Amadou Gaye", "content_type": 71, "header_image": 101, "header_large": false, "header_darken": false, "live_revision": 676, "show_in_menus": true, "blog_categories": [1], "header_cta_link": "https://www.amadougaye.fr/?ref=blog.lesgrandsvoisins.com", "header_cta_text": "Voir le site et l'appli", "latest_revision": 676, "translation_key": "22dc6400-3a63-411f-b976-56c7b74634fa", "contentpage_tags": [], "entry_categories": [{"pk": 101, "page": 142, "category": 1}], "header_cta_label": "https://www.amadougaye.fr", "header_with_title": false, "last_published_at": "2024-06-20T13:30:11.671Z", "first_published_at": "2024-06-18T10:14:05.421Z", "header_color_class": null, "search_description": "Comédien et photographe\\r\\n\\r\\n06 37 58 