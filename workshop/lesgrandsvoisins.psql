138	Activités	{"pk": 130, "path": "000100040001", "depth": 3, "numchild": 3, "translation_key": "14daf9eb-7841-4026-b935-15df7ff778cf", "locale": 1, "latest_revision": 337, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-01T15:00:05.358Z", "last_published_at": "2024-06-01T15:21:21.299Z", "live_revision": 337, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Activit\\u00e9s", "draft_title": "Activit\\u00e9s", "slug": "activit\\u00e9s", "content_type": 25, "url_path": "/le-village-des-grands-voisins/activit\\u00e9s/", "owner": 1, "seo_title": "", "show_in_menus": true, "search_description": "Voici des \\u00ab avantages inclusifs \\u00bb en tant qu\\u2019adh\\u00e9rent de soutien pour vous et pour tous : Num\\u00e9rique Nous sommes [\\u2026]", "latest_revision_created_at": "2024-06-01T15:21:21.278Z", "alias_of": null, "body": "[{\\"id\\": \\"f197493b-835f-422f-a149-3e225ab5d353\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"az3bj\\\\\\">Voici des \\\\u00ab avantages inclusifs \\\\u00bb en tant qu\\\\u2019adh\\\\u00e9rent de soutien pour vous et pour tous :</p><h2 data-block-key=\\\\\\"6712c\\\\\\">Num\\\\u00e9rique</h2><p data-block-key=\\\\\\"bnscl\\\\\\">Nous sommes redevables \\\\u00e0 tout utilisateur et \\\\u00e0 tout Voisin.</p><p data-block-key=\\\\\\"75v0q\\\\\\">Tout notre p\\\\u00e9rim\\\\u00e8tre est vot\\\\u00e9 en Conseils des Voisins.</p><p data-block-key=\\\\\\"3iluu\\\\\\">Quels sont vos talents et vos besoins ?</p><h2 data-block-key=\\\\\\"egjc4\\\\\\">Arts plastiques</h2><p data-block-key=\\\\\\"enb76\\\\\\">La Galerie Les Arts Voisins aide les artistes et galeries professionnels.</p><p data-block-key=\\\\\\"6bujc\\\\\\">Les Popup Expos encouragent l\\\\u2019utilisation hybrides d\\\\u2019espaces (commerces, h\\\\u00f4pitaux, caf\\\\u00e9s, etc.) aussi en gall\\\\u00e9ries locales.</p><h2 data-block-key=\\\\\\"abh98\\\\\\">Civisme</h2><p data-block-key=\\\\\\"7muqe\\\\\\">ResDigita proposer de renforcer nos ma\\\\u00eetrises num\\\\u00e9riques.</p><p data-block-key=\\\\\\"ci7mv\\\\\\">Le num\\\\u00e9rique cr\\\\u00e9atif, laur\\\\u00e9at du budget participatif Paris 14, propose un partage de moyens et des salles de sociabilit\\\\u00e9 num\\\\u00e9rique pour individus et pour acteurs socio-\\\\u00e9conomiques de toutes les tailles.</p>\\"}]", "header_with_title": false, "header_image": null, "header_color_class": null, "header_large": false, "header_darken": false, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "wagtail_admin_comments": [], "contentpage_tags": []}	2024-06-01 17:11:42.109159+02	1	14daf9eb-7841-4026-b935-15df7ff778cf	25	2024-07-14 10:20:35.959489+02	0002_remove_formpage_page_ptr_delete_formfield_and_more
