474	[{"id": "a80cf434-d0c4-43cf-bce7-24bd49690b3d", "type": "paragraph", "value": "<h2 data-block-key=\\"7jjj0\\">Outils régaliens pour des sites citoyens &amp; un serveur pour tous !</h2><p data-block-key=\\"1q4g4\\">Voici des outils régaliens pour des sites citoyens issu de l'outillage qui utilise l'état pour ses 20.000 domaines .gouv.fr. Vous pouvez créer vos propres sites webs, son vos propres services, pour remplacer certains services Google et Wordpress pour vous-mêmes: un serveur pour tou.te.s et chacun.e !</p>"}, {"id": "0ba756f1-edfc-48ff-91e7-3a2bd67624b4", "type": "paragraph", "value": "<h3 data-block-key=\\"7jjj0\\">Wagtail-Fastoche pour vos chaînes d'édition numériques</h3><p data-block-key=\\"74md3\\">site-exemple : <a href=\\"https://wagtail.village.ngo\\">wagtail.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/wagtail-village\\">github.com/chris2fr/wagtail-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/sites-faciles\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\"bgcv2\\">Django-Fastoche pour vos applications webs</h3><p data-block-key=\\"4pivt\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\"f8qe8\\">Fabrique-Fastoche pour vos systèmes de design numériques</h3><p data-block-key=\\"c8g1s\\">site-exemple : <a href=\\"https://django.village.ngo\\">django.village.ngo</a><br/>dépôt source : <a href=\\"https://github.com/chris2fr/django-village\\">github.com/chris2fr/django-village</a><br/>bifurqué depuis <a href=\\"https://github.com/nurmerique-gouv/django-dsfr\\">github.com/nurmerique-gouv/django-dsfr</a></p>"}]	\N	\N	\N	f	\N	f	f	\N
