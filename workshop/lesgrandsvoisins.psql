1988	2024-06-20 16:21:21.746119+02	{"pk": 528, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"2pytq\\\\\\">Merci de voter pour les 21e et 22e Conseils des Voisins !</p><p data-block-key=\\\\\\"55sdc\\\\\\">Dans notre association, nous servons les tout statut socio-\\\\u00e9conomique individuel ou collectif -- les artistes, les artisans, les associations, les entreprises, les salari\\\\u00e9s, les demandeurs d'emploi, les institutions, les services sociaux, ... -- mais ce sont les individus r\\\\u00e9partis dans trois coll\\\\u00e8ges qui d\\\\u00e9cident.</p><p data-block-key=\\\\\\"7tb7a\\\\\\">Lors de nos 21e et 22e Conseils des Voisins, nous avons propos\\\\u00e9 des d\\\\u00e9cisions \\\\u00e0 prendre. Dans ce formulaire, vous avez la possibilit\\\\u00e9 de voter pour les propositions.</p>\\", \\"id\\": \\"48955129-b0a0-4ee3-ba3a-b9b51c72a2c4\\"}]", "live": true, "path": "00010004000200040001", "slug": "votes-21", "depth": 5, "intro": "", "owner": 1, "title": "Votes pour les 21e Conseil des Voisins", "locale": 1, "locked": false, "expired": false, "subject": "Vote des 21e et 22e Conseils des Voisins", "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/association/conseils-des-voisins/votes-21/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "to_address": "chris@village.ngo", "draft_title": "Votes pour les 21e Conseil des Voisins", "form_fields": [{"pk": 28, "page": 528, "label": "Prénom", "choices": "", "required": true, "help_text": "", "clean_name": "prenom", "field_type": "singleline", "sort_order": 0, "default_value": ""}, {"pk": 29, "page": 528, "label": "Nom de famille", "choices": "", "required": true, "help_text": "", "clean_name": "nom", "field_type": "singleline", "sort_order": 1, "default_value": ""}, {"pk": 30, "page": 528, "label": "Email", "choices": "", "required": true, "help_text": "", "clean_name": "email", "field_type": "email", "sort_order": 2, "default_value": ""}, {"pk": null, "page": 528, "label": "21-Admin-1 : Pré-approuver Comptes", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Les comptes simplifiés sont présentés avec les informations suivantes: recettes de 1200 euros et dépenses de 2000 euros. Les comptes détaillés seront présentés prochainement. Validez-vous ces données pour les comptes à venir ?", "clean_name": "administratif_pre_approuver_comptes", "field_type": "radio", "sort_order": 3, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 528, "label": "21-Admin-2 : Salaire 70% SMIC Chris MANN", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "En ligne avec la décision de l'AG de lancement des Grands Voisins en novembre 2022, validez-vous le principe toujours de rémunérer Chris MANN  70% du SMIC à partir du moment où l'association peut payer le salaire et permettez une modification statutaire ?", "clean_name": "21_admin_2_salaire_70_smic_chris_mann", "field_type": "radio", "sort_order": 4, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 528, "label": "21-Admin-3 : Présentation de comptes et de budget", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "L'association présentera lors d'un prochain Conseil les Comptes et le Budget de manière formelles", "clean_name": "21_admin_3_presentation_de_comptes_et_de_budget", "field_type": "radio", "sort_order": 5, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 528, "label": "21-Admin-4 : Demandes de subventions à la Ville de Paris", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Le BPP 2022 est investi dans l'atelier de la Ressourcerie créative. Validez-vous les 4 demandes de subventionnement de nov. 2023 et les quatre demandes de subventionnement de mai 2024 à la Ville de Paris ?", "clean_name": "21_admin_4_demandes_de_subventions_a_la_ville_de_paris", "field_type": "radio", "sort_order": 6, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 528, "label": "21-ADMIN-5 : Paiement stagiaire", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous 1215 euros nets sous réserve de subvention de fonctionnement hors projets d'au moins le double (2430 euros) pour un stage à temps plien du 21 mai au 20 juillet 2024 (éventuellement adjustable pro-rata) ?.", "clean_name": "21_admin_5_paiement_stagiaire", "field_type": "radio", "sort_order": 7, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}, {"pk": null, "page": 528, "label": "21-ART-1 : Responsable arts plastiques Marine MESSIER", "choices": "Oui\\r\\nNon\\r\\nAbstention\\r\\nVote déjà enregistré ou vote à venir plus tard", "required": true, "help_text": "Validez-vous Marine MESSIER du Bureau du créateur comme responsable des activités artistiques ? (Démission au début du 22e Conseil)", "clean_name": "21_art_1_responsable_arts_plastiques_marine_messier", "field_type": "radio", "sort_order": 8, "default_value": "Vote déjà enregistré ou vote à venir plus tard"}], "content_type": 91, "from_address": "chris@village.ngo", "header_image": null, "header_large": false, "header_darken": false, "live_revision": 734, "show_in_menus": true, "thank_you_text": "<p data-block-key=\\"fd7qo\\">Merci, nous aurions pris pris compte de vos votes !</p>", "header_cta_link": "https://www.village.ngo/fr/association/conseils-des-voisins/votes-21/", "header_cta_text": "Faites vos votes", "latest_revision": 734, "translation_key": "1cab700e-e8bc-4319-8ddb-5c2001a41470", "contentpage_tags": [], "header_cta_label": "pour le 21e Co