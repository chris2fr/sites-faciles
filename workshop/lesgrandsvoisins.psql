153	[{"id": "8b9f5818-815f-4114-82d8-035a05957149", "type": "paragraph", "value": "<p data-block-key=\\"iugnj\\">Développeur front depuis 5 ans spécialisé sur Angular et Ionic. Services fournis:</p><ul><li data-block-key=\\"fjqo1\\">Développement d’applications mobiles</li><li data-block-key=\\"emsca\\">Développement web</li></ul><p data-block-key=\\"dukru\\"><a href=\\"https://www.linkedin.com/in/morad-elhamdouni/?ref=blog.lesgrandsvoisins.com\\">https://www.linkedin.com/in/morad-elhamdouni/</a></p>"}]	\N	linkedin.com	https://www.linkedin.com/in/morad-elhamdouni/?ref=blog.lesgrandsvoisins.com	t	113	f	f	Retrouvez le Linkedin de Morad El HAMDOUNI
131	[{"id": "e7b35c91-a541-448a-bdca-fae320153771", "type": "callout", "value": {"text": "Venez co-constuire un voisinage animé, chic, vivant, partageant, équipé, ressourçant, respectueux, mondial, multiculturel, prospère, et de proximité.", "title": "", "heading_tag": "h3"}}, {"id": "b314e733-eaaf-4100-886f-56834b3ab1b5", "type": "paragraph", "value": "<p data-block-key=\\"tbuca\\">Nous sommes une association d'intérêt général agissant de manière contrôlée en subsidiarité ouverte pour toute organisation et tout individu qui en fait la décision pour soi-même principalement en ces trois domaines de Civisme, d'Arts plastiques et de Numérique selon notre déclaration de mission.</p>"}]	\N	\N	\N	f	\N	f	f	\N
