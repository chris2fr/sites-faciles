ent\\": null}, \\"id\\": \\"dd9fc2b9-240b-4997-8796-a0dacef0582a\\"}]}, \\"id\\": \\"d388ac8a-07c7-419a-af4b-5c4a083ce6bf\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Mon compte\\", \\"description\\": \\"Voici les outils de gestions de son compte \\\\u00e0 soi-m\\\\u00eame.\\", \\"image\\": 97, \\"url\\": \\"https://www.village.ong/fr/apps/moi/\\", \\"document\\": null}, \\"id\\": \\"37a95f17-372b-448c-ba1c-12af6ab8ac70\\"}]}, \\"id\\": \\"c022176e-1ed6-4df0-9006-4cb87fee68cb\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"B\\\\u00eata et alpha\\", \\"description\\": \\"Ce sont des outils en essai et en \\\\u00e9mergence.\\", \\"image\\": 87, \\"url\\": \\"https://www.village.ong/fr/apps/beta/\\", \\"document\\": null}, \\"id\\": \\"f99fb22b-23eb-4de9-8065-4e071ed57fcb\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Maintenir et administrer\\", \\"description\\": \\"Ce sont des acc\\\\u00e8s pour les administrateurs de contenu et les administrateurs techniques.\\", \\"image\\": 77, \\"url\\": \\"https://www.village.ong/fr/apps/admin/\\", \\"document\\": null}, \\"id\\": \\"3a59f10a-d2a6-4e1b-be2d-578a67d74847\\"}]}, \\"id\\": \\"6d29552f-6286-49e2-8f83-a9fb20a411de\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"org5t\\\\\\">Voici des points de d\\\\u00e9part pour les services num\\\\u00e9rique des Grands Voisins.</h3><p data-block-key=\\\\\\"65u2u\\\\\\"><a href=\\\\\\"https://homepage-dashboard.resdigita.com\\\\\\">Homepage-Dashboard</a> : le tableau de bord avec nos applications principales</p><p data-block-key=\\\\\\"5tl3t\\\\\\"><a href=\\\\\\"https://guichet.resdigita.com\\\\\\">Guichet (Login)</a> : G\\\\u00e9rer votre compte (guichet est un logiciel d\\\\u00e9velopp\\\\u00e9 par Les Grands Voisins)</p><p data-block-key=\\\\\\"fph53\\\\\\"><a href=\\\\\\"https://guichet.resdigita.com/user/new\\\\\\">Guichet (Inscription)</a> : Cr\\\\u00e9er votre compte</p><p data-block-key=\\\\\\"7a6jj\\\\\\"><a href=\\\\\\"https://www.lesgrandsvoisins.fr/numerique/\\\\\\">LesGrandsVoisins.fr/numerique</a> : La description de nos activit\\\\u00e9s num\\\\u00e9riques</p><p data-block-key=\\\\\\"7j34f\\\\\\"><a href=\\\\\\"https://quartz.resdigita.com\\\\\\">Quartz</a> : Consulter notre documentation sur les outils num\\\\u00e9riques (par exemple, configurer votre courriel)</p><p data-block-key=\\\\\\"4ec4a\\\\\\"><a href=\\\\\\"https://uptime-kuma.resdigita.com/status/gv\\\\\\">Uptime-Kuma</a> : V\\\\u00e9rifier l'\\\\u00e9tat de nos services</p><p data-block-key=\\\\\\"5c9le\\\\\\">Voici des applications avec un login automatique :</p><p data-block-key=\\\\\\"bsg2b\\\\\\"><a href=\\\\\\"https://hedgedoc.resdigita.com\\\\\\">Hedgedoc</a> : Edition en temps r\\\\u00e9el de documents partag\\\\u00e9s</p><p data-block-key=\\\\\\"4na3f\\\\\\"><a href=\\\\\\"https://vikunja.resdigita.com\\\\\\">Vikunja</a> : Centraliser des informations sur des tous doux lisses</p><h3 data-block-key=\\\\\\"2jajl\\\\\\">Voici <a href=\\\\\\"https://vaultwarden.resdigita.com\\\\\\">Vaultwarden</a> pour vos mots de passe :</h3><p data-block-key=\\\\\\"8ddmd\\\\\\">Le login et le mot de passe sont ind\\\\u00e9pendants et s\\\\u00e9curis\\\\u00e9s comme nous le pouvons.</p><p data-block-key=\\\\\\"eelmc\\\\\\">Ce dispositif est compatible avec tous <a href=\\\\\\"https://bitwarden.com/fr-fr/download/\\\\\\">les clients BitWarden</a> (t\\\\u00e9l\\\\u00e9d\\\\u00e9chagement pour ios, Android, Windows, Linux et Apple). Mettez \\\\u00ab self-hosted \\\\u00bb ou \\\\u00ab auto-h\\\\u00e9berg\\\\u00e9 \\\\u00bb avec l'adresse https://vaultwarden.resdigita.com.</p><p data-block-key=\\\\\\"duea9\\\\\\"><a href=\\\\\\"https://vaultwarden.resdigita.com\\\\\\">https://vaultwarden.resdigita.com</a></p><h3 data-block-key=\\\\\\"2od0g\\\\\\">Voici des services en lien avec le courriel</h3><p data-block-key=\\\\\\"1lkv5\\\\\\"><a href=\\\\\\"https://mail.lesgrandsvoisins.com\\\\\\">Roundcube Webmail</a> : Acc\\\\u00e9der \\\\u00e0 vos mels par le web</p><p data-block-key=\\\\\\"851rt\\\\\\">Le courriel est cr\\\\u00e9\\\\u00e9 dans <a href=\\\\\\"https://guichet.resdigita.com/user\\\\\\">Guichet dans la partie \\\\u00ab modifier mon profil \\\\u00bb</a>. Chaque courriel que vous ajoutez sera un login distinct avec le m\\\\u00eame mot de passe que vous utilisez pour Guichet.</p><p data-block-key=\\\\\\"5cc41\\\\\\">La <a href=\\\\\\"https://quartz.resdigita.com/config/services/email\\\\\\">documentation dans Quartz</a> peut vous aider \\\\u00e0 la configuration de votre courriel (sur smartphone par exemple).</p><p data-block-key=\\\\\\"boude\\\\\\">La <a href=\\\\\\"https://guichet.resdigita.com/user/new\\\\\\">cr\\\\u00e9ation de compte sur Guichet</a> cr\\\\u00e9e automatiquement un courriel correspondant.</p><p data-block-key=\\\\\\"5n1sj\\\\\\"><a href=\\\\\\"https://list.lesgrandsvoisins.com\\\\\\">ListMonk</a> : Envois de Newsletters et gestions d'abonnements</p><h3 data-block-key=\\\\\\"2758r\\\\\\">Voici des dispositifs d'administration web.</h3><p data-block-key=\\\\\\"90kbh\\\\\\"><a href=\\\\\\"https://wagtail.resdigita.com/admin/\\\\\\">Wagtail.Resdigita.Com</a> : Editer nos sites webs principaux</p><p data-block-key=\\\\\\"dthba\\\\\\"><a href=\\\\\\"https://blog.lesgrandsvoisins.com/ghost/\\\\\\">blog.lesgrandsvoisins.com/ghost</a> : Editer notre blog</p><p data-block-key=\\\\\\"5v6g\\\\\\"><a href=\\\\\\"https://list.lesgrandsvoisins.com/\\\\\\">List Monk list</a> : Envoyer des newsletters</p><p data-block-key=\\\\\\"fvqpc\\\\\\"><a href=\\\\\\"https://uptime-kuma.resdigita.com/\\\\\\">Uptime Kuma admin</a> : Adminsitrer le tableau des statuts des services</p>\\", \\"id\\": \\"53eb7654-f566-4b57-93df-6848cbf70b47\\"}]", "live": false, "path": "000100050008", "slug": "apps", "depth": 3, "owner": 1, "title": "Apps", "locale": 2, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/villagengo/apps/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Apps", "content_type": 25, "header_image": 49, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "a4dff79f-8e13-46e5-8185-c22ae76fb840", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "Voici les outils numériques disponibles pour toutes et pour tous. […]", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": "2024-07-14T09:13:06.081Z"}	\N	480	\N	25	1	Apps
