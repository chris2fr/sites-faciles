\\\u00e9ative.</p>\\", \\"id\\": \\"157bc5f0-2339-40bc-8b2e-84fd3994233b\\"}]}, \\"id\\": \\"c7afacc4-b42c-44ba-ba25-d43a8487be6d\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"key.gv.coop - Cr\\\\u00e9ation et gestion de compte\\", \\"description\\": \\"Cr\\\\u00e9er votre compte ici (lien en bas du formulaire) et g\\\\u00e9rer vos informations sur key.gv.coop.\\", \\"image\\": null, \\"url\\": \\"https://key.gv.coop/realms/master/protocol/openid-connect/auth?client_id=account-console&redirect_uri=https%3A%2F%2Fkey.gv.coop%2Frealms%2Fmaster%2Faccount%2F\\", \\"document\\": null}, \\"id\\": \\"b8783dbe-054e-47d9-b0e8-761d9c3668db\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"hedgedoc.gv.coop - Editer ensemble du Markdown\\", \\"description\\": \\"Hedgedoc permet d'\\\\u00e9diter en temps r\\\\u00e9el des documents sous format markdown.\\", \\"image\\": null, \\"url\\": \\"https://hedgedoc.gv.coop/auth/oauth2\\", \\"document\\": null}, \\"id\\": \\"a564abc2-0141-47ea-996f-88cc060a223f\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"vikunja.gv.coop - Coordonner des t\\\\u00e2ches\\", \\"description\\": \\"Vikunja permet de mettre toute l'information et tous les documents dans un lieu pour des t\\\\u00e2ches en cours.\\", \\"image\\": null, \\"url\\": \\"https://vikunja.gv.coop/auth/openid/\\", \\"document\\": null}, \\"id\\": \\"730ebb50-b8ac-4bcc-ba2e-9cb0d9b0ae71\\"}]}, \\"id\\": \\"6baeb509-bdc0-43e5-83e1-d1dc92c25e27\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"link.gv.coop - Enregistrer des pages internet\\", \\"description\\": \\"Linkward