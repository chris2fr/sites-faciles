esdigita.com/\\\\\\">Uptime Kuma admin</a> : Adminsitrer le tableau des statuts des services</p>\\", \\"id\\": \\"53eb7654-f566-4b57-93df-6848cbf70b47\\"}]", "live": true, "path": "00010004000A", "slug": "apps", "depth": 3, "owner": 1, "title": "Apps", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/apps/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Outils numériques", "content_type": 25, "header_image": 49, "header_large": false, "header_darken": false, "live_revision": 1599, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 1603, "translation_key": "a4dff79f-8e13-46e5-8185-c22ae76fb840", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-07-14T09:09:32.446Z", "first_published_at": "2024-06-29T06:26:37.267Z", "header_color_class": null, "search_description": "Voici les outils numériques disponibles pour toutes et pour tous. […]", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-07-14T09:09:32.422Z"}	\N	436	1	25	1	Apps
