720	2024-06-20 16:04:04.026299+02	{"pk": 157, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"a2gow\\\\\\"><a href=\\\\\\"https://www.inolib.com/?ref=blog.lesgrandsvoisins.com\\\\\\"><b>Inolib</b></a> est une agence sp\\\\u00e9cialis\\\\u00e9 en <b>accessibilit\\\\u00e9 num\\\\u00e9rique</b>. Notre vocation est les entreprises et les organisations dans la <b>cr\\\\u00e9ation d'outils et de supports digitaux accessibles \\\\u00e0 tous</b>, conformant aux normes et \\\\u00e0 la l\\\\u00e9gislation en vigueur. Gr\\\\u00e2ce \\\\u00e0 notre expertise ax\\\\u00e9e sur <b>l'innovaition et l'accessibilit\\\\u00e9</b>, nous offrons des solutions personalis\\\\u00e9es. Ces solutions performantes r\\\\u00e9pondent \\\\u00e0 vois besoins et propulsent votre entreprise vers un <b>futur num\\\\u00e9rique inclusif</b>.</p>\\", \\"id\\": \\"7dc32434-23b9-4c57-83ca-1b7144eb79ba\\"}]", "date": "2024-06-18T13:58:00Z", "live": true, "path": "000100040005000J", "slug": "inolib", "depth": 4, "owner": 2, "title": "Inolib", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/inolib/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Inolib", "content_type": 71, "header_image": 117, "header_large": false, "header_darken": true, "live_revision": 613, "show_in_menus": true, "blog_categories": [2], "header_cta_link": "https://www.inolib.com/?ref=blog.lesgrandsvoisins.com", "header_cta_text": "Voir le site et l'appli", "latest_revision": 719, "translation_key": "b33ba26c-fff4-4026-bd6d-99a832e24cc4", "contentpage_tags": [], "entry_categories": [{"pk": 86, "page": 157, "category": 2}], "header_cta_label": "inolib.com", "header_with_title": false, "last_published_at": "2024-06-19T14:53:11.657Z", "first_published_at": "2024-06-18T14:00:03.667Z", "header_color_class": null, "search_descriptio