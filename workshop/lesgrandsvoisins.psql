1989	2024-06-20 16:22:41.980662+02	{"pk": 528, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"2pytq\\\\\\">Merci de voter pour le 22e Conseils des Voisins !</p><p data-block-key=\\\\\\"55sdc\\\\\\">Dans notre association, nous servons les tout statut socio-\\\\u00e9conomique individuel ou collectif -- les artistes, les artisans, les associations, les entreprises, les salari\\\\u00e9s, les demandeurs d'emploi, les institutions, les services sociaux, ... -- mais ce sont les individus r\\\\u00e9partis dans trois coll\\\\u00e8ges qui d\\\\u00e9cident.</p><p data-block-key=\\\\\\"7tb7a\\\\\\">Lors de nos 22e Conseils des Voisins, nous avons propos\\\\u00e9 des d\\\\u00e9cisions \\\\u00e0 prendre. Dans ce formulaire, vous avez la possibilit\\\\u00e9 de voter pour les propositions.</p>\\", \\"id\\": \\"48955129-b0a0-4ee3-ba3a-b9b51c72a2c4\\"}]", "live": false, "path": "00010004000200040002", "slug": "votes-22", "depth": 5, "intro": "", "owner": 1, "title": "Votes pour les 22e Conseil des Voisins", "locale": 1, "locked": false, "expired": false, "subject": "Vote des 21e et 22e Conseils des Voisins", "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/association/conseils-des-voisins/votes-22/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "to_address": "chris@village.ngo", "draft_title": "Votes pour les 22e Conseil des Voisins", "form_fields": [{"pk": 28, "page": 528, "label": "Prénom", "choices": "", "required": true, "help_text": "", "clean_name": "prenom", "field_type": "singleline", "sort_order": 0, "default_value": ""}, {"pk": 29, "page": 528, "label": "Nom de famille", "choices": "", "required": true, "help_text": "", "clean_name": "nom", "field_type": "singleline", "sort_order": 1, "default_value": ""}, {"pk": 30, "page": 528, "label": "Email", "choices": "", "required": true, "help_text": "", "clean_name": "email", "field_type": "email", "sort_order": 2, "defa