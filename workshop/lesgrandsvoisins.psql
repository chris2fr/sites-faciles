624	2024-06-19 16:54:53.937312+02	{"pk": 151, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"wcn51\\\\\\">Le Chiffon est un journal papier, \\\\u00e0 l\\\\u2019ancienne, que tu peux choper en manif\\\\u2019, dans plusieurs kiosques et dans des lieux amis.<br/>Mais pour rendre quelques reportages, enqu\\\\u00eates ou entretiens plus accessibles, nous publions aussi en ligne.<br/></p><p data-block-key=\\\\\\"c0b0l\\\\\\">Tu trouveras sur ce site une s\\\\u00e9lection de nos derniers articles, notre podcast diffus\\\\u00e9 sur Radio Libertaire et notre adresse mail pour nous contacter.<br/></p><p data-block-key=\\\\\\"9aidh\\\\\\">Enfin, seuls tes dons nous permettront de poursuivre notre travail pour une information locale, critique et ind\\\\u00e9pendante tranquillement. C\\\\u2019est pourquoi nous t\\\\u2019invitons \\\\u00e0 nous laisser un don de ton choix via cette cagnotte :<br/></p><p data-block-key=\\\\\\"htj9\\\\\\"><a href=\\\\\\"https://fr.tipeee.com/le-chiffon?ref=blog.lesgrandsvoisins.com\\\\\\">Nous soutenir sur Tipeee</a></p>\\", \\"id\\": \\"0e08f9e4-512f-4f6d-8be3-934077d053fe\\"}]", "date": "2024-06-18T13:52:00Z", "live": true, "path": "000100040005000D", "slug": "le-chiffon", "depth": 4, "owner": 2, "title": "Le Chiffon", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/le-chiffon/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Le Chiffon", "content_type": 71, "header_image": 111, "header_large": false, "header_darken": true, "live_revision": 502, "show_in_menus": true, "blog_categories": [1], "header_cta_link": null, "header_cta_text": null, "latest_revision": 502, "translation_key": "46bc322a-4282-4cf5-90ce-d963645517eb", "contentpage_tags": [], "entry_categories": [], "header_cta_label": null, "header_with_title": true, "last_published_at": "2024-06-18T13:53:47.696Z", "first_published_at": "2024-06-18T13:53:47.696Z", "header_color_class": null, "search_description": "Le Chiffon est un journal papier, à l’ancienne, que tu peux choper en manif’, dans plusieurs kiosques et dans des lieux amis.\\r\\nMais pour rendre quelques reportages, enquêtes ou entretiens plus accessibles, nous publions aussi en ligne.\\r\\n\\r\\nTu trouveras sur ce site une sélection de nos derniers articles, notre podcast diffusé sur Radio Libertaire et notre adresse mail pour nous contacter.\\r\\n\\r\\nEnfin, seuls tes dons nous permettront de poursuivre notre travail pour une information locale, critique et indépendante tranquillement. C’est pourquoi nous t’invitons à nous laisser un don de ton choix via cette cagnotte :\\r\\n\\r\\nNous soutenir sur Tipeee", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-18T13:53:47.674Z"}	\N	151	2	71	1	Le Chiffon
