1606	2024-06-29 09:17:42.913893+02	{"pk": 436, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"ez6b5\\\\\\">Voici les outils num\\\\u00e9riques disponibles pour toutes et pour tous.</p>\\", \\"id\\": \\"256f3482-0e12-47c2-b60c-b084d329b70a\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Bureautique et cr\\\\u00e9ation\\", \\"description\\": \\"Ce sont les outils qui nous permettent de produire des choses individuellement.\\", \\"image\\": 48, \\"url\\": \\"https://www.village.ngo/fr/digital/office/\\", \\"document\\": null}, \\"id\\": \\"dbe494aa-ae2f-4069-9e04-727ee0132fba\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Collaborer\\", \\"description\\": \\"Ce sont les outils qui nous permettent de partager les choses et faire ensemble.\\", \\"image\\": 49, \\"url\\": \\"https://www.village.ngo/fr/digital/collaboration/\\", \\"document\\": null}, \\"id\\": \\"56fbff8b-f0bc-4f99-9e4f-ac8ae8722134\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Communiquer\\", \\"description\\": \\"Voici des outils pour \\\\u00e9changer des messages.\\", \\"image\\": 96, \\"url\\": \\"https://www.village.ngo/fr/digital/communication/\\", \\"document\\": null}, \\"id\\": \\"d4794c5f-c90b-4338-9cb6-c2cb76d61981\\"}]}, \\"id\\": \\"c039ea5a-88e4-4e44-be4c-1b1f91709af0\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Mon compte\\", \\"description\\": \\"Voici les outils de gestions de son compte \\\\u00e0 soi-m\\\\u00eame.\\", \\"image\\": 97, \\"url\\": \\"https://www.village.ngo/fr/digital/moi/\\", \\"document\\": null}, \\"id\\": \\"37a95f17-372b-448c-ba1c-12af6ab8ac70\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"S'informer\\", \\"description\\": \\"Ce sont les outils pour s'informer et pour informer les autres dont les sites webs publics des Grands Voisins.\\", \\"image\\": 85, \\"url\\": \\"https://www.village.ngo/fr/digital/inform/\\", \\"document\\": null}, \\"id\\": \\"944f9dc0-f86b-4b74-9763-80422a27a293\\"}]}, \\"id\\": \\"c022176e-1ed6-4df0-9006-4cb87fee68cb\\"}, {\\"type\\": \\"multicolumns\\", \\"value\\": {\\"bg_image\\": null, \\"bg_color_class\\": \\"\\", \\"bg_color\\": \\"\\", \\"title\\": \\"\\", \\"heading_tag\\": \\"h2\\", \\"columns\\": [{\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"B\\\\u00eata et alpha\\", \\"description\\": \\"Ce sont des outils en essai et en \\\\u00e9mergence.\\", \\"image\\": 87, \\"url\\": \\"https://www.village.ngo/fr/digital/beta/\\", \\"document\\": null}, \\"id\\": \\"f99fb22b-23eb-4de9-8065-4e071ed57fcb\\"}, {\\"type\\": \\"card\\", \\"value\\": {\\"title\\": \\"Maintenir et administrer\\", \\"description\\": \\"Ce sont des acc\\\\u00e8s pour les administrateurs de contenu et les administrateurs techniques.\\", \\"image\\": 77, \\"url\\": \\"https://www.village.ngo/fr/digital/admin/\\", \\"document\\": null}, \\"id\\": \\"3a59f10a-d2a6-4e1b-be2d-578a67d74847\\"}]}, \\"id\\": \\"6d29552f-6286-49e2-8f83-a9fb20a411de\\"}]", "live": true, "path": "000100040007", "slug": "digital", "depth": 3, "owner": 1, "title": "Outils numériques", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 8, "url_path": "/le-village-des-grands-voisins/digital/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Outils numériques", "content_type": 25, "header_image": 49, "header_large": false, "header_darken": false, "live_revision": 981, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 981, "translation_key": "9d8b185e-8fcc-