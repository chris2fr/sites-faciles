794	2024-06-21 14:29:18.252346+02	{"pk": 150, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"abmdo\\\\\\">Journaliste et r\\\\u00e9dactrice, je tiens la plume depuis plus de 20 ans sur des sujets tr\\\\u00e8s vari\\\\u00e9s allant du handicap \\\\u00e0 la bande dessin\\\\u00e9e. Je me tiens \\\\u00e0 votre disposition sur les sujets que vous voudriez me confier. (<a href=\\\\\\"https://www.linkedin.com/in/caroline-lhomme?ref=blog.lesgrandsvoisins.com\\\\\\">LinkedIn</a>) (<a href=\\\\\\"https://www.hugopublishing.fr/produits/bienvenue-dans-mon-demi-monde-journal-pas-triste-dune-survivante/?ref=blog.lesgrandsvoisins.com\\\\\\">Livre</a>)</p><p data-block-key=\\\\\\"6qr1p\\\\\\"><a href=\\\\\\"https://www.linkedin.com/in/caroline-lhomme?ref=blog.lesgrandsvoisins.com\\\\\\">Continuer la lecture</a></p>\\", \\"id\\": \\"6d52a640-c8a4-45ee-9212-9b8d1068a1ce\\"}]", "date": "2024-06-18T13:51:00Z", "live": true, "path": "000100040005000C", "slug": "caroline-lhomme", "depth": 4, "owner": 2, "title": "Caroline Lhomme", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/caroline-lhomme/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Caroline Lhomme", "content_type": 71, "header_image": 110, "header_large": false, "header_darken": true, "live_revision": 707, "show_in_menus": true, "blog_categories": [1], "header_cta_link": "https://www.linkedin.com/in/caroline-lhomme/?ref=blog.lesgrandsvoisins.com", "header_cta_text": "Allez visiter de le linkedin de Caroline Lhomme", "latest_revision": 707, "translation_key": "76597391-4fd8-40e9-9fec-86e140b3a084", "contentpage_tags": [], "entry_categories": [{"pk": 93, "page": 150, "category": 1}], "header_cta_label": "linkedin.com", "header_with_title": false, "last_published_at": "2024-06-20T13:56:11.588Z", "first_published_at": 