724	2024-06-20 16:06:14.515985+02	{"pk": 159, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"7gxxq\\\\\\">Autrice Compositrice</p><p data-block-key=\\\\\\"3tj4c\\\\\\">Ada aimerait proposer un groupe de soutien culturel aux jeunes m\\\\u00e8res et p\\\\u00e8res. Un titre provisoire pour ce groupe est \\\\\\"La deuxi\\\\u00e8me naissance\\\\\\". La premi\\\\u00e8re naissance est sa propre naissance. La deuxi\\\\u00e8me naissance est celle de vos enfants, votre premier enfant. Pendant cette p\\\\u00e9riode, il y a une p\\\\u00e9riode de deuil \\\\u00e0 aborder avant la deuxi\\\\u00e8me naissance, et une reconstruction apr\\\\u00e8s. N'h\\\\u00e9sitez pas \\\\u00e0 contacter Ada pour plus d'informations.<br/></p>\\", \\"id\\": \\"b65247da-92d3-4c4c-8b25-25e3f61d5ac3\\"}]", "date": "2024-06-18T14:01:00Z", "live": true, "path": "000100040005000L", "slug": "ada-matus", "depth": 4, "owner": 2, "title": "Ada Matus", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/le-village-des-grands-voisins/annuaire/ada-matus/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Ada Matus", "content_type": 71, "header_image": 119, "header_large": false, "header_darken": true, "live_revision": 609, "show_in_menus": true, "blog_categories": [3], "header_cta_link": null, "header_cta_text": null, "latest_revision": 609, "translation_key": "6b1c5188-fbf6-48a3-b272-9f4fe066abce", "contentpage_tags": [], "entry_categories": [{"pk": 84, "page": 159, "category": 3}], "header_cta_label": null, "header_with_title": false, "last_published_at": "2024-06-19T14:52:28.914Z", "first_published_at": "2024-06-18T14:02:26.491Z", "header_color_class": null, "search_description": "Autrice Compositrice\\r\\n\\r\\nAda aimerait proposer un groupe de soutien culturel aux jeunes mères et pères. Un titre provisoire pour ce groupe est \\"La deuxième naissance\\". La première naissance est sa propre naissance. La deuxième naissance est celle de vos enfants, votre premier enfant. Pendant cette période, il y a une période de deuil à aborder avant la deuxième naissance, et une reconstruction après. N'hésitez pas à contacter Ada pour plus d'informations.\\r\\nDécouvrir", "wagtail_admin_comments": [], "has_unpublished_changes": false, "latest_revision_created_at": "2024-06-19T14:52:28.890Z"}	\N	159	2	71	1	Ada Matus
