496	2024-06-18 15:49:47.359037+02	{"pk": 148, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"sox17\\\\\\">DES LIEUX \\\\u201cBREASTFEEDING FRIENDLY\\\\u201d \\\\u00c0 PORT\\\\u00c9E DE MAIN<br/>Coffee shops, salons de th\\\\u00e9, \\\\u00e9tablissements de petites restaurations, lieux alternatifs,\\\\u2026 affichant une politique explicitement favorable \\\\u00e0 l\\\\u2019allaitement pourront \\\\u00eatre facilement g\\\\u00e9olocalisables et identifiables.</p><p data-block-key=\\\\\\"dgcmo\\\\\\"><a href=\\\\\\"https://breastfreedom.com/?ref=blog.lesgrandsvoisins.com\\\\\\">Breastfreedom.com</a></p>\\", \\"id\\": \\"41e335ce-52fa-476e-a4ee-fee44c20c750\\"}]", "date": "2024-06-18T13:48:00Z", "live": false, "path": "00010002000B0004000A", "slug": "breast-freedom", "depth": 5, "owner": 2, "title": "Breast Freedom", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/le-village-des-grands-voisins/les-voisins/breast-freedom/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "entry_tags": [], "go_live_at": null, "draft_title": "Breast Freedom", "content_type": 71, "header_image": 108, "header_large": false, "header_darken": true, "live_revision": null, "show_in_menus": true, "blog_categories": [], "header_cta_link": null, "header_cta_text": null, "latest_revision": 495, "translation_key": "83a98f28-f386-41fd-841d-1246216cb019", "contentpage_tags": [], "entry_categories": [], "header_cta_label": null, "header_with_title": true, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "DES LIEUX “BREASTFEEDING FRIENDLY” À PORTÉE DE MAIN\\r\\nCoffee shops, salons de thé, établissements de petites restaurations, lieux alternatifs,… affichant une politique explicitement favorable à l’allaitement pourront être facilement géolocalisables et identifiables.\\r\\n\\r\\nBreastfreedom.com", "wagtail_admin_comments