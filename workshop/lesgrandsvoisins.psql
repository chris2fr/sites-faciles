249	[{"id": "ce73b95b-407e-4b12-88f7-6f4945d11d81", "type": "paragraph", "value": "<p data-block-key=\\"uqnwb\\">Nous sommes une association d'intérêt général inspiré de notre mission de 2017</p><p data-block-key=\\"endph\\">pour construire une voisinage complémentaire aux voisinages existants</p><p data-block-key=\\"9qmsj\\">où vous trouverez dans notre village des acteurs socio-économiques individuels et collectifs de tous types</p><p data-block-key=\\"9dh83\\">-- artisans, artistes, associations, demandeurs d'emploi, entreprises, étudiants, indépendants, institutions publiques, mineurs, personnes marginalisées, rentiers, retraités, salariés, sans papiers, etc. --</p><p data-block-key=\\"5dcju\\">gouvernée en fonctionnement coopératif où les votes sont attribués aux individus</p><p data-block-key=\\"c0ohm\\">et où nous nous concentrons pour aujourd'hui dans trois domaines : Civisme, Arts plastiques et numérique.</p>"}]	\N	\N	\N	t	5	f	f	\N
