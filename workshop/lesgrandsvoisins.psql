348	2024-06-03 09:31:17.310896+02	{"pk": 48, "body": "[{\\"type\\": \\"imageandtext\\", \\"value\\": {\\"image\\": 62, \\"image_side\\": \\"right\\", \\"image_ratio\\": \\"6\\", \\"text\\": \\"<p data-block-key=\\\\\\"zqptc\\\\\\">Sur la base de l'application gestionnaire de contenu CMS et blog sous technologie Wagtail <a href=\\\\\\"https://github.com/numerique-gouv/sites-faciles\\\\\\">sites-facile de la DINUM, France</a>, elle-m\\\\u00eame \\\\u00e0 base de l'application de mise en page de site dynamique Django <a href=\\\\\\"https://github.com/numerique-gouv/django-dsfr\\\\\\">django-dsfr</a>, elle m\\\\u00eame bas\\\\u00e9 sur le <a href=\\\\\\"https://github.com/GouvernementFR/dsfr/\\\\\\">Design Syst\\\\u00e8me de l'Etat ou DSFR du gouvernement fran\\\\u00e7ais</a>, cette application gestionnaire de contenu dit CMS et blog <a href=\\\\\\"https://www.village.ngo/\\\\\\">VILLAGE</a> propose de capitaliser sur le travail de fond pour le traitement d'information et de la communication en rendant les composants g\\\\u00e9n\\\\u00e9riques.</p>\\", \\"link\\": {\\"page\\": null, \\"external_url\\": \\"\\", \\"text\\": \\"\\"}, \\"link_label\\": \\"\\", \\"page\\": null, \\"link_url\\": \\"\\"}, \\"id\\": \\"67c34257-588f-4b11-8055-bb10287eb3c8\\"}]", "live": true, "path": "00010002000800020004", "slug": "fabrique-django-wagtail", "depth": 5, "owner": 1, "title": "Wagtail-Village à partir de Gouv.FR", "locale": 1, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home/activités/numerique/fabrique-django-wagtail/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Web Fastoche à partir de Gouv.FR", "content_type": 25, "header_image": null, "header_large": false, "header_darken": false, "live_revision": 216, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": 216, "translation_key": "874ac02a-813a-4a55-b58f-2a37d88a5094", "contentpage_tags