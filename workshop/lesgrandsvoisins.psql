161	Informatruck	{"pk": 156, "path": "00010002000B0005000I", "depth": 5, "numchild": 0, "translation_key": "ccaa047b-ea9d-4d0c-98f8-1339dec12611", "locale": 1, "latest_revision": 512, "live": true, "has_unpublished_changes": false, "first_published_at": "2024-06-18T13:58:41.407Z", "last_published_at": "2024-06-18T13:58:41.407Z", "live_revision": 512, "go_live_at": null, "expire_at": null, "expired": false, "locked": false, "locked_at": null, "locked_by": null, "title": "Informatruck", "draft_title": "Informatruck", "slug": "informatruck", "content_type": 71, "url_path": "/home/le-village-des-grands-voisins/annuaire/informatruck/", "owner": 2, "seo_title": "", "show_in_menus": true, "search_description": "Informa\\u2019Truck est le premier r\\u00e9seau de camions-ateliers dont les techniciens r\\u00e9parent l\\u2019ensemble de vos appareils informatiques et \\u00e9lectroniques. Nous sommes une entreprise \\u00e0 vocation sociale et solidaire. Nous utilisons l\\u2019inclusion handicap pour r\\u00e9duire la fracture num\\u00e9rique 100 % de nos TechTruckers sont porteurs de handicaps.", "latest_revision_created_at": "2024-06-18T13:58:41.386Z", "alias_of": null, "body": "[{\\"id\\": \\"8f14d916-ab57-4f34-b940-dd7501d8e948\\", \\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"wicc9\\\\\\"><b>Informa\\\\u2019Truck est le premier r\\\\u00e9seau de camions-ateliers dont les techniciens r\\\\u00e9parent l\\\\u2019ensemble de vos appareils informatiques et \\\\u00e9lectroniques.</b> Nous sommes une entreprise \\\\u00e0 vocation sociale et solidaire. Nous utilisons l\\\\u2019inclusion handicap pour r\\\\u00e9duire la fracture num\\\\u00e9rique 100 % de nos TechTruckers sont porteurs de handicaps.</p>\\"}]", "header_with_title": true, "header_image": 116, "header_color_class": null, "header_large": false, "header_darken": true, "header_cta_text": null, "header_cta_label": null, "header_cta_link": null, "date": "2024-06-18T13:57:00Z", "wagtail_admin_comments"