326	2024-06-01 17:09:31.457677+02	{"pk": 132, "body": "[{\\"type\\": \\"callout\\", \\"value\\": {\\"title\\": \\"\\", \\"text\\": \\"Venez co-constuire un voisinage anim\\\\u00e9, chic, vivant, partageant, \\\\u00e9quip\\\\u00e9, ressour\\\\u00e7ant, respectueux, mondial, multiculturel, prosp\\\\u00e8re, et de proximit\\\\u00e9.\\", \\"heading_tag\\": \\"h3\\"}, \\"id\\": \\"e7b35c91-a541-448a-bdca-fae320153771\\"}, {\\"type\\": \\"paragraph\\", \\"value\\": \\"<p data-block-key=\\\\\\"tbuca\\\\\\">Nous sommes une association d'int\\\\u00e9r\\\\u00eat g\\\\u00e9n\\\\u00e9ral agissant de mani\\\\u00e8re contr\\\\u00f4l\\\\u00e9e en subsidiarit\\\\u00e9 ouverte pour toute organisation et tout individu qui en fait la d\\\\u00e9cision pour soi-m\\\\u00eame principalement en ces trois domaines de Civisme, d'Arts plastiques et de Num\\\\u00e9rique selon notre d\\\\u00e9claration de mission.</p>\\", \\"id\\": \\"b314e733-eaaf-4100-886f-56834b3ab1b5\\"}]", "live": false, "path": "000100030008", "slug": "association", "depth": 3, "owner": 1, "title": "Association", "locale": 2, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home-1/association/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Association", "content_type": 25, "header_image": null, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": false, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "f0d098f3-a7b7-49e7-b028-684bfd40f0e4", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "title text Venez co-constuire un voisinage animé, chic, vivant, partageant, équipé, ressourçant, respectueux, mondial, multiculturel, prospère, et de proximité. heading_tag […]", "wagtail_admin_comments": [], "has_unpublished_chang