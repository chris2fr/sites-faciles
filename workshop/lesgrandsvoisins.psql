993	2024-06-29 16:01:13.720519+02	{"pk": 246, "body": "[{\\"type\\": \\"paragraph\\", \\"value\\": \\"<h3 data-block-key=\\\\\\"pgy74\\\\\\">Wagtail-Village pour la gestion de contenu de sites webs</h3><p data-block-key=\\\\\\"a7e0h\\\\\\">site-exemple : <a href=\\\\\\"https://wagtail.village.ngo\\\\\\">wagtail.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/wagtail-village\\\\\\">github.com/chris2fr/wagtail-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/sites-faciles\\\\\\">github.com/nurmerique-gouv/sites-faciles</a></p><h3 data-block-key=\\\\\\"bjgac\\\\\\">Django-Village pour vos applications webs</h3><p data-block-key=\\\\\\"etqij\\\\\\">site-exemple : <a href=\\\\\\"https://django.village.ngo\\\\\\">django.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/django-village\\\\\\">github.com/chris2fr/django-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/django-dsfr\\\\\\">github.com/nurmerique-gouv/django-dsfr</a></p><h3 data-block-key=\\\\\\"bg4ad\\\\\\">Fabrique-Village pour vos syst\\\\u00e8mes de design num\\\\u00e9riques</h3><p data-block-key=\\\\\\"e3q5v\\\\\\">site-exemple : <a href=\\\\\\"https://django.village.ngo\\\\\\">django.village.ngo</a><br/>d\\\\u00e9p\\\\u00f4t source : <a href=\\\\\\"https://github.com/chris2fr/django-village\\\\\\">github.com/chris2fr/django-village</a><br/>bifurqu\\\\u00e9 depuis <a href=\\\\\\"https://github.com/nurmerique-gouv/django-dsfr\\\\\\">github.com/nurmerique-gouv/django-dsfr</a></p>\\", \\"id\\": \\"e0f3dff8-0eef-483e-82cc-5d7ad4cf0f6b\\"}]", "date": "2024-06-29T13:58:00Z", "live": false, "path": "000100040007000C0001", "slug": "wagtail-village-sites-faciles-de-numeriquegouvfr", "depth": 5, "owner": 1, "title": "Wagtail Village (Sites-Faciles de numerique.gouv.fr)", "locale": 1, "locked": false, "authors": [], "expired": false, "alias_of": null