320	2024-06-01 16:55:53.74457+02	{"pk": 129, "body": "[{\\"type\\": \\"alert\\", \\"value\\": {\\"title\\": \\"D\\\\u00e9claration d\\\\u2019accessibilit\\\\u00e9\\", \\"description\\": \\"Entrez ici la d\\\\u00e9claration d\\\\u2019accessibilit\\\\u00e9.<br />\\\\n                    <a href=\\\\\\"https://betagouv.github.io/a11y-generateur-declaration/#create\\\\\\">\\\\n                    G\\\\u00e9n\\\\u00e9rateur de d\\\\u00e9claration d\\\\u2019accessibilit\\\\u00e9</a>\\", \\"level\\": \\"info\\", \\"heading_tag\\": \\"h2\\"}, \\"id\\": \\"b007227b-f66a-4855-b781-d72d8a9e493f\\"}]", "live": false, "path": "000100030007", "slug": "accessibilite", "depth": 3, "owner": null, "title": "Déclaration d’accessibilité", "locale": 2, "locked": false, "expired": false, "alias_of": null, "numchild": 0, "url_path": "/home-1/accessibilite/", "expire_at": null, "locked_at": null, "locked_by": null, "seo_title": "", "go_live_at": null, "draft_title": "Déclaration d’accessibilité", "content_type": 25, "header_image": null, "header_large": false, "header_darken": false, "live_revision": null, "show_in_menus": true, "header_cta_link": null, "header_cta_text": null, "latest_revision": null, "translation_key": "4366cc36-0e58-4e14-b05f-4f03a0ff4338", "contentpage_tags": [], "header_cta_label": null, "header_with_title": false, "last_published_at": null, "first_published_at": null, "header_color_class": null, "search_description": "", "wagtail_admin_comments": [], "has_unpublished_changes": true, "latest_revision_created_at": null}	\N	129	\N	25	1	Déclaration d’accessibilité
